// ======================================================================
// Crypto.js
// ======================================================================
/** Hashing, constant-time compare, password hash and session token. */

function bytesToHex_(bytes) {
  var s = '';
  for (var i = 0; i < bytes.length; i++) {
    var h = (bytes[i] & 0xff).toString(16);
    s += h.length === 1 ? '0' + h : h;
  }
  return s;
}

function sha256Hex_(text) {
  return bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8));
}

function hmacSha256Hex_(message, key) {
  return bytesToHex_(Utilities.computeHmacSignature(Utilities.MacAlgorithm.HMAC_SHA_256, message, key));
}

function base64url_(text) {
  return Utilities.base64EncodeWebSafe(text, Utilities.Charset.UTF_8).replace(/=+$/, '');
}

function base64urlDecode_(b64) {
  var s = String(b64);
  while (s.length % 4) s += '=';
  return Utilities.newBlob(Utilities.base64DecodeWebSafe(s)).getDataAsString();
}

/** Compare two strings without stopping at the first difference. */
function constantTimeEquals_(a, b) {
  a = String(a); b = String(b);
  var diff = a.length ^ b.length;
  var n = Math.max(a.length, b.length);
  for (var i = 0; i < n; i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return diff === 0;
}

// ---------- passwords ----------

function getHashRounds_() {
  var n = Number(getProp_(PROP.ROUNDS));
  if (n >= 1 && n <= HASH_ROUNDS_MAX) return Math.trunc(n);
  return HASH_ROUNDS_DEFAULT;
}

/** Iterated HMAC-SHA256 keyed with the server pepper; salt is per user. */
function hashPassword_(password, salt, rounds) {
  var pepper = getSecret_(PROP.PEPPER);
  var h = hmacSha256Hex_(salt + ':' + password, pepper);
  for (var i = 1; i < rounds; i++) h = hmacSha256Hex_(h + salt, pepper);
  return h;
}

function newSalt_() { return Utilities.getUuid(); }

function verifyPassword_(user, password) {
  return constantTimeEquals_(hashPassword_(password, user.password_salt, user.hash_rounds), user.password_hash);
}

/** New credentials fields for a password: fresh salt, current rounds. */
function newCredentials_(password) {
  var salt = newSalt_();
  var rounds = getHashRounds_();
  return { password_salt: salt, hash_rounds: rounds, password_hash: hashPassword_(password, salt, rounds) };
}

// ---------- session token ----------

function signToken_(payload) {
  var body = base64url_(JSON.stringify(payload));
  return body + '.' + hmacSha256Hex_(body, getSecret_(PROP.SECRET));
}

/** Returns the payload of a genuine, unexpired token, otherwise null. */
function verifyToken_(token) {
  if (typeof token !== 'string' || token.length > 2000) return null;
  var parts = token.split('.');
  if (parts.length !== 2 || !parts[0] || !parts[1]) return null;
  if (!constantTimeEquals_(hmacSha256Hex_(parts[0], getSecret_(PROP.SECRET)), parts[1])) return null;
  var payload;
  try { payload = JSON.parse(base64urlDecode_(parts[0])); } catch (e) { return null; }
  if (!payload || typeof payload.uid !== 'string' || typeof payload.exp !== 'number') return null;
  if (payload.exp <= nowMs_()) return null;
  return payload;
}

// ---------- temporary passwords ----------

var TEMP_ALPHABET_LOWER = 'abcdefghjkmnpqrstuvwxyz';
var TEMP_ALPHABET_UPPER = 'ABCDEFGHJKMNPQRSTUVWXYZ';
var TEMP_ALPHABET_DIGIT = '23456789';

/** Random temporary password (no look-alike characters), unbiased, from UUID randomness. */
function generateTempPassword_() {
  var alphabet = TEMP_ALPHABET_LOWER + TEMP_ALPHABET_UPPER + TEMP_ALPHABET_DIGIT;
  var limit = 256 - (256 % alphabet.length);
  for (;;) {
    var out = '';
    var hex = '';
    while (out.length < TEMP_PASSWORD_LENGTH) {
      if (hex.length < 2) hex = randomHex_(64);
      var b = parseInt(hex.slice(0, 2), 16);
      hex = hex.slice(2);
      if (b < limit) out += alphabet.charAt(b % alphabet.length);
    }
    if (/[a-z]/.test(out) && /[A-Z]/.test(out) && /[0-9]/.test(out)) return out;
  }
}

// ======================================================================
// Events.js
// ======================================================================
/** Events: validation and derived fields (shared with Upload), reads, edit and void. */

/** Lookup tables used to validate and resolve events. Built once per request. */
function eventContext_() {
  var ctx = { areas: {}, areasLower: {}, lines: {}, equipment: {}, equipmentAreas: {}, aliases: {}, reasons: {}, classes: {} };
  readTable_(T.AREAS).forEach(function (a) { ctx.areas[a.area_id] = a; ctx.areasLower[a.area_id.toLowerCase()] = a; });
  readTable_(T.LINES).forEach(function (l) { ctx.lines[l.line_id] = l; });
  readColumn_(T.EQUIPMENT, 'equipment_id').forEach(function (id) { ctx.equipment[id] = true; });
  readTable_(T.EQUIPMENT_AREAS).forEach(function (l) {
    (ctx.equipmentAreas[l.equipment_id] = ctx.equipmentAreas[l.equipment_id] || {})[l.area_id] = true;
  });
  readTable_(T.ALIASES).forEach(function (a) { ctx.aliases[a.alias] = a.equipment_id; });
  readTable_(T.CLASSIFICATIONS).forEach(function (c) { ctx.classes[c.code] = c; });
  readTable_(T.REASONS).slice().sort(function (a, b) { return (a.order_no || 0) - (b.order_no || 0); }).forEach(function (r) {
    var k = r.classification + '|' + r.match_key;
    if (!ctx.reasons[k]) ctx.reasons[k] = r.reason_id;
  });
  return ctx;
}

function optionalText_(v, label) {
  if (v === null || v === undefined) return '';
  if (typeof v !== 'string') return { error: label + ' must be text.' };
  if (v.length > TEXT_MAX) return { error: label + ' is too long.' };
  return v.trim();
}

function findArea_(ctx, id) {
  if (typeof id !== 'string') return null;
  var t = id.trim();
  return ctx.areas[t] || ctx.areasLower[t.toLowerCase()] || null;
}

/**
 * Data checks (docs/wire-protocol.md section 4a). The blocking flags come first: a record that carries
 * one is kept out of every calculation until it is fixed. Order is fixed so client and server agree.
 * `r` holds: area (the master row or null), line_id, classification (upper case), reason_raw, code_key,
 * equipment_id, is_area_level, duration_s.
 */
function computeFlags_(ctx, r) {
  var flags = [];
  var cls = r.classification;
  if (!cls) flags.push('missing_classification');
  else if (!ctx.classes[cls]) flags.push('invalid_classification');
  if (!r.area) flags.push('unknown_area');
  if (r.duration_s < 0) flags.push('end_before_start');
  if (!r.code_key) flags.push('missing_code');
  else if (!r.is_area_level && !r.equipment_id) flags.push('unknown_code');
  if (PLACEHOLDER_CODES.indexOf(r.code_key) >= 0) flags.push('placeholder');
  if (!r.reason_raw) flags.push('blank_reason');
  else if (ctx.classes[cls] && !ctx.reasons[cls + '|' + matchKey_(r.reason_raw)]) flags.push('unlisted_reason');
  if (r.area && r.equipment_id) {
    var inAreas = ctx.equipmentAreas[r.equipment_id];
    if (inAreas && Object.keys(inAreas).length && !inAreas[r.area.area_id]) flags.push('code_not_in_area');
  }
  if (r.area && r.line_id !== r.area.line_id) flags.push('line_mismatch');
  return flags;
}

/**
 * Validates what must be readable to store a row at all (dates, times, freq, criticality, failure)
 * and works out the derived fields and flags. Everything else (area, line, code, classification,
 * reason) is stored as given and flagged: import never drops a row.
 * Returns { error: 'plain English' } or { rec: {...} }.
 */
function normalizeEvent_(ctx, f) {
  if (!f || typeof f !== 'object') return { error: 'Row is not readable.' };
  if (!isValidDate_(f.event_date)) return { error: 'Unreadable date.' };
  var stop = normTs_(f.stop_ts), start = normTs_(f.start_ts);
  if (!stop) return { error: 'Unreadable stop time.' };
  if (!start) return { error: 'Unreadable start time.' };
  var freq = (f.freq === 0 || f.freq === 1) ? f.freq : (f.freq === '0' ? 0 : (f.freq === '1' ? 1 : null));
  if (freq === null) return { error: 'Freq must be 0 or 1.' };
  if (f.criticality !== 'INC' && f.criticality !== 'NO_INC') return { error: 'Criticality must be INC or NO_INC.' };
  if (typeof f.is_failure !== 'boolean') return { error: 'Failure must be true or false.' };
  var codeRaw = f.code_raw === null || f.code_raw === undefined ? '' : f.code_raw;
  if (typeof codeRaw !== 'string' || codeRaw.length > 200) return { error: 'Equipment code is not readable.' };
  var texts = {};
  var bad = null;
  [['area_id', 'Area', 40], ['line_id', 'Line', 20], ['classification', 'Classification', 20]].forEach(function (c) {
    var v = f[c[0]] === null || f[c[0]] === undefined ? '' : f[c[0]];
    if (typeof v !== 'string' || v.length > c[2]) bad = bad || { error: c[1] + ' is not readable.' };
    texts[c[0]] = typeof v === 'string' ? v.trim() : '';
  });
  if (bad) return bad;
  var reasonRaw = optionalText_(f.reason_raw, 'Reason');
  var description = optionalText_(f.description, 'Description');
  if (typeof reasonRaw === 'object') return reasonRaw;
  if (typeof description === 'object') return description;

  var area = findArea_(ctx, texts.area_id);
  var cls = texts.classification.toUpperCase();
  var key = codeKey_(codeRaw);
  var areaLevel = AREA_LEVEL_KEYS.indexOf(key) >= 0;
  var resolved = Object.prototype.hasOwnProperty.call(ctx.aliases, key) ? ctx.aliases[key] : key;
  var equipmentId = key && !areaLevel && ctx.equipment[resolved] ? resolved : '';
  var reasonId = reasonRaw && ctx.classes[cls] ? (ctx.reasons[cls + '|' + matchKey_(reasonRaw)] || '') : '';
  var duration = (parseTs_(start) - parseTs_(stop)) / 1000;
  var rec = {
    event_date: f.event_date, line_id: texts.line_id, area_id: area ? area.area_id : texts.area_id, code_raw: codeRaw.trim(),
    stop_ts: stop, start_ts: start, freq: freq, classification: cls, criticality: f.criticality,
    is_failure: f.is_failure, reason_raw: reasonRaw, description: description,
    equipment_id: equipmentId, is_area_level: areaLevel, duration_s: duration, reason_id: reasonId, code_key: key
  };
  rec.flags = computeFlags_(ctx, {
    area: area, line_id: rec.line_id, classification: cls, reason_raw: reasonRaw, code_key: key,
    equipment_id: equipmentId, is_area_level: areaLevel, duration_s: duration
  }).join(',');
  return { rec: rec };
}

// ---------- reads ----------

function getEvents_(year) {
  var y = Number(year);
  if (!isFinite(y) || Math.floor(y) !== y || y < 1990 || y > 2200) throw apiError_(ERR.BAD_REQUEST, 'Year is not valid.');
  var prefix = y + '-';
  return readTable_(T.EVENTS, function (row, idx) {
    var d = row[idx.event_date];
    return typeof d === 'string' ? d.indexOf(prefix) === 0 : isDate_(d) && d.getUTCFullYear() === y;
  });
}

function getEventEdits_(eventId) {
  var id = cleanText_(eventId, 'Event', true, 60);
  return readTable_(T.EDITS, function (row, idx) { return row[idx.event_id] === id; })
    .sort(function (a, b) { return a.edited_at < b.edited_at ? -1 : (a.edited_at > b.edited_at ? 1 : 0); });
}

// ---------- edit and void ----------

function editText_(v) {
  if (v === true) return 'TRUE';
  if (v === false) return 'FALSE';
  return v === null || v === undefined ? '' : String(v);
}

/**
 * 1.10.0: the sheet row of each event id, from the event_id column alone (one narrow read instead of the whole events
 * sheet). Read inside the lock, so the rows cannot move before they are written.
 */
function eventRowIndex_() {
  var ids = readColumn_(T.EVENTS, 'event_id');
  var at = {};
  for (var i = 0; i < ids.length; i++) if (ids[i] && !(ids[i] in at)) at[ids[i]] = i + 2;
  return at;
}

function eventOrThrow_(eventId, index) {
  var id = typeof eventId === 'string' ? eventId.trim() : '';
  var rowNum = id ? (index || eventRowIndex_())[id] : undefined;
  var ev = rowNum ? readRowAt_(T.EVENTS, rowNum) : null;
  if (!ev || ev.event_id !== id) throw apiError_(ERR.NOT_FOUND, 'Event not found.');
  return ev;
}

// ---------- accepted flags ("Keep as entered") ----------

function flagRank_(f) {
  var i = KNOWN_FLAG_NAMES.indexOf(f);
  return i < 0 ? KNOWN_FLAG_NAMES.length : i;
}

/** A comma separated list (or an array) as a list of known flag names without repeats, in catalogue order. */
function canonFlags_(v) {
  var list = Array.isArray(v) ? v : String(v === null || v === undefined ? '' : v).split(',');
  var out = [];
  list.forEach(function (f) {
    f = String(f).trim();
    if (f && out.indexOf(f) < 0) out.push(f);
  });
  return out.sort(function (a, b) { return flagRank_(a) - flagRank_(b) || (a < b ? -1 : a > b ? 1 : 0); });
}

/** The accepted flags that still apply: a flag stays when the record still carries it. The derived overlap stays until undone. */
function pruneAccepted_(accepted, storedFlags) {
  var have = canonFlags_(storedFlags);
  return canonFlags_(accepted).filter(function (f) { return DERIVED_FLAG_NAMES.indexOf(f) >= 0 || have.indexOf(f) >= 0; });
}

var PRUNE_NOTE_ = 'Removed automatically: the record no longer has this problem.';

function editRows_(session, ev, pairs, note) {
  var at = nowTs_();
  var stamp = compactTs_('yyyyMMddHHmmssSSS');
  return pairs.map(function (p, i) {
    return {
      edit_id: 'ED-' + stamp + '-' + (i + 1), event_id: ev.event_id, edited_at: at, edited_by: session.user.user_id,
      field: p.field, old_value: editText_(p.oldValue), new_value: editText_(p.newValue), note: p.note || note
    };
  });
}

function editEvent_(session, eventId, changes, note) {
  var why = cleanText_(note, 'A note explaining the change', true, 500);
  requireObject_(changes, 'Changes');
  var fields = Object.keys(changes);
  if (!fields.length) throw apiError_(ERR.BAD_REQUEST, 'No changes to save.');
  fields.forEach(function (f) {
    if (EDITABLE_EVENT_FIELDS.indexOf(f) < 0) throw apiError_(ERR.BAD_REQUEST, 'The field "' + f + '" cannot be edited.');
  });
  return withLock_(function () {
    var ev = eventOrThrow_(eventId);
    if (ev.is_void) throw apiError_(ERR.CONFLICT, 'This event is void. Restore it before editing.');
    var cand = {};
    EDITABLE_EVENT_FIELDS.forEach(function (f) { cand[f] = ev[f]; });
    fields.forEach(function (f) { cand[f] = changes[f]; });
    var ctx = eventContext_();
    if ('classification' in changes) {
      var c = typeof changes.classification === 'string' ? changes.classification.trim().toUpperCase() : '';
      if (!ctx.classes[c]) throw apiError_(ERR.BAD_REQUEST, 'Classification must be one of ' + Object.keys(ctx.classes).join(', ') + '.');
      cand.classification = c;
    }
    if ('area_id' in changes) {
      var a = findArea_(ctx, changes.area_id);
      if (!a) throw apiError_(ERR.BAD_REQUEST, 'Area "' + String(changes.area_id).slice(0, 40) + '" is not in the list of areas.');
      cand.area_id = a.area_id;
      if (!('line_id' in changes)) cand.line_id = a.line_id;
    }
    if ('line_id' in changes) {
      var ln = typeof changes.line_id === 'string' ? changes.line_id.trim() : '';
      if (!ctx.lines[ln]) throw apiError_(ERR.BAD_REQUEST, 'Line "' + String(changes.line_id).slice(0, 20) + '" is not in the list of lines.');
      cand.line_id = ln;
    }
    var norm = normalizeEvent_(ctx, cand);
    if (norm.error) throw apiError_(ERR.BAD_REQUEST, norm.error);
    var rec = norm.rec;
    // Criticality follows a changed classification, unless the old one was blank or unknown (then the sheet's value stays).
    if ('classification' in changes && !('criticality' in changes) && ctx.classes[ev.classification] && rec.classification !== ev.classification) {
      rec.criticality = ctx.classes[rec.classification].is_incident ? 'INC' : 'NO_INC';
    }
    if (!('is_failure' in changes) && (rec.criticality !== ev.criticality || rec.freq !== ev.freq)) {
      rec.is_failure = rec.criticality === 'INC' && rec.freq === 1;
    }
    var pairs = [];
    EDITABLE_EVENT_FIELDS.forEach(function (f) {
      if (editText_(rec[f]) !== editText_(ev[f])) pairs.push({ field: f, oldValue: ev[f], newValue: rec[f] });
    });
    if (!pairs.length) throw apiError_(ERR.BAD_REQUEST, 'Nothing was changed.');
    // Accepted flags that no longer apply to the changed record are dropped (and the history says so).
    var accOld = canonFlags_(ev.accepted_flags);
    var accNew = pruneAccepted_(accOld, rec.flags);
    var pruned = accNew.length !== accOld.length;
    if (pruned) pairs.push({ field: 'accepted_flags', oldValue: accOld.join(','), newValue: accNew.join(','), note: PRUNE_NOTE_ });
    var patch = {
      event_date: rec.event_date, line_id: rec.line_id, area_id: rec.area_id, code_raw: rec.code_raw,
      stop_ts: rec.stop_ts, start_ts: rec.start_ts, freq: rec.freq, classification: rec.classification,
      criticality: rec.criticality, is_failure: rec.is_failure, reason_raw: rec.reason_raw, description: rec.description,
      equipment_id: rec.equipment_id, is_area_level: rec.is_area_level, duration_s: rec.duration_s,
      reason_id: rec.reason_id, flags: rec.flags, edited: true
    };
    if (pruned) {
      patch.accepted_flags = accNew.join(',');
      if (!accNew.length) { patch.accepted_by = ''; patch.accepted_at = ''; }
    }
    updateRow_(T.EVENTS, ev._row, patch);
    appendRows_(T.EDITS, editRows_(session, ev, pairs, why));
    auditLog_(session.user.user_id, 'edit_event', T.EVENTS, ev.event_id,
      pairs.map(function (p) { return p.field + ': ' + auditValue_(p.oldValue, 40) + ' -> ' + auditValue_(p.newValue, 40); }).join('; ') + '. Note: ' + why);
    return readRowAt_(T.EVENTS, ev._row);
  });
}

function voidEvent_(session, eventId, isVoid, note) {
  var why = cleanText_(note, 'A note explaining the change', true, 500);
  if (typeof isVoid !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'isVoid must be true or false.');
  return withLock_(function () {
    var ev = eventOrThrow_(eventId);
    if (ev.is_void === isVoid) return ev;
    updateRow_(T.EVENTS, ev._row, { is_void: isVoid });
    appendRows_(T.EDITS, editRows_(session, ev, [{ field: 'is_void', oldValue: ev.is_void, newValue: isVoid }], why));
    auditLog_(session.user.user_id, isVoid ? 'void_event' : 'unvoid_event', T.EVENTS, ev.event_id, 'Note: ' + why);
    return readRowAt_(T.EVENTS, ev._row);
  });
}

/**
 * "Keep as entered": the person has checked the record and says its flagged problems are fine. `flags` is the FULL new
 * accepted set (fewer = undo, empty = undo all). Nothing else about the record changes and no flag is recalculated.
 * One history row (field accepted_flags) says who, when and why.
 */
function acceptNote_(note) {
  var why = cleanText_(note, 'A note explaining why', true, 500);
  if (why.length < ACCEPT_NOTE_MIN) throw apiError_(ERR.BAD_REQUEST, 'The note must be at least ' + ACCEPT_NOTE_MIN + ' characters.');
  return why;
}

function acceptFlagList_(flags) {
  if (!Array.isArray(flags)) throw apiError_(ERR.BAD_REQUEST, 'Flags must be a list.');
  if (flags.length > KNOWN_FLAG_NAMES.length * 2) throw apiError_(ERR.BAD_REQUEST, 'Too many flags.');
  flags.forEach(function (f) {
    if (typeof f !== 'string' || KNOWN_FLAG_NAMES.indexOf(f) < 0) {
      throw apiError_(ERR.BAD_REQUEST, 'Unknown flag: ' + String(f).slice(0, 40) + '.');
    }
  });
  return canonFlags_(flags);
}

/** The change "keep as entered" makes to one event: { patch, current } or throws a plain-English error. */
function acceptPatch_(session, ev, wanted, at) {
  if (ev.is_void) throw apiError_(ERR.CONFLICT, 'This event is void. Restore it before changing it.');
  var current = canonFlags_(ev.accepted_flags);
  var stored = canonFlags_(ev.flags);
  wanted.forEach(function (f) {
    if (current.indexOf(f) < 0 && stored.indexOf(f) < 0 && DERIVED_FLAG_NAMES.indexOf(f) < 0) {
      throw apiError_(ERR.BAD_REQUEST, 'This record does not have the problem "' + f + '".');
    }
  });
  if (wanted.join(',') === current.join(',')) throw apiError_(ERR.BAD_REQUEST, 'Nothing was changed.');
  var patch = wanted.length
    ? { accepted_flags: wanted.join(','), accepted_by: session.user.user_id, accepted_at: at }
    : { accepted_flags: '', accepted_by: '', accepted_at: '' };
  return { patch: patch, current: current };
}

function acceptAuditText_(wanted, current, why) {
  return (wanted.length ? 'Kept as entered: ' + wanted.join(', ') : 'Undid keep as entered (was: ' + current.join(', ') + ')') + '. Note: ' + why;
}

/**
 * "Keep as entered": the person has checked the record and says its flagged problems are fine. `flags` is the FULL new
 * accepted set (fewer = undo, empty = undo all). Nothing else about the record changes and no flag is recalculated.
 * One history row (field accepted_flags) says who, when and why.
 */
function acceptEventFlags_(session, eventId, flags, note) {
  var why = acceptNote_(note);
  var wanted = acceptFlagList_(flags);
  return withLock_(function () {
    var ev = eventOrThrow_(eventId);
    var p = acceptPatch_(session, ev, wanted, nowTs_());
    updateRow_(T.EVENTS, ev._row, p.patch);
    appendRows_(T.EDITS, editRows_(session, ev, [{ field: 'accepted_flags', oldValue: p.current.join(','), newValue: wanted.join(',') }], why));
    auditLog_(session.user.user_id, 'accept_event_flags', T.EVENTS, ev.event_id, acceptAuditText_(wanted, p.current, why));
    return readRowAt_(T.EVENTS, ev._row);
  });
}

var ACCEPT_BULK_MAX_ = 200;
var ACCEPT_COLS_ = ['accepted_flags', 'accepted_by', 'accepted_at'];

/**
 * 1.10.0 acceptEventFlagsBulk: "keep as entered" (or its undo) for up to 200 records with one note, in one lock: one read
 * of the event_id column, one read per record, the changed rows written together and the history appended at once.
 * `items`: [{ eventId, flags }] (flags = the record's FULL new accepted set). A record that cannot be changed is reported
 * in `failed` with the reason; the others are saved. Returns { saved: [event rows], failed: [{ event_id, message }] }.
 */
function acceptEventFlagsBulk_(session, items, note) {
  var why = acceptNote_(note);
  if (!Array.isArray(items) || !items.length) throw apiError_(ERR.BAD_REQUEST, 'Send at least one record.');
  if (items.length > ACCEPT_BULK_MAX_) throw apiError_(ERR.BAD_REQUEST, 'At most ' + ACCEPT_BULK_MAX_ + ' records at once.');
  var clean = items.map(function (it) {
    if (!plainObject_(it)) throw apiError_(ERR.BAD_REQUEST, 'Each record must be an object.');
    return { id: typeof it.eventId === 'string' ? it.eventId.trim() : '', wanted: acceptFlagList_(it.flags) };
  });
  return withLock_(function () {
    var index = eventRowIndex_();
    var sheet = getSheet_(T.EVENTS);
    var headers = sheetHeaders_(sheet);
    var types = columnTypes_(T.EVENTS);
    var at = nowTs_();
    var stamp = compactTs_('yyyyMMddHHmmssSSS');
    var writes = [], history = [], audits = [], saved = [], failed = [], seen = {};
    clean.forEach(function (c) {
      try {
        if (seen[c.id]) throw apiError_(ERR.BAD_REQUEST, 'This record is listed twice.');
        seen[c.id] = true;
        var rowNum = index[c.id];
        if (!rowNum) throw apiError_(ERR.NOT_FOUND, 'Event not found.');
        var raw = sheet.getRange(rowNum, 1, 1, headers.length).getValues()[0];
        var ev = rowToObject_(types, headers, raw, rowNum);
        var p = acceptPatch_(session, ev, c.wanted, at);
        var values = objectToRow_(T.EVENTS, headers, p.patch, raw);
        writes.push({ rowNum: rowNum, values: values, cells: ACCEPT_COLS_.map(function (h) { return values[headers.indexOf(h)]; }) });
        history.push({
          edit_id: 'ED-' + stamp + '-B' + (history.length + 1), event_id: ev.event_id, edited_at: at, edited_by: session.user.user_id,
          field: 'accepted_flags', old_value: p.current.join(','), new_value: c.wanted.join(','), note: why
        });
        audits.push(auditEntry_(session.user.user_id, 'accept_event_flags', T.EVENTS, ev.event_id, acceptAuditText_(c.wanted, p.current, why)));
        saved.push(rowToObject_(types, headers, values.map(function (v) { return typeof v === 'string' && v.charAt(0) === "'" ? v.slice(1) : v; }), rowNum));
      } catch (e) {
        failed.push({ event_id: c.id, message: e && e.message ? e.message : String(e) });
      }
    });
    writes.sort(function (a, b) { return a.rowNum - b.rowNum; });
    // only the three accepted_* columns change: written as a narrow block when they sit side by side (they do in a
    // database made by ensureSchema), else as whole rows
    var first = headers.indexOf(ACCEPT_COLS_[0]);
    var together = first >= 0 && ACCEPT_COLS_.every(function (h, k) { return headers[first + k] === h; });
    if (together) writeCellRuns_(sheet, first + 1, ACCEPT_COLS_.length, writes.map(function (w) { return { rowNum: w.rowNum, values: w.cells }; }));
    else writeRowRuns_(sheet, headers.length, writes);
    appendRows_(T.EDITS, history);
    auditLogMany_(audits);
    return { saved: saved, failed: failed };
  });
}

// ---------- revalidate ----------

/**
 * Re-runs the data checks of every non-void event (one year, or all) against the current Master Data.
 * Rows whose flags or derived fields (resolved equipment, reason, area-level, duration) changed are
 * written back in batches; nothing else is touched. Returns { checked, changed }.
 */
function revalidateEvents_(session, year) {
  var y = null;
  if (year !== undefined && year !== null) {
    y = Number(year);
    if (!isFinite(y) || Math.floor(y) !== y || y < 1990 || y > 2200) throw apiError_(ERR.BAD_REQUEST, 'Year is not valid.');
  }
  return withLock_(function () {
    var ctx = eventContext_();
    var sheet = getSheet_(T.EVENTS);
    var headers = sheetHeaders_(sheet);
    var last = sheet.getLastRow();
    var checked = 0, changedRows = [], history = [];
    var stamp = compactTs_('yyyyMMddHHmmssSSS'), at = nowTs_();
    if (last >= 2) {
      var values = sheet.getRange(2, 1, last - 1, headers.length).getValues();
      var types = columnTypes_(T.EVENTS);
      for (var i = 0; i < values.length; i++) {
        var ev = rowToObject_(types, headers, values[i], i + 2);
        if (ev.is_void) continue;
        if (y !== null && String(ev.event_date).slice(0, 4) !== String(y)) continue;
        checked++;
        var norm = normalizeEvent_(ctx, ev);
        if (norm.error) continue;
        var rec = norm.rec;
        var accOld = canonFlags_(ev.accepted_flags);
        var accNew = pruneAccepted_(accOld, rec.flags);
        var pruned = accNew.length !== accOld.length;
        if (!pruned && rec.flags === (ev.flags || '') && rec.equipment_id === (ev.equipment_id || '') && rec.reason_id === (ev.reason_id || '') &&
            rec.is_area_level === ev.is_area_level && rec.duration_s === ev.duration_s) continue;
        var patch = {
          flags: rec.flags, equipment_id: rec.equipment_id, reason_id: rec.reason_id,
          is_area_level: rec.is_area_level, duration_s: rec.duration_s
        };
        if (pruned) {
          patch.accepted_flags = accNew.join(',');
          if (!accNew.length) { patch.accepted_by = ''; patch.accepted_at = ''; }
          history.push({
            edit_id: 'ED-' + stamp + '-R' + (history.length + 1), event_id: ev.event_id, edited_at: at, edited_by: session.user.user_id,
            field: 'accepted_flags', old_value: accOld.join(','), new_value: accNew.join(','), note: PRUNE_NOTE_
          });
        }
        changedRows.push({ rowNum: i + 2, values: objectToRow_(T.EVENTS, headers, patch, values[i]) });
      }
    }
    writeRowRuns_(sheet, headers.length, changedRows);
    appendRows_(T.EDITS, history);
    auditLog_(session.user.user_id, 'revalidate_events', T.EVENTS, y === null ? 'all' : String(y),
      'Checked ' + checked + ', changed ' + changedRows.length);
    return { checked: checked, changed: changedRows.length };
  });
}

/**
 * 1.10.0: writes the same few side-by-side columns (from `col`, `width` wide) of many rows (rowNum ascending): consecutive
 * rows go together; with many separate pieces the span of just these columns is read once and written once.
 */
function writeCellRuns_(sheet, col, width, rows) {
  if (!rows.length) return;
  var runs = [];
  rows.forEach(function (r) {
    var run = runs[runs.length - 1];
    if (run && r.rowNum === run.start + run.rows.length) run.rows.push(r.values);
    else runs.push({ start: r.rowNum, rows: [r.values] });
  });
  if (runs.length > 20) {
    var first = rows[0].rowNum, lastRow = rows[rows.length - 1].rowNum;
    var span = sheet.getRange(first, col, lastRow - first + 1, width).getValues().map(function (line) { return line.map(keepCell_); });
    rows.forEach(function (r) { span[r.rowNum - first] = r.values; });
    sheet.getRange(first, col, span.length, width).setValues(span);
    return;
  }
  runs.forEach(function (run) { sheet.getRange(run.start, col, run.rows.length, width).setValues(run.rows); });
}

/** Writes full rows (rowNum ascending) with as few setValues calls as sensible: consecutive rows go together. */
function writeRowRuns_(sheet, width, rows) {
  if (!rows.length) return;
  var runs = [];
  rows.forEach(function (r) {
    var run = runs[runs.length - 1];
    if (run && r.rowNum === run.start + run.rows.length) run.rows.push(r.values);
    else runs.push({ start: r.rowNum, rows: [r.values] });
  });
  if (runs.length > 20) {
    // Too many separate pieces: rewrite the span from the first to the last changed row once.
    var first = rows[0].rowNum, lastRow = rows[rows.length - 1].rowNum;
    var span = sheet.getRange(first, 1, lastRow - first + 1, width).getValues();
    span = span.map(function (line) { return line.map(keepCell_); });
    rows.forEach(function (r) { span[r.rowNum - first] = r.values; });
    sheet.getRange(first, 1, span.length, width).setValues(span);
    return;
  }
  runs.forEach(function (run) { sheet.getRange(run.start, 1, run.rows.length, width).setValues(run.rows); });
}

// ======================================================================
// Mail.js
// ======================================================================
/**
 * Outgoing mail (1.9.0): one helper for every email the app sends (digests, reports, the test email).
 *
 * - Settings `system_email` blank: MailApp, sent by the Google account that deploys the script (as before).
 * - Settings `system_email` set: the Gmail advanced service (Gmail API users.messages.send) with
 *   From: "system_email_name <system_email>". Gmail only keeps that From when the address is a verified
 *   'Send mail as' alias of the deploying account; the helper checks the alias list first and says so plainly.
 * - sendReport (Reports Edit, or an Admin): 1-25 To, up to 25 Cc, any domain, a sanitised HTML summary and up to
 *   3 attachments (PDF, Excel, CSV; 15 MB together). At most MAIL_LIMITS.perUserPerDay sends per person a day.
 */

var MAIL_LIMITS = {
  maxTo: 25,
  maxCc: 25,
  maxAttachments: 3,
  maxBytes: 15 * 1024 * 1024,
  maxHtml: 300000,
  maxText: 20000,
  maxSubject: 200,
  perUserPerDay: 30
};

var MAIL_TYPES_ = {
  'application/pdf': 'pdf',
  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'xlsx',
  'text/csv': 'csv'
};

var DEFAULT_SENDER_NAME = 'ACC Downtime Analysis';

function settingText_(key, fallback) {
  var rows = readSettings_();
  for (var i = 0; i < rows.length; i++) if (rows[i].key === key) return String(rows[i].value === null || rows[i].value === undefined ? '' : rows[i].value).trim();
  return fallback;
}

/** The sender the settings ask for: { email: '' | address, name }. */
function mailSender_() {
  var email = settingText_('system_email', '').toLowerCase();
  var name = settingText_('system_email_name', '') || DEFAULT_SENDER_NAME;
  return { email: email, name: name };
}

/** "Name" <a@b.c> with the name as an RFC 2047 word when it is not plain ASCII. */
function mimeAddress_(name, email) {
  var n = String(name || '').replace(/[\r\n"]/g, ' ').trim();
  if (!n) return '<' + email + '>';
  return (/^[\x20-\x7e]*$/.test(n) ? '"' + n + '"' : mimeWord_(n)) + ' <' + email + '>';
}

function mimeWord_(text) {
  var s = String(text || '').replace(/[\r\n]+/g, ' ');
  if (/^[\x20-\x7e]*$/.test(s)) return s;
  return '=?UTF-8?B?' + Utilities.base64Encode(s, Utilities.Charset.UTF_8) + '?=';
}

function wrap76_(b64) {
  var out = [];
  for (var i = 0; i < b64.length; i += 76) out.push(b64.slice(i, i + 76));
  return out.join('\r\n');
}

/**
 * The raw MIME text: multipart/mixed { multipart/alternative { text, html }, attachments... }.
 * msg: { from, to: [], cc: [], replyTo, subject, text, html, attachments: [{ name, mimeType, base64 }] }
 */
function buildMime_(msg) {
  var stamp = Utilities.getUuid().replace(/-/g, '');
  var mixed = 'mix_' + stamp;
  var alt = 'alt_' + stamp;
  var lines = [];
  lines.push('MIME-Version: 1.0');
  lines.push('From: ' + msg.from);
  lines.push('To: ' + msg.to.join(', '));
  if (msg.cc && msg.cc.length) lines.push('Cc: ' + msg.cc.join(', '));
  if (msg.replyTo) lines.push('Reply-To: ' + msg.replyTo);
  lines.push('Subject: ' + mimeWord_(msg.subject));
  lines.push('Content-Type: multipart/mixed; boundary="' + mixed + '"');
  lines.push('');
  lines.push('--' + mixed);
  lines.push('Content-Type: multipart/alternative; boundary="' + alt + '"');
  lines.push('');
  lines.push('--' + alt);
  lines.push('Content-Type: text/plain; charset="UTF-8"');
  lines.push('Content-Transfer-Encoding: base64');
  lines.push('');
  lines.push(wrap76_(Utilities.base64Encode(msg.text || '', Utilities.Charset.UTF_8)));
  if (msg.html) {
    lines.push('--' + alt);
    lines.push('Content-Type: text/html; charset="UTF-8"');
    lines.push('Content-Transfer-Encoding: base64');
    lines.push('');
    lines.push(wrap76_(Utilities.base64Encode(msg.html, Utilities.Charset.UTF_8)));
  }
  lines.push('--' + alt + '--');
  (msg.attachments || []).forEach(function (a) {
    var fname = String(a.name).replace(/["\r\n\\]/g, '_');
    lines.push('--' + mixed);
    lines.push('Content-Type: ' + a.mimeType + '; name="' + fname + '"');
    lines.push('Content-Disposition: attachment; filename="' + fname + '"');
    lines.push('Content-Transfer-Encoding: base64');
    lines.push('');
    lines.push(wrap76_(a.base64));
  });
  lines.push('--' + mixed + '--');
  return lines.join('\r\n');
}

/** The verified 'Send mail as' addresses of the deploying account (lower case), cached for 6 hours. Null if unknown. */
function sendAsAddresses_() {
  var cache = null;
  try { cache = CacheService.getScriptCache(); } catch (e) { cache = null; }
  var hit = cache && cache.get('mail_send_as');
  if (hit) return JSON.parse(hit);
  try {
    var res = Gmail.Users.Settings.SendAs.list('me');
    var list = ((res && res.sendAs) || []).filter(function (s) {
      return s.isPrimary || !s.verificationStatus || s.verificationStatus === 'accepted';
    }).map(function (s) { return String(s.sendAsEmail || '').toLowerCase(); });
    if (cache) cache.put('mail_send_as', JSON.stringify(list), 6 * 3600);
    return list;
  } catch (e) {
    return null;
  }
}

function remainingQuota_() {
  if (typeof MailApp !== 'undefined' && MailApp && typeof MailApp.getRemainingDailyQuota === 'function') return MailApp.getRemainingDailyQuota();
  return null;
}

/**
 * Sends one email. msg: { to: [], cc: [], replyTo, subject, text, html, attachments: [{ name, mimeType, base64 }] }.
 * Returns { from, via: 'gmail' | 'mailapp' }. Throws an api error (plain words) when it cannot send.
 */
function sendMail_(msg) {
  var sender = mailSender_();
  var count = msg.to.length + (msg.cc ? msg.cc.length : 0);
  var left = remainingQuota_();
  if (left !== null && left < count) {
    throw apiError_(ERR.BAD_REQUEST, 'The daily email quota of the Google account that runs the app is used up (' + Math.max(0, left) + ' left). Try again tomorrow.');
  }
  if (sender.email) {
    if (typeof Gmail === 'undefined' || !Gmail || !Gmail.Users) {
      throw apiError_(ERR.BAD_REQUEST, 'The system email is set, but the Gmail service is not turned on in the Apps Script project (Services > Gmail API). Turn it on, or clear the system email to send from the deploying account.');
    }
    var aliases = sendAsAddresses_();
    if (aliases && aliases.indexOf(sender.email) < 0) {
      throw apiError_(ERR.BAD_REQUEST, sender.email + ' is not a verified "Send mail as" address of the Google account that runs the app. Add it in Gmail > Settings > Accounts > Send mail as, confirm it, then try again.');
    }
    var from = mimeAddress_(sender.name, sender.email);
    var raw = buildMime_({ from: from, to: msg.to, cc: msg.cc || [], replyTo: msg.replyTo || '', subject: msg.subject, text: msg.text, html: msg.html, attachments: msg.attachments || [] });
    try {
      Gmail.Users.Messages.send({ raw: Utilities.base64EncodeWebSafe(raw, Utilities.Charset.UTF_8) }, 'me');
    } catch (err) {
      throw apiError_(ERR.BAD_REQUEST, 'Gmail did not send the email: ' + oneLine_(err && err.message ? err.message : err, 200));
    }
    return { from: from, via: 'gmail' };
  }
  if (typeof MailApp === 'undefined' || !MailApp) throw apiError_(ERR.BAD_REQUEST, 'Mail is not available (MailApp).');
  var opts = { to: msg.to.join(','), subject: msg.subject, body: msg.text || '', name: sender.name };
  if (msg.html) opts.htmlBody = msg.html;
  if (msg.cc && msg.cc.length) opts.cc = msg.cc.join(',');
  if (msg.replyTo) opts.replyTo = msg.replyTo;
  if (msg.attachments && msg.attachments.length) {
    opts.attachments = msg.attachments.map(function (a) { return Utilities.newBlob(Utilities.base64Decode(a.base64), a.mimeType, a.name); });
  }
  try {
    MailApp.sendEmail(opts);
  } catch (err2) {
    throw apiError_(ERR.BAD_REQUEST, 'The email could not be sent: ' + oneLine_(err2 && err2.message ? err2.message : err2, 200));
  }
  return { from: sender.name + ' (the Google account that runs the app)', via: 'mailapp' };
}

// ---------------------------------------------------------------- input checks

function cleanAddressList_(list, label, min, max) {
  if (list === undefined || list === null) list = [];
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, label + ' must be a list of email addresses.');
  var out = [];
  list.forEach(function (x) {
    var e = String(x === null || x === undefined ? '' : x).trim().toLowerCase();
    if (!e) return;
    if (e.length > 254 || !EMAIL_PATTERN_.test(e) || /[<>,;"\s]/.test(e)) throw apiError_(ERR.BAD_REQUEST, label + ': "' + e.slice(0, 60) + '" is not a valid email address.');
    if (out.indexOf(e) < 0) out.push(e);
  });
  if (out.length < min) throw apiError_(ERR.BAD_REQUEST, 'Add at least one recipient.');
  if (out.length > max) throw apiError_(ERR.BAD_REQUEST, label + ': at most ' + max + ' addresses.');
  return out;
}

/**
 * Keeps the formatting of the summary and removes anything that could run or call out: scripts, styles blocks,
 * frames, forms, event handlers, javascript: and data: links (data:image is allowed in src), and non-https links.
 */
function sanitizeMailHtml_(html) {
  var s = String(html || '');
  if (s.length > MAIL_LIMITS.maxHtml) throw apiError_(ERR.BAD_REQUEST, 'The email text is too long.');
  s = s.replace(/<!--[\s\S]*?-->/g, '');
  s = s.replace(/<\s*(script|style|iframe|object|embed|form|textarea|select|button|svg|math|template|noscript)\b[\s\S]*?<\s*\/\s*\1\s*>/gi, '');
  s = s.replace(/<\s*\/?\s*(script|style|iframe|object|embed|form|input|textarea|select|button|link|meta|base|frame|frameset|svg|math|template|noscript)\b[^>]*>/gi, '');
  s = s.replace(/\s+on[a-z]+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '');
  s = s.replace(/\s+(href|src|action|formaction|background|xlink:href)\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, function (m, attr, val) {
    var v = val.replace(/^["']|["']$/g, '').trim();
    var a = attr.toLowerCase();
    if (a === 'href' && /^https:\/\//i.test(v)) return ' href="' + v.replace(/"/g, '&quot;') + '"';
    if (a === 'href' && /^mailto:/i.test(v)) return ' href="' + v.replace(/"/g, '&quot;') + '"';
    if (a === 'src' && (/^https:\/\//i.test(v) || /^data:image\/(png|jpe?g|gif);base64,[a-z0-9+\/=]+$/i.test(v))) return ' src="' + v + '"';
    return '';
  });
  s = s.replace(/style\s*=\s*("[^"]*"|'[^']*')/gi, function (m, val) {
    return /expression\s*\(|javascript:|url\s*\(/i.test(val) ? '' : m;
  });
  return s;
}

function htmlToText_(html) {
  return String(html || '')
    .replace(/<\s*br\s*\/?>/gi, '\n')
    .replace(/<\s*\/(p|div|tr|h[1-6]|li|table)\s*>/gi, '\n')
    .replace(/<\s*\/t[dh]\s*>/gi, '\t')
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'")
    .replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
}

function cleanAttachments_(list) {
  if (list === undefined || list === null) return [];
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Attachments must be a list.');
  if (list.length > MAIL_LIMITS.maxAttachments) throw apiError_(ERR.BAD_REQUEST, 'At most ' + MAIL_LIMITS.maxAttachments + ' attachments.');
  var total = 0;
  return list.map(function (a) {
    requireObject_(a, 'An attachment');
    var type = String(a.mimeType || '');
    var ext = MAIL_TYPES_[type];
    if (!ext) throw apiError_(ERR.BAD_REQUEST, 'Only PDF, Excel and CSV files can be attached.');
    var name = cleanText_(a.name, 'The file name', true, 120).replace(/[\\\/:*?"<>|\r\n]/g, '_');
    if (!new RegExp('\\.' + ext + '$', 'i').test(name)) name += '.' + ext;
    var b64 = String(a.base64 || '').replace(/\s+/g, '');
    if (!b64 || !/^[A-Za-z0-9+\/]+=*$/.test(b64)) throw apiError_(ERR.BAD_REQUEST, 'The file ' + name + ' could not be read.');
    total += Math.floor(b64.length * 3 / 4);
    if (total > MAIL_LIMITS.maxBytes) throw apiError_(ERR.BAD_REQUEST, 'The attachments are larger than 15 MB together.');
    return { name: name, mimeType: type, base64: b64 };
  });
}

/** Counts sends per person per plant day in the script properties; throws past the limit. */
function countMailSend_(userId) {
  var day = Utilities.formatDate(new Date(nowMs_()), TIMEZONE, 'yyyy-MM-dd');
  var props = PropertiesService.getScriptProperties();
  var key = 'MAILCOUNT_' + userId;
  var cur = String(props.getProperty(key) || '');
  var n = cur.slice(0, 10) === day ? Number(cur.slice(11)) || 0 : 0;
  if (n >= MAIL_LIMITS.perUserPerDay) throw apiError_(ERR.BAD_REQUEST, 'You have sent ' + n + ' emails today, the most allowed in one day. Try again tomorrow.');
  return function () { props.setProperty(key, day + ' ' + (n + 1)); };
}

// ---------------------------------------------------------------- actions

/**
 * sendReport: { to: [], users: [user_id], cc: [], subject, html, attachments: [{ name, mimeType, base64 }], kind }. `users`: people
 * picked in the app; their addresses join To.
 * kind: 'report' | 'actions' (only for the log). Returns { from, via, recipients }.
 */
function sendReport_(session, p) {
  requireObject_(p, 'The email');
  // people picked in the app by user id: their addresses are looked up here, so the browser never needs them
  var picked = [];
  if (p.users !== undefined && p.users !== null) {
    if (!Array.isArray(p.users) || p.users.length > MAIL_LIMITS.maxTo) throw apiError_(ERR.BAD_REQUEST, 'The people picked must be a list of at most ' + MAIL_LIMITS.maxTo + '.');
    var byId = {};
    readUsers_().forEach(function (u) { byId[u.user_id] = u; });
    p.users.forEach(function (id) {
      var u = byId[String(id)];
      if (!u || !u.active || !EMAIL_PATTERN_.test(String(u.email || ''))) throw apiError_(ERR.BAD_REQUEST, 'There is no active user ' + String(id).slice(0, 40) + ' with an email address.');
      picked.push(String(u.email).toLowerCase());
    });
  }
  if (p.to !== undefined && p.to !== null && !Array.isArray(p.to)) throw apiError_(ERR.BAD_REQUEST, 'To must be a list of email addresses.');
  var to = cleanAddressList_([].concat(p.to || [], picked), 'To', 1, MAIL_LIMITS.maxTo);
  var cc = cleanAddressList_(p.cc, 'Cc', 0, MAIL_LIMITS.maxCc).filter(function (e) { return to.indexOf(e) < 0; });
  var subject = cleanText_(p.subject, 'The subject', true, MAIL_LIMITS.maxSubject).replace(/[\r\n]+/g, ' ');
  var html = sanitizeMailHtml_(p.html);
  var text = htmlToText_(html).slice(0, MAIL_LIMITS.maxText);
  var attachments = cleanAttachments_(p.attachments);
  var kind = p.kind === 'actions' ? 'actions' : 'report';
  var done = countMailSend_(session.user.user_id);
  var replyTo = EMAIL_PATTERN_.test(String(session.user.email || '')) ? session.user.email : '';
  var res = sendMail_({ to: to, cc: cc, replyTo: replyTo, subject: subject, text: text, html: html, attachments: attachments });
  done();
  var detail = (kind === 'actions' ? 'Actions report' : 'Report') + ' to ' + (to.length + cc.length) + ' recipient' + (to.length + cc.length === 1 ? '' : 's') +
    ': ' + subject + (attachments.length ? ' (' + attachments.map(function (a) { return a.name; }).join(', ') + ')' : '');
  withLock_(function () { auditLog_(session.user.user_id, 'send_report', '', kind, detail); });
  return { from: res.from, via: res.via, recipients: to.length + cc.length };
}

/** sendTestEmail (Admin): a short email to the Admin's own address. Returns { from, via, to }. */
function sendTestEmail_(session) {
  var to = String(session.user.email || '').trim().toLowerCase();
  if (!EMAIL_PATTERN_.test(to)) throw apiError_(ERR.BAD_REQUEST, 'Your account has no valid email address.');
  var sender = mailSender_();
  var html = '<p>This is a test email from ACC Downtime Analysis.</p><p>' +
    (sender.email ? 'It was sent as <b>' + htmlEscape_(sender.email) + '</b>.' : 'No system email is set, so it was sent by the Google account that runs the app.') + '</p>';
  var res = sendMail_({ to: [to], cc: [], replyTo: '', subject: 'ACC Downtime Analysis: test email', text: htmlToText_(html), html: html, attachments: [] });
  withLock_(function () { auditLog_(session.user.user_id, 'send_test_email', '', '', 'Test email to ' + to + ' (' + res.via + ')'); });
  return { from: res.from, via: res.via, to: to };
}

// ======================================================================
// Master.js
// ======================================================================
/** Master data: startup read, and audited saves for equipment, areas, reasons and aliases. */

/** Everything the dashboards need except events. Never includes users or the audit log. */
function getStartup_() {
  var years = {};
  readColumn_(T.EVENTS, 'event_date').forEach(function (d) {
    if (/^\d{4}/.test(d)) years[d.slice(0, 4)] = true;
  });
  return {
    lines: readTable_(T.LINES), areas: readTable_(T.AREAS), equipment: readTable_(T.EQUIPMENT),
    equipment_areas: readTable_(T.EQUIPMENT_AREAS), aliases: readTable_(T.ALIASES),
    classifications: readTable_(T.CLASSIFICATIONS), reasons: readTable_(T.REASONS),
    settings: readSettings_(),
    years: Object.keys(years).map(Number).sort(function (a, b) { return b - a; })
  };
}

function actor_(session) { return session.user.user_id; }

// ---------- equipment ----------

function equipmentReviewNote_(row, areaCount) {
  var missing = [];
  if (!row.description) missing.push('description');
  if (!row.criticality) missing.push('criticality');
  if (!areaCount) missing.push('area');
  return missing;
}

function saveEquipment_(session, row, areaIds) {
  requireObject_(row, 'Equipment');
  var id = codeKey_(cleanText_(row.equipment_id, 'Equipment code', true, 60));
  if (!Array.isArray(areaIds)) throw apiError_(ERR.BAD_REQUEST, 'Areas must be a list.');
  var wanted = [];
  areaIds.forEach(function (a) {
    var s = cleanText_(a, 'Area', true, 60);
    if (wanted.indexOf(s) < 0) wanted.push(s);
  });
  var status = row.status === 'Retired' ? 'Retired' : (row.status === 'Active' || !row.status ? 'Active' : null);
  if (!status) throw apiError_(ERR.BAD_REQUEST, 'Status must be Active or Retired.');
  var parent = row.parent_id ? codeKey_(cleanText_(row.parent_id, 'Parent code', false, 60)) : '';
  if (parent === id) throw apiError_(ERR.BAD_REQUEST, 'Equipment cannot be its own parent.');
  var rec = {
    equipment_id: id,
    description: cleanText_(row.description, 'Description', false),
    equipment_type: cleanText_(row.equipment_type, 'Type', false, 100),
    criticality: cleanText_(row.criticality, 'Criticality', false, 100),
    parent_id: parent, status: status,
    origin: cleanText_(row.origin, 'Origin', false, 100),
    platform_plant_area: cleanText_(row.platform_plant_area, 'Plant area', false, 100),
    platform_main_area: cleanText_(row.platform_main_area, 'Main area', false, 100),
    platform_sub_area: cleanText_(row.platform_sub_area, 'Sub area', false, 100),
    updated_at: nowTs_(), updated_by: actor_(session)
  };
  var missing = equipmentReviewNote_(rec, wanted.length);
  rec.needs_review = missing.length > 0;
  var note = cleanText_(row.review_note, 'Review note', false);
  if (rec.needs_review) rec.review_note = note || 'Missing: ' + missing.join(', ');
  else rec.review_note = /^Missing:/.test(note) ? '' : note;
  withLock_(function () {
    var areaSet = {};
    readTable_(T.AREAS).forEach(function (a) { areaSet[a.area_id] = true; });
    wanted.forEach(function (a) { if (!areaSet[a]) throw apiError_(ERR.BAD_REQUEST, 'Unknown area: ' + a + '.'); });
    var existing = findBy_(T.EQUIPMENT, 'equipment_id', id);
    if (!rec.origin) rec.origin = existing ? existing.origin : 'User';
    if (existing) updateRow_(T.EQUIPMENT, existing._row, rec);
    else { rec.created_at = nowTs_(); appendRow_(T.EQUIPMENT, rec); }
    var links = readTable_(T.EQUIPMENT_AREAS).filter(function (l) { return l.equipment_id === id; });
    var have = links.map(function (l) { return l.area_id; });
    deleteRows_(T.EQUIPMENT_AREAS, links.filter(function (l) { return wanted.indexOf(l.area_id) < 0; }).map(function (l) { return l._row; }));
    appendRows_(T.EQUIPMENT_AREAS, wanted.filter(function (a) { return have.indexOf(a) < 0; })
      .map(function (a) { return { equipment_id: id, area_id: a }; }));
    var areasText = wanted.slice().sort().join(', ') || '(none)';
    var detail;
    if (existing) {
      var was = existing;
      was.areas = have.slice().sort().join(', ') || '(none)';
      detail = auditChanges_(was, { description: rec.description, equipment_type: rec.equipment_type, criticality: rec.criticality,
        parent_id: rec.parent_id, status: rec.status, areas: areasText }, ['description', 'equipment_type', 'criticality', 'parent_id', 'status', 'areas']) || 'No change';
    } else {
      detail = (rec.description || '(no description)') + '. Areas: ' + areasText;
    }
    auditLog_(actor_(session), existing ? 'update_equipment' : 'add_equipment', T.EQUIPMENT, id, detail);
  });
  return null;
}

// ---------- areas ----------

function saveArea_(session, row) {
  requireObject_(row, 'Area');
  var rec = {
    area_id: cleanText_(row.area_id, 'Area code', true, 60),
    name: cleanText_(row.name, 'Name', true, 100),
    line_id: cleanText_(row.line_id, 'Line', true, 20),
    sort_order: toIntOr_(row.sort_order, 0),
    active: toBool_(row.active),
    in_downtime_sheet: toBool_(row.in_downtime_sheet),
    notes: cleanText_(row.notes, 'Notes', false)
  };
  withLock_(function () {
    if (!findBy_(T.LINES, 'line_id', rec.line_id)) throw apiError_(ERR.BAD_REQUEST, 'Unknown line: ' + rec.line_id + '.');
    // 1.5.0: switching an area on or off hides or shows all its records plant-wide, so only an Admin may change it
    var before = findBy_(T.AREAS, 'area_id', rec.area_id);
    var wasActive = before ? toBool_(before.active) : true;
    if (rec.active !== wasActive && !isAdmin_(session)) {
      throw apiError_(ERR.FORBIDDEN, 'Only an Admin can switch an area on or off (Settings > Areas).');
    }
    var how = upsertBy_(T.AREAS, 'area_id', rec);
    auditLog_(actor_(session), how === 'added' ? 'add_area' : 'update_area', T.AREAS, rec.area_id, how === 'added'
      ? rec.name + ' on ' + rec.line_id
      : auditChanges_(before, rec, ['name', 'line_id', 'sort_order', 'active', 'in_downtime_sheet', 'notes']) || 'No change');
  });
  return null;
}

function isAdmin_(session) { return !!session && session.user.role_id === 'ROLE-ADMIN'; }

/**
 * 1.5.0: switches one area on or off (Admin only, audited). An inactive area (active = FALSE) and every record of it are
 * left out of every page, number and rule as if they did not exist; the records stay stored and come back when the
 * area is switched on again. Returns the area as stored.
 */
function setAreaActive_(session, areaId, active) {
  if (!isAdmin_(session)) throw apiError_(ERR.FORBIDDEN, 'Only an Admin can switch an area on or off.'); // also in ACTION_RULES
  var id = cleanText_(areaId, 'Area code', true, 60);
  if (typeof active !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'Active must be true or false.');
  return withLock_(function () {
    var row = findBy_(T.AREAS, 'area_id', id);
    if (!row) throw apiError_(ERR.NOT_FOUND, 'Unknown area: ' + oneLine_(id, 60) + '.');
    if (toBool_(row.active) !== active) {
      updateRow_(T.AREAS, row._row, { active: active });
      auditLog_(actor_(session), active ? 'activate_area' : 'deactivate_area', T.AREAS, id,
        (active ? 'Area switched on: ' : 'Area switched off: ') + row.name + ' on ' + row.line_id);
    }
    return findBy_(T.AREAS, 'area_id', id);
  });
}

/** Ids of the areas switched off (active = FALSE). Every rule leaves their records out (1.5.0). */
function inactiveAreaIds_() {
  var out = {};
  readTable_(T.AREAS).forEach(function (a) { if (!toBool_(a.active)) out[a.area_id] = true; });
  return out;
}

// ---------- reasons ----------

function saveReason_(session, row) {
  requireObject_(row, 'Reason');
  var cls = cleanText_(row.classification, 'Classification', true, 10).toUpperCase();
  if (typeof row.text_as_listed !== 'string' || !row.text_as_listed.trim()) throw apiError_(ERR.BAD_REQUEST, 'Reason text is required.');
  if (row.text_as_listed.length > TEXT_MAX) throw apiError_(ERR.BAD_REQUEST, 'Reason text is too long.');
  withLock_(function () {
    if (!findBy_(T.CLASSIFICATIONS, 'code', cls)) throw apiError_(ERR.BAD_REQUEST, 'Unknown classification: ' + cls + '.');
    var all = readTable_(T.REASONS);
    var id = typeof row.reason_id === 'string' ? row.reason_id.trim() : '';
    var existing = id ? all.filter(function (r) { return r.reason_id === id; })[0] : null;
    var order = toIntOr_(row.order_no, 0);
    if (existing && order < 1) order = existing.order_no;
    if (!existing && order < 1) {
      order = 1 + all.filter(function (r) { return r.classification === cls; })
        .reduce(function (m, r) { return Math.max(m, r.order_no || 0); }, 0);
    }
    if (!id) {
      id = 'R-' + cls + '-' + ('000' + order).slice(-3);
      while (all.some(function (r) { return r.reason_id === id; })) { order++; id = 'R-' + cls + '-' + ('000' + order).slice(-3); }
    }
    var rec = {
      reason_id: id, classification: cls, text_as_listed: row.text_as_listed, match_key: matchKey_(row.text_as_listed),
      order_no: order, active: row.active === undefined ? true : toBool_(row.active)
    };
    var how = upsertBy_(T.REASONS, 'reason_id', rec);
    auditLog_(actor_(session), how === 'added' ? 'add_reason' : 'update_reason', T.REASONS, id, how === 'added'
      ? cls + ': ' + auditValue_(rec.text_as_listed, 120)
      : auditChanges_(existing, rec, ['classification', 'text_as_listed', 'order_no', 'active']) || 'No change');
  });
  return null;
}

// ---------- aliases ----------

function saveAlias_(session, row) {
  requireObject_(row, 'Alias');
  var alias = codeKey_(cleanText_(row.alias, 'Alias', true, 60));
  var target = codeKey_(cleanText_(row.equipment_id, 'Equipment code', true, 60));
  if (alias === target) throw apiError_(ERR.BAD_REQUEST, 'The alias must differ from the code it points to.');
  var rec = { alias: alias, equipment_id: target, reason: cleanText_(row.reason, 'Reason', false) };
  withLock_(function () {
    if (!findBy_(T.EQUIPMENT, 'equipment_id', target)) throw apiError_(ERR.BAD_REQUEST, 'Unknown equipment code: ' + target + '.');
    var was = findBy_(T.ALIASES, 'alias', alias);
    var how = upsertBy_(T.ALIASES, 'alias', rec);
    auditLog_(actor_(session), how === 'added' ? 'add_alias' : 'update_alias', T.ALIASES, alias, 'Points to ' + target +
      (was && was.equipment_id !== target ? ' (was ' + was.equipment_id + ')' : '') + (rec.reason ? '. Reason: ' + auditValue_(rec.reason, 80) : ''));
  });
  return null;
}

function deleteAlias_(session, alias) {
  var key = codeKey_(cleanText_(alias, 'Alias', true, 60));
  withLock_(function () {
    var existing = findBy_(T.ALIASES, 'alias', key);
    if (!existing) throw apiError_(ERR.NOT_FOUND, 'Alias not found.');
    deleteRows_(T.ALIASES, [existing._row]);
    auditLog_(actor_(session), 'delete_alias', T.ALIASES, key, 'Was pointing to ' + existing.equipment_id);
  });
  return null;
}

// ======================================================================
// Notifications.js
// ======================================================================
/**
 * Notifications (docs/notifications-design.md).
 *
 * Stored notifications are alerts and updates only; action items are derived live by the app.
 * The rules below use the same formulas as the browser (src/calc/events.ts, repeats.ts, kpis.ts) and
 * leave out voided and blocked records exactly like the browser does. The mock API
 * (src/api/mockNotifications.ts) implements the same rules over the calc library; the contract test
 * keeps the two in step.
 *
 * Decisions that the design left open (all documented in docs/wire-protocol.md section 9):
 * - "Now" for the data rules is the latest stored event date, never the wall clock (so historical data
 *   works); only upload_gap and expiry use today's date.
 * - A long stop or repeated-failure group is only raised when it is recent: its (last) event started
 *   within notif_retention_days before the latest stored event date. Older ones would expire at once,
 *   and without this the very first check on a database with years of history would flood the panel.
 * - dedupe_key is unique over all statuses. A resolved row is re-opened if its condition returns;
 *   an expired row is never re-opened.
 */

var NOTIF_RESOLVABLE_ = ['long_stop', 'repeat_group', 'upload_gap', 'action_due', 'action_ready_to_close', 'task_overdue'];
// Most severe first (used by the digest).
var NOTIF_SEVERITY_ORDER_ = ['long_stop', 'availability_low', 'planned_overrun', 'failure_spike', 'repeat_group', 'task_overdue', 'action_due', 'action_ready_to_close', 'upload_gap'];
// The inbox category of each type (1.4.0). Returned with every item by getNotifications; not stored.
var NOTIF_CATEGORY_ = {
  long_stop: 'Reliability', repeat_group: 'Reliability', failure_spike: 'Reliability',
  availability_low: 'Availability & planned', planned_overrun: 'Availability & planned',
  upload_gap: 'Data quality', upload_done: 'Data quality', action_due: 'Actions', user_event: 'System',
  action_ready_to_close: 'Actions', task_overdue: 'Actions' // 1.7.0
};
var NOTIF_PREF_KEYS_ = ['alert_types', 'watch_areas', 'digest', 'last_seen_at', 'saved_views', 'saved_reports', 'theme'];
// The person's theme (1.5.0), kept with their account so it follows them to every device. Mirrored in src/theme/themes.ts.
var ACCOUNT_THEMES_ = ['ACC Light', 'Warm Paper', 'High Contrast', 'Navy Dark', 'Carbon Dark'];
var SAVED_VIEWS_MAX_ = 20;
var SAVED_VIEWS_TEXT_MAX_ = 20000;
var SAVED_VIEW_PAGES_ = ['overview', 'pareto', 'repeats', 'reliability', 'events'];
// Saved report templates (Reports page): at most 20 of {id, name, template, period, filters, sections, options}.
// The lists below are mirrored in src/api/types.ts (REPORT_*); a unit test compares them.
var SAVED_REPORTS_MAX_ = 20;
var SAVED_REPORTS_TEXT_MAX_ = 20000;
var REPORT_TEMPLATES_ = ['monthly', 'area', 'failure', 'custom'];
var REPORT_PRESETS_ = ['lastmonth', 'thismonth', 'last3', 'ytd', 'custom'];
var REPORT_SECTION_IDS_ = [
  'cover', 'summary', 'daily', 'monthly', 'classes', 'area_downtime', 'availability', 'mtbf_mttr', 'failure_rate',
  'top_equipment', 'top_reasons', 'pareto', 'repeats', 'longest', 'quadrant', 'when', 'events', 'quality', 'methodology'
];
var REPORT_CLASSES_ = ['PRO', 'MEC', 'ELE', 'AUT', 'PL', 'CIR'];
var REPORT_FILTER_LISTS_ = ['lines', 'areas', 'equipment', 'classifications', 'criticality'];
var REPORT_LIST_MAX_ = 100;
var NOTIF_DIGEST_MODES_ = ['none', 'daily', 'weekly'];
var NOTIF_DIGEST_MAX_ = 10;
var NOTIF_SPIKE_DAYS_ = 30;
var NOTIF_SPIKE_MIN_NOW_ = 5;
var NOTIF_SNOOZE_MAX_DAYS_ = 366;
var NOTIF_BLOCKING_FLAGS_ = ['missing_classification', 'invalid_classification', 'unknown_area', 'end_before_start'];
var NOTIF_INFO_FLAGS_ = ['code_not_in_area'];
var MS_DAY_ = 86400000;
// P5 (src/calc/repeats.ts): the same code and reason in different areas within 10 minutes is one occurrence.
var NOTIF_CROSS_AREA_MERGE_MS_ = 10 * 60000;

// ---------- small helpers ----------

function notifEnum_(table, column) { return enumOf_(table, column); }

function fmtTsMs_(ms) { return Utilities.formatDate(new Date(ms), TIMEZONE, 'yyyy-MM-dd HH:mm:ss.SSS'); }

function dateMs_(d) {
  var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(d || ''));
  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) : null;
}

function msDate_(ms) { return new Date(ms).toISOString().slice(0, 10); }

function addDays_(d, n) { return msDate_(dateMs_(d) + n * MS_DAY_); }

function lastDayOfMonth_(month) {
  var y = +month.slice(0, 4), m = +month.slice(5, 7);
  var last = new Date(Date.UTC(y, m, 0)).getUTCDate();
  return month + '-' + (last < 10 ? '0' : '') + last;
}

function addMonths_(month, n) {
  var y = +month.slice(0, 4), m = +month.slice(5, 7) - 1 + n;
  var yy = y + Math.floor(m / 12), mm = ((m % 12) + 12) % 12;
  return yy + '-' + (mm + 1 < 10 ? '0' : '') + (mm + 1);
}

function splitFlags_(flags) {
  return String(flags === null || flags === undefined ? '' : flags).split(',').map(function (f) { return f.trim(); }).filter(Boolean);
}
/** Stored flags minus the ones a user kept as entered (events.accepted_flags). Accepted flags are not open problems. */
/**
 * P2 (src/calc/flags.ts hasFailureFlagMismatch): Failure = YES on a PL / CIR row or on a continuation (Freq = 0) row.
 * Worked out from the row, never stored; a record carries it as an open problem until it is kept as entered.
 */
function failureFlagMismatch_(e) {
  return toBool_(e.is_failure) && (e.classification === 'PL' || e.classification === 'CIR' || Number(e.freq) === 0);
}

/** P2 (src/calc/events.ts isFailureHead): Freq = 1, Failure = YES, not PL and not CIR. */
function isFailureHead_(row) {
  return Number(row.freq) === 1 && row.is_failure === true && row.classification !== 'PL' && row.classification !== 'CIR';
}

function openFlags_(e) {
  var kept = splitFlags_(e.accepted_flags);
  return splitFlags_(e.flags).filter(function (f) { return kept.indexOf(f) < 0; });
}
function hasOpenProblem_(e) {
  if (openFlags_(e).some(function (f) { return NOTIF_INFO_FLAGS_.indexOf(f) < 0; })) return true;
  // the derived warning failure_flag_mismatch (the app's Validate list); overlaps are information, never counted
  return failureFlagMismatch_(e) && splitFlags_(e.accepted_flags).indexOf('failure_flag_mismatch') < 0;
}
function isBlockedFlags_(flags) { return splitFlags_(flags).some(function (f) { return NOTIF_BLOCKING_FLAGS_.indexOf(f) >= 0; }); }
function hasProblemFlags_(flags) { return splitFlags_(flags).some(function (f) { return NOTIF_INFO_FLAGS_.indexOf(f) < 0; }); }

function csv_(s) {
  return String(s === null || s === undefined ? '' : s).split(',').map(function (x) { return x.trim(); }).filter(Boolean);
}

function oneLine_(s, max) {
  var t = String(s === null || s === undefined ? '' : s).replace(/\s+/g, ' ').trim();
  return t.length > max ? t.slice(0, max - 1) + '.' : t;
}

// ---------- settings ----------

function notifNum_(map, key, dflt, min, max) {
  var raw = map[key];
  if (raw === undefined || raw === null || String(raw).trim() === '') return dflt;
  var n = Number(raw);
  return isFinite(n) && n >= min && n <= max ? n : dflt;
}

/** The settings the rules read, with the same defaults as schema/tables.json when a row is missing. */
function notifSettings_() {
  var map = {};
  readSettings_().forEach(function (r) { map[r.key] = r.value; });
  var target = map.availability_target_pct;
  var targetN = target === undefined || target === null || String(target).trim() === '' ? null : Number(target);
  var repeat = String(map.notif_repeat_alert === undefined ? 'true' : map.notif_repeat_alert).trim().toLowerCase();
  return {
    longStopHours: notifNum_(map, 'notif_long_stop_hours', 8, 0, 100000),
    spikePct: notifNum_(map, 'notif_spike_pct', 30, 0, 100000),
    uploadGapDays: notifNum_(map, 'notif_upload_gap_days', 35, 0, 100000),
    availabilityTargetPct: targetN !== null && isFinite(targetN) ? targetN : null,
    repeatAlert: repeat !== 'false' && repeat !== '0' && repeat !== 'no',
    retentionDays: notifNum_(map, 'notif_retention_days', 30, 1, 100000),
    appUrl: /^https?:\/\//i.test(String(map.app_url || '').trim()) ? String(map.app_url).trim() : '',
    repeatMinEvents: Math.max(2, Math.round(notifNum_(map, 'repeat_min_events', 2, 1, 1000))),
    repeatWindowDays: notifNum_(map, 'repeat_window_days', 30, 0, 3650),
    hoursPerDay: notifNum_(map, 'scheduled_hours_per_day', 24, 0, 24),
    daysPerWeek: Math.round(notifNum_(map, 'scheduled_days_per_week', 7, 0, 7))
  };
}

// ---------- event chaining (port of src/calc/events.ts buildFailureEvents) ----------

function notifChainArea_(parsed, tol) {
  parsed.sort(function (a, b) { return (a.stop - b.stop) || (b.row.freq - a.row.freq) || (a.idx - b.idx); });
  var out = [], open = [];
  function newChain(p, orphan) {
    return {
      id: p.row.event_id, area_id: p.row.area_id, line_id: p.row.line_id, head: p.row, rows: [p.row],
      startMs: p.stop, endMs: p.start, startDate: String(p.row.stop_ts).slice(0, 10),
      durationS: p.start > p.stop ? (p.start - p.stop) / 1000 : 0, isFailure: !orphan && isFailureHead_(p.row), orphan: orphan
    };
  }
  // exact duplicates (same area, code, stop, restart, class) are one stop: they share the stop, so they are neighbours here
  var sameStop = NaN, seen = [];
  parsed.forEach(function (p) {
    if (p.stop !== sameStop) { sameStop = p.stop; seen = []; }
    var dk = codeKey_(p.row.code_raw || '') + '|' + p.row.start_ts + '|' + p.row.classification;
    if (seen.indexOf(dk) >= 0) return;
    seen.push(dk);
    var w = 0;
    for (var r = 0; r < open.length; r++) if (open[r].tail >= p.stop - tol) open[w++] = open[r];
    open.length = w;
    if (p.row.freq === 1) {
      var c = newChain(p, false);
      out.push(c);
      open.push({ chain: c, tail: p.start });
      return;
    }
    var best = null;
    open.forEach(function (o) {
      if (Math.abs(o.tail - p.stop) <= tol && (!best || Math.abs(o.tail - p.stop) < Math.abs(best.tail - p.stop))) best = o;
    });
    if (best) {
      best.chain.rows.push(p.row);
      best.chain.endMs = Math.max(best.chain.endMs, p.start);
      if (p.start > p.stop) best.chain.durationS += (p.start - p.stop) / 1000;
      best.tail = p.start;
    } else {
      var oc = newChain(p, true);
      out.push(oc);
      open.push({ chain: oc, tail: p.start });
    }
  });
  return out;
}

/** Chains of analysable rows (the caller has already left out voided and blocked rows). */
function notifBuildChains_(rows) {
  var byArea = {};
  rows.forEach(function (row, idx) {
    var stop = parseTs_(row.stop_ts), start = parseTs_(row.start_ts);
    if (stop === null || start === null) return;
    (byArea[row.area_id] = byArea[row.area_id] || []).push({ row: row, stop: stop, start: start, idx: idx });
  });
  var chains = [];
  Object.keys(byArea).forEach(function (a) { chains = chains.concat(notifChainArea_(byArea[a], 1000)); });
  chains.sort(function (a, b) {
    return (a.startMs - b.startMs) || (a.area_id < b.area_id ? -1 : a.area_id > b.area_id ? 1 : 0) || (a.id < b.id ? -1 : 1);
  });
  return chains;
}

/** Port of findClusters in src/calc/repeats.ts. */
function notifFindClusters_(starts, minEvents, windowDays) {
  var w = windowDays * MS_DAY_, n = starts.length;
  var clusters = [], cur = [], runEnd = -1, e = 0;
  for (var i = 0; i < n; i++) {
    if (e < i) e = i;
    while (e + 1 < n && starts[e + 1] - starts[i] <= w) e++;
    if (e - i + 1 < minEvents) continue;
    if (i > runEnd) {
      if (cur.length) clusters.push(cur);
      cur = [];
      for (var k = i; k <= e; k++) cur.push(k);
    } else {
      for (var j = runEnd + 1; j <= e; j++) cur.push(j);
    }
    runEnd = Math.max(runEnd, e);
  }
  if (cur.length) clusters.push(cur);
  return clusters;
}

// ---------- data for the rules ----------

function notifLoadContext_(st) {
  var areas = {}, inactive = {};
  readTable_(T.AREAS).forEach(function (a) {
    areas[a.area_id] = a;
    if (!toBool_(a.active)) inactive[a.area_id] = true;
  });
  // 1.5.0: records of an area switched off are left out of every rule, as if they did not exist
  var all = readTable_(T.EVENTS, function (row, idx) { return !toBool_(row[idx.is_void]) && !inactive[row[idx.area_id]]; });
  var equipmentByKey = {}, aliases = {};
  readColumn_(T.EQUIPMENT, 'equipment_id').forEach(function (id) { equipmentByKey[codeKey_(id)] = id; });
  readTable_(T.ALIASES).forEach(function (a) { aliases[codeKey_(a.alias)] = a.equipment_id; });
  var latest = '';
  all.forEach(function (r) { if (isValidDate_(r.event_date) && r.event_date > latest) latest = r.event_date; });
  var rows = all.filter(function (r) { return !isBlockedFlags_(r.flags); });
  var ctx = { st: st, all: all, rows: rows, areas: areas, inactive: inactive, equipmentByKey: equipmentByKey, aliases: aliases, latest: latest, today: nowTs_().slice(0, 10) };
  ctx.cutoff = latest ? addDays_(latest, -st.retentionDays) : '';
  return ctx;
}

function notifLineOf_(ctx, areaId, fallback) {
  var a = ctx.areas[areaId];
  return a ? a.line_id : (fallback || '');
}

/** Code of a failure for grouping, as in src/calc/normalize.ts rowCode + repeats.ts: null for area-level. */
function notifCodeOf_(ctx, row) {
  var key = codeKey_(row.code_raw);
  if (row.is_area_level || AREA_LEVEL_KEYS.indexOf(key) >= 0) return null;
  if (row.equipment_id) return String(row.equipment_id).toUpperCase();
  var aliased = ctx.aliases[key];
  if (aliased !== undefined && ctx.equipmentByKey[codeKey_(aliased)] !== undefined) return String(ctx.equipmentByKey[codeKey_(aliased)]).toUpperCase();
  if (ctx.equipmentByKey[key] !== undefined) return String(ctx.equipmentByKey[key]).toUpperCase();
  return key;
}

function notifCandidate_(type, key, title, detail, areaId, lineId, ref) {
  return {
    type: type, severity: 'alert', dedupe_key: key, title: oneLine_(title, 200), detail: oneLine_(detail, 500),
    area_id: areaId || '', line_id: lineId || '', source_ref: ref || ''
  };
}

// ---------- the rules ----------

/** long_stop: a chained failure event longer than notif_long_stop_hours. */
function notifRuleLongStop_(ctx, chains) {
  var out = [];
  var limit = ctx.st.longStopHours;
  chains.forEach(function (c) {
    if (!c.isFailure || !(c.durationS / 3600 > limit)) return;
    if (c.startDate < ctx.cutoff) return;
    var h = (c.durationS / 3600).toFixed(1);
    out.push(notifCandidate_('long_stop', 'long_stop|' + c.id,
      'Long stop: ' + c.area_id + ' ' + h + ' h',
      'A failure stopped ' + c.area_id + ' for ' + h + ' hours (limit ' + limit + ' h), starting ' + String(c.head.stop_ts).slice(0, 16) + '.',
      c.area_id, notifLineOf_(ctx, c.area_id, c.line_id), c.id));
  });
  return out;
}

/**
 * Port of groupOccurrences in src/calc/repeats.ts (sorted failure events of one group): an event joins the current
 * occurrence when it starts at most 10 minutes after the occurrence's first event and its area is not in it yet.
 */
function notifOccurrences_(sorted) {
  var out = [];
  sorted.forEach(function (c) {
    var cur = out.length ? out[out.length - 1] : null;
    if (cur && c.startMs - cur.startMs <= NOTIF_CROSS_AREA_MERGE_MS_ && cur.areas.indexOf(c.area_id) < 0) {
      cur.members.push(c);
      cur.areas.push(c.area_id);
    } else {
      out.push({ members: [c], startMs: c.startMs, areas: [c.area_id] });
    }
  });
  return out;
}

/**
 * repeat_group: same code and reason, at least repeat_min_events OCCURRENCES within repeat_window_days. An occurrence is
 * one failure event, or several in different areas that start within 10 minutes (P5).
 */
function notifRuleRepeat_(ctx, chains) {
  var out = [];
  if (!ctx.st.repeatAlert) return out;
  var groups = {}, order = [];
  chains.forEach(function (c) {
    if (!c.isFailure) return;
    var code = notifCodeOf_(ctx, c.head);
    if (code === null) return;
    var reasonKey = matchKey_(c.head.reason_raw);
    if (reasonKey === '') return;
    var key = code + '|' + reasonKey;
    if (!groups[key]) { groups[key] = { code: code, reasonKey: reasonKey, list: [] }; order.push(key); }
    groups[key].list.push(c);
  });
  order.forEach(function (key) {
    var g = groups[key];
    g.list.sort(function (a, b) { return (a.startMs - b.startMs) || (a.id < b.id ? -1 : 1); });
    var occs = notifOccurrences_(g.list);
    var clusters = notifFindClusters_(occs.map(function (o) { return o.startMs; }), ctx.st.repeatMinEvents, ctx.st.repeatWindowDays);
    clusters.forEach(function (cl) {
      var first = occs[cl[0]].members[0], last = occs[cl[cl.length - 1]].members[0];
      if (last.startDate < ctx.cutoff) return;
      var label = oneLine_(first.head.reason_raw, 120);
      out.push(notifCandidate_('repeat_group', 'repeat|' + first.area_id + '|' + g.code + '|' + g.reasonKey + '|' + first.id,
        'Repeated failure: ' + g.code + ' - ' + label,
        cl.length + ' failures within ' + ctx.st.repeatWindowDays + ' days, latest ' + last.startDate + '. First in ' + first.area_id + '.',
        first.area_id, notifLineOf_(ctx, first.area_id, first.line_id), first.id));
    });
  });
  return out;
}

/** failure_spike: failure EVENTS (P2: chains with a Freq 1, Failure YES, not PL / CIR head) that started in the 30 days ending at the latest event date vs the 30 days before. */
function notifRuleSpike_(ctx, chains) {
  var out = [];
  if (!ctx.latest) return out;
  var nowFrom = dateMs_(addDays_(ctx.latest, -(NOTIF_SPIKE_DAYS_ - 1)));
  var nowTo = dateMs_(ctx.latest) + MS_DAY_;
  var prevFrom = nowFrom - NOTIF_SPIKE_DAYS_ * MS_DAY_;
  var counts = {};
  chains.forEach(function (ch) {
    if (!ch.isFailure) return;
    var stop = ch.startMs;
    var c = counts[ch.area_id] || (counts[ch.area_id] = { now: 0, prev: 0 });
    if (stop >= nowFrom && stop < nowTo) c.now++;
    else if (stop >= prevFrom && stop < nowFrom) c.prev++;
  });
  Object.keys(counts).sort().forEach(function (area) {
    var c = counts[area];
    if (c.now < NOTIF_SPIKE_MIN_NOW_) return;
    var pct = c.prev === 0 ? null : ((c.now - c.prev) / c.prev) * 100;
    if (pct !== null && !(pct > ctx.st.spikePct)) return;
    out.push(notifCandidate_('failure_spike', 'spike|' + area + '|' + ctx.latest,
      pct === null ? 'Failures rising in ' + area + ': ' + c.now + ' (none before)' : 'Failures up ' + Math.round(pct) + '% in ' + area,
      c.now + ' failures in the ' + NOTIF_SPIKE_DAYS_ + ' days to ' + ctx.latest + ', against ' + c.prev + ' in the ' + NOTIF_SPIKE_DAYS_ + ' days before.',
      area, notifLineOf_(ctx, area, ''), ''));
  });
  return out;
}

/** upload_gap: the latest stored event is older than notif_upload_gap_days. */
function notifRuleGap_(ctx) {
  if (!ctx.latest) return [];
  var days = Math.round((dateMs_(ctx.today) - dateMs_(ctx.latest)) / MS_DAY_);
  if (!(days > ctx.st.uploadGapDays)) return [];
  return [notifCandidate_('upload_gap', 'upload_gap|' + ctx.latest, 'No upload since ' + ctx.latest,
    'The latest stored event is dated ' + ctx.latest + ', ' + days + ' days ago (limit ' + ctx.st.uploadGapDays + ' days).', '', '', '')];
}

function notifScheduledDays_(from, to, perWeek) {
  var total = Math.round((dateMs_(to) - dateMs_(from)) / MS_DAY_) + 1;
  if (perWeek >= 7) return total;
  var startDow = (new Date(dateMs_(from)).getUTCDay() + 6) % 7;
  var count = 0;
  for (var k = 0; k < total; k++) if ((startDow + k) % 7 < perWeek) count++;
  return count;
}

/**
 * Port of attributeRows in src/calc/attribution.ts for one window (P1): the downtime of an area is the UNION of its rows;
 * time covered by several rows goes to one of them: PL before incidental before CIR, then the row that started first,
 * then the longer one, then the lower event id. Returns { area: { pl, inc, cir } } in hours inside [wFrom, wTo).
 */
function notifUnionHours_(rows, wFrom, wTo) {
  var byArea = {};
  rows.forEach(function (r) {
    var s = parseTs_(r.stop_ts), e = parseTs_(r.start_ts);
    if (s === null || e === null || !(e > s)) return;
    var prec = r.classification === 'PL' ? 0 : r.classification === 'CIR' ? 2 : 1;
    (byArea[r.area_id] = byArea[r.area_id] || []).push({ row: r, from: s, to: e, prec: prec });
  });
  function better(a, b) {
    if (a.prec !== b.prec) return a.prec < b.prec;
    if (a.from !== b.from) return a.from < b.from;
    if (a.to !== b.to) return a.to > b.to;
    return a.row.event_id < b.row.event_id;
  }
  var out = {};
  Object.keys(byArea).forEach(function (area) {
    var items = byArea[area].sort(function (a, b) { return (a.from - b.from) || (a.to - b.to); });
    var pts = [];
    items.forEach(function (i) { pts.push(i.from, i.to); });
    pts.sort(function (a, b) { return a - b; });
    var acc = out[area] = { pl: 0, inc: 0, cir: 0 };
    var next = 0, active = [];
    for (var p = 0; p + 1 < pts.length; p++) {
      var lo = pts[p], hi = pts[p + 1];
      if (hi === lo) continue;
      while (next < items.length && items[next].from <= lo) active.push(items[next++]);
      active = active.filter(function (i) { return i.to > lo; });
      if (!active.length) continue;
      var win = active[0];
      for (var k = 1; k < active.length; k++) if (better(active[k], win)) win = active[k];
      var f = Math.max(lo, wFrom), u = Math.min(hi, wTo);
      if (!(u > f)) continue;
      var h = (u - f) / 3600000;
      if (win.prec === 0) acc.pl += h;
      else if (win.prec === 2) acc.cir += h;
      else acc.inc += h;
    }
  });
  return out;
}

/**
 * availability_low: availability on basis B, B = (T - PL - (INC + CIR)) / (T - PL), of each area for the latest
 * complete month in the data (the month of the latest event date if that date is its last day, else the month
 * before), clipped to the data range like computeKpis. Overlapping stops of one area count once (P1, union per area);
 * a month without any record is 'not uploaded' and raises nothing (P6). Only when availability_target_pct is set.
 */
function notifRuleAvailability_(ctx) {
  var out = [];
  var target = ctx.st.availabilityTargetPct;
  if (target === null || !ctx.latest) return out;
  var month = ctx.latest.slice(0, 7);
  if (ctx.latest !== lastDayOfMonth_(month)) month = addMonths_(month, -1);
  var lo = '', hi = '';
  ctx.rows.forEach(function (r) {
    var a = String(r.stop_ts).slice(0, 10), b = String(r.start_ts).slice(0, 10);
    if (b < a) b = a;
    if (lo === '' || a < lo) lo = a;
    if (b > hi) hi = b;
  });
  if (lo === '') return out;
  var from = month + '-01', to = lastDayOfMonth_(month);
  if (lo > from) from = lo;
  if (hi < to) to = hi;
  if (from > to) return out;
  // P6: no record at all (voided ones aside) starts or runs in the month: not uploaded, nothing to judge
  var mFrom = dateMs_(month + '-01'), mTo = dateMs_(lastDayOfMonth_(month)) + MS_DAY_;
  var uploaded = ctx.all.some(function (r) {
    var s = parseTs_(r.stop_ts), e = parseTs_(r.start_ts);
    return s !== null && s < mTo && (s >= mFrom || (e !== null && e > mFrom));
  });
  if (!uploaded) return out;
  var wFrom = dateMs_(from), wTo = dateMs_(to) + MS_DAY_;
  var t = notifScheduledDays_(from, to, ctx.st.daysPerWeek) * ctx.st.hoursPerDay;
  var acc = notifUnionHours_(ctx.rows, wFrom, wTo);
  ctx.rows.forEach(function (r) { if (!acc[r.area_id]) acc[r.area_id] = { pl: 0, inc: 0, cir: 0 }; });
  Object.keys(acc).sort().forEach(function (area) {
    var a = acc[area];
    var den = t - a.pl;
    if (!(den > 0)) return;
    var b = Math.min(1, Math.max(0, (t - a.pl - (a.inc + a.cir)) / den));
    var pct = b * 100;
    if (!(pct < target)) return;
    out.push(notifCandidate_('availability_low', 'availability|' + area + '|' + month,
      'Availability below target: ' + area + ' ' + pct.toFixed(1) + '%',
      month + ': availability ' + pct.toFixed(1) + '% against a target of ' + String(target) + '% (basis B).',
      area, notifLineOf_(ctx, area, ''), ''));
  });
  return out;
}

/** planned_overrun (1.4.0): an area's planned hours in a complete month above the month's allowance (Actions.js plannedOverruns_). */
function notifRulePlanned_(ctx) {
  return plannedOverruns_(ctx, optionalTable_(T.AREA_TARGETS)).map(function (o) {
    var txt = plannedOverrunText_(o);
    return notifCandidate_('planned_overrun', 'planned|' + o.area + '|' + o.month, txt.title, txt.detail, o.area, o.line, '');
  });
}

/**
 * action_due (1.4.0): an action that is not closed or cancelled and whose due date is before today (plant date). 1.7.0: an
 * action with tasks uses the latest due date of its open tasks (due_date_derived) and is left out while it is a Draft.
 */
function notifRuleActionDue_(ctx, actions, byAction) {
  var out = [];
  actions.filter(function (a) { return !isTerminal_(a.status); })
    .sort(function (a, b) { return a.action_id < b.action_id ? -1 : 1; })
    .forEach(function (a) {
      var tasks = byAction[a.action_id] || [];
      if (tasks.length && a.status === 'Draft') return;
      var due = derivedDue_(a, tasks);
      if (!due || !isValidDate_(due) || !(due < ctx.today)) return;
      var days = Math.round((dateMs_(ctx.today) - dateMs_(due)) / MS_DAY_);
      out.push(notifCandidate_('action_due', 'action_due|' + a.action_id + '|' + due,
        'Action overdue: ' + a.action_id + ' - ' + oneLine_(a.title, 120),
        'Due ' + due + ', ' + days + ' day' + (days === 1 ? '' : 's') + ' ago. Status ' + a.status + ', owner ' + (a.owner || 'nobody yet') + '.',
        a.area_id, a.line_id, a.action_id));
    });
  return out;
}

/** All data-driven candidates, in a fixed order. */
function notifCandidates_(ctx) {
  var chains = notifBuildChains_(ctx.rows);
  var actions = optionalTable_(T.ACTIONS);
  var byAction = tasksByAction_(readAllTasks_());
  return [].concat(
    notifRuleLongStop_(ctx, chains), notifRuleRepeat_(ctx, chains), notifRuleSpike_(ctx, chains),
    notifRuleAvailability_(ctx), notifRulePlanned_(ctx), notifRuleGap_(ctx), notifRuleActionDue_(ctx, actions, byAction),
    notifRuleTaskOverdue_(ctx, actions, byAction), notifRuleReady_(actions, byAction) // 1.7.0 (Tasks.js)
  );
}

function uploadDoneCandidate_(batch) {
  var file = oneLine_(batch.file_name, 80) || 'workbook';
  return {
    type: 'upload_done', severity: 'update', dedupe_key: 'upload|' + batch.batch_id,
    title: 'Workbook uploaded: ' + file + ' (+' + batch.rows_added + ' rows)',
    detail: 'Read ' + batch.rows_read + ', added ' + batch.rows_added + ', identical ' + batch.rows_identical +
      ', skipped ' + batch.rows_skipped + ', warnings ' + batch.warning_count + '.',
    area_id: '', line_id: '', source_ref: batch.batch_id
  };
}

// ---------- storing, dedupe, expire, resolve ----------

function notifRowFrom_(c, st, nowMs) {
  return {
    notification_id: newId_('NT-', 16), type: c.type, severity: c.severity, dedupe_key: c.dedupe_key, title: c.title,
    detail: c.detail, area_id: c.area_id, line_id: c.line_id, source_ref: c.source_ref,
    created_at: fmtTsMs_(nowMs), expires_at: fmtTsMs_(nowMs + st.retentionDays * MS_DAY_), status: 'open', resolved_at: '',
    recipients: c.recipients || ''
  };
}

/**
 * Runs every rule, stores new alerts once (dedupe_key), expires old ones and resolves the ones whose condition
 * no longer holds. opts.batch (a completed upload batch row) also writes the upload_done update.
 * Returns { created, resolved, expired }. Callers need no lock; it takes the script lock itself.
 */
function runNotificationChecks_(opts) {
  opts = opts || {};
  return withLock_(function () {
    var st = notifSettings_();
    var nowMs = nowMs_();
    var stamp = fmtTsMs_(nowMs);
    var existing = readTable_(T.NOTIFICATIONS);
    var byKey = {};
    existing.forEach(function (r) { byKey[r.dedupe_key] = r; });
    var res = { created: 0, resolved: 0, expired: 0 };
    var patches = [], fresh = [];

    existing.forEach(function (r) {
      if (r.status === 'open' && r.expires_at && r.expires_at <= stamp) {
        patches.push({ row: r, patch: { status: 'expired' } });
        r.status = 'expired';
        res.expired++;
      }
    });

    var cands = opts.onlyBatch ? [] : notifCandidates_(notifLoadContext_(st));
    if (opts.batch) cands.push(uploadDoneCandidate_(opts.batch));
    var current = {};
    cands.forEach(function (c) {
      var resolvable = NOTIF_RESOLVABLE_.indexOf(c.type) >= 0;
      if (resolvable) current[c.dedupe_key] = true;
      var ex = byKey[c.dedupe_key];
      if (!ex) {
        var row = notifRowFrom_(c, st, nowMs);
        fresh.push(row);
        byKey[c.dedupe_key] = row;
        res.created++;
      } else if (ex.status === 'resolved' && resolvable) {
        patches.push({ row: ex, patch: { status: 'open', resolved_at: '', expires_at: fmtTsMs_(nowMs + st.retentionDays * MS_DAY_), recipients: c.recipients || '' } });
        ex.status = 'open';
        res.created++;
      } else if (ex.status === 'open' && ex._row && (ex.recipients || '') !== (c.recipients || '')) {
        // 1.7.0: a task's person or the action owner changed: the alert follows them
        patches.push({ row: ex, patch: { recipients: c.recipients || '' } });
        ex.recipients = c.recipients || '';
      }
    });

    existing.forEach(function (r) {
      if (!opts.onlyBatch && r.status === 'open' && NOTIF_RESOLVABLE_.indexOf(r.type) >= 0 && !current[r.dedupe_key]) {
        patches.push({ row: r, patch: { status: 'resolved', resolved_at: stamp } });
        r.status = 'resolved';
        res.resolved++;
      }
    });

    appendRows_(T.NOTIFICATIONS, fresh);
    patches.forEach(function (p) { updateRow_(T.NOTIFICATIONS, p.row._row, p.patch); });
    return res;
  });
}

function runNotificationChecksAction_(session) {
  var res = runNotificationChecks_({});
  actionChecksSafely_('notification check');
  withLock_(function () {
    auditLog_(session.user.user_id, 'notification_check', T.NOTIFICATIONS, '',
      'Created ' + res.created + ', resolved ' + res.resolved + ', expired ' + res.expired);
  });
  return res;
}

/** Best effort after an upload: never throws, so an upload cannot fail because of notifications. */
function notifyAfterUpload_(batch) {
  // 1.10.0: the checks run in the background a moment later (a one-off trigger), so the upload answers at once;
  // without triggers (or when one cannot be made) they run here as before
  if (scheduleAfterUploadChecks_(batch.batch_id)) return;
  runAfterUploadChecks_([batch]);
}

function runAfterUploadChecks_(batches) {
  batches.forEach(function (batch, i) {
    try {
      // every rule runs once; each finished upload still gets its own 'upload done' update
      runNotificationChecks_(i === batches.length - 1 ? { batch: batch } : { batch: batch, onlyBatch: true });
    } catch (err) {
      notifLogFailure_('upload', err);
    }
  });
  actionChecksSafely_('upload'); // after the alerts, so a new long stop already has its notification
}

var AFTER_UPLOAD_JOB_ = 'afterUploadJob';
var PENDING_UPLOADS_PROP_ = 'PENDING_UPLOAD_CHECKS';

/** Queues the batch for the background checks and makes sure one one-off trigger is waiting. False = run inline. */
function scheduleAfterUploadChecks_(batchId) {
  try {
    if (typeof ScriptApp === 'undefined' || !ScriptApp.newTrigger) return false;
    var props = PropertiesService.getScriptProperties();
    var pending = JSON.parse(props.getProperty(PENDING_UPLOADS_PROP_) || '[]');
    if (pending.indexOf(batchId) < 0) pending.push(batchId);
    props.setProperty(PENDING_UPLOADS_PROP_, JSON.stringify(pending));
    var waiting = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === AFTER_UPLOAD_JOB_; });
    if (!waiting) ScriptApp.newTrigger(AFTER_UPLOAD_JOB_).timeBased().after(5 * 1000).create();
    return true;
  } catch (err) {
    notifLogFailure_('upload (schedule)', err);
    return false;
  }
}

/** Best effort 'user created / password reset / role changed' update, visible to people with access to Users. */
function notifyUserEvent_(kind, actor, target, extra) {
  try {
    if (!target) return;
    var st = notifSettings_();
    var who = target.display_name || target.email;
    var by = (actor && (actor.display_name || actor.email)) || 'An administrator';
    var title, detail;
    if (kind === 'created') {
      title = 'User created: ' + who;
      detail = by + ' created the account for ' + target.email + ' (role ' + target.role_id + ').';
    } else if (kind === 'password_reset') {
      title = 'Password reset: ' + who;
      detail = by + ' reset the password of ' + target.email + '; a temporary password was issued.';
    } else {
      title = 'Role changed: ' + who;
      detail = by + ' changed the role of ' + target.email + ' ' + extra + '.';
    }
    withLock_(function () {
      var nowMs = nowMs_();
      appendRow_(T.NOTIFICATIONS, notifRowFrom_({
        type: 'user_event', severity: 'update', dedupe_key: 'user|' + kind + '|' + target.user_id + '|' + nowMs,
        title: oneLine_(title, 200), detail: oneLine_(detail, 500), area_id: '', line_id: '', source_ref: target.user_id
      }, st, nowMs));
    });
  } catch (err) {
    notifLogFailure_('user event', err);
  }
}

function notifLogFailure_(what, err) {
  var msg = err && err.message ? err.message : String(err);
  try { console.error('Notification step failed (' + what + '): ' + msg); } catch (e) { /* ignore */ }
  try {
    withLock_(function () { auditLog_('system', 'notification_failed', T.NOTIFICATIONS, '', what + ': ' + msg); });
  } catch (e2) { /* the audit is best effort too */ }
}

// ---------- reads and per-user writes ----------

/**
 * 1.5.0: an alert about an area that is switched off is not shown (overdue actions are: the action itself stays visible).
 * It comes back when the area is switched on again and the alert has not expired.
 */
function notifOfInactiveArea_(n, inactive) {
  return !!n.area_id && !!inactive[n.area_id] && NOTIF_CATEGORY_[n.type] !== 'Actions';
}

/** 1.7.0: who a person is for the recipients column: their user id and whether they may close actions. */
function notifWho_(user, ast) {
  return { user_id: user.user_id, closer: isCloser_({ user: user }, ast || actionSettings_()) };
}

/** 1.7.0: blank recipients = everyone; else one of the user ids, or @closers for the closers and Admins. */
function notifForUser_(n, who) {
  var list = csv_(n.recipients);
  if (!list.length || !who) return !list.length;
  return list.some(function (r) { return r === '@closers' ? who.closer : r === who.user_id; });
}

function notifVisible_(n, access, stamp, who) {
  if (n.status !== 'open') return false;
  if (n.expires_at && n.expires_at <= stamp) return false;
  if (n.type === 'user_event' && access.users === 'Hidden') return false; // only people who can see the Users page
  return notifForUser_(n, who);
}

function prefsOf_(userId) {
  var out = {};
  readTable_(T.NOTIFICATION_PREFS, function (row, idx) { return row[idx.user_id] === userId; }).forEach(function (r) { out[r.key] = r.value; });
  return out;
}

/** The theme saved with the account ('' when none or not readable): sent at sign-in and with getMyAccess (1.5.0). */
function accountTheme_(userId) {
  try {
    var row = readTable_(T.NOTIFICATION_PREFS, function (r, idx) { return r[idx.user_id] === userId && r[idx.key] === 'theme'; })[0];
    var v = row ? String(row.value || '').trim() : '';
    return ACCOUNT_THEMES_.indexOf(v) >= 0 ? v : '';
  } catch (err) {
    return ''; // a missing sheet must never block a sign-in
  }
}

function getNotifications_(session) {
  var uid = session.user.user_id, stamp = nowTs_();
  var inactive = inactiveAreaIds_();
  var who = notifWho_(session.user);
  var items = readTable_(T.NOTIFICATIONS).filter(function (n) { return notifVisible_(n, session.access, stamp, who) && !notifOfInactiveArea_(n, inactive); })
    .sort(function (a, b) {
      return a.created_at < b.created_at ? 1 : a.created_at > b.created_at ? -1 : (a.notification_id < b.notification_id ? -1 : 1);
    });
  var ids = {};
  items.forEach(function (n) { ids[n.notification_id] = true; });
  var state = readTable_(T.NOTIFICATION_STATE, function (row, idx) { return row[idx.user_id] === uid; })
    .filter(function (s) { return ids[s.notification_id]; });
  items.forEach(function (n) { n.category = NOTIF_CATEGORY_[n.type] || 'System'; });
  return { items: items, state: state, prefs: prefsOf_(uid) };
}

function setNotificationState_(session, notificationId, state, snoozeUntil) {
  var id = cleanText_(notificationId, 'Notification', true, 60);
  if (notifEnum_(T.NOTIFICATION_STATE, 'state').indexOf(state) < 0) throw apiError_(ERR.BAD_REQUEST, 'State must be seen, snoozed or dismissed.');
  var until = '';
  if (state === 'snoozed') {
    if (typeof snoozeUntil !== 'string' || !snoozeUntil.trim()) throw apiError_(ERR.BAD_REQUEST, 'Choose how long to snooze.');
    var raw = snoozeUntil.trim();
    until = normTs_(isValidDate_(raw) ? raw + ' 00:00:00.000' : raw);
    if (until === null) throw apiError_(ERR.BAD_REQUEST, 'The snooze time is not valid.');
    var nowMs = nowMs_();
    if (until <= fmtTsMs_(nowMs)) throw apiError_(ERR.BAD_REQUEST, 'The snooze time must be in the future.');
    if (until > fmtTsMs_(nowMs + NOTIF_SNOOZE_MAX_DAYS_ * MS_DAY_)) throw apiError_(ERR.BAD_REQUEST, 'The snooze time is too far ahead.');
  }
  var uid = session.user.user_id;
  return withLock_(function () {
    var n = findBy_(T.NOTIFICATIONS, 'notification_id', id);
    if (!n || !notifVisible_(n, session.access, nowTs_(), notifWho_(session.user))) throw apiError_(ERR.NOT_FOUND, 'Notification not found.');
    var rec = { user_id: uid, notification_id: id, state: state, snooze_until: until, updated_at: nowTs_() };
    var mine = readTable_(T.NOTIFICATION_STATE, function (row, idx) { return row[idx.user_id] === uid && row[idx.notification_id] === id; })[0];
    if (mine) updateRow_(T.NOTIFICATION_STATE, mine._row, rec); else appendRow_(T.NOTIFICATION_STATE, rec);
    return rec;
  });
}

/** Saved views: JSON text, at most 20 of {id, name, page, query}. Returned as given (trimmed); blank clears them. */
function cleanSavedViews_(text) {
  if (text === '') return '';
  if (text.length > SAVED_VIEWS_TEXT_MAX_) throw apiError_(ERR.BAD_REQUEST, 'Saved views are too long.');
  var list;
  try { list = JSON.parse(text); } catch (e) { throw apiError_(ERR.BAD_REQUEST, 'Saved views are not readable.'); }
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Saved views must be a list.');
  if (list.length > SAVED_VIEWS_MAX_) throw apiError_(ERR.BAD_REQUEST, 'You can save at most ' + SAVED_VIEWS_MAX_ + ' views.');
  var seen = {};
  list.forEach(function (v) {
    if (!v || typeof v !== 'object' || Array.isArray(v)) throw apiError_(ERR.BAD_REQUEST, 'Each saved view must be an object.');
    Object.keys(v).forEach(function (k) {
      if (['id', 'name', 'page', 'query'].indexOf(k) < 0) throw apiError_(ERR.BAD_REQUEST, 'A saved view has an unknown field: ' + oneLine_(k, 40) + '.');
    });
    if (typeof v.id !== 'string' || !v.id || v.id.length > 40) throw apiError_(ERR.BAD_REQUEST, 'A saved view needs an id of 1 to 40 characters.');
    if (typeof v.name !== 'string' || !v.name.trim() || v.name.length > 60) throw apiError_(ERR.BAD_REQUEST, 'A saved view needs a name of 1 to 60 characters.');
    if (SAVED_VIEW_PAGES_.indexOf(v.page) < 0) throw apiError_(ERR.BAD_REQUEST, 'A saved view page must be one of: ' + SAVED_VIEW_PAGES_.join(', ') + '.');
    if (typeof v.query !== 'string' || v.query.length > 1500) throw apiError_(ERR.BAD_REQUEST, 'A saved view query must be text of at most 1500 characters.');
    if (seen[v.id]) throw apiError_(ERR.BAD_REQUEST, 'Two saved views have the same id.');
    seen[v.id] = true;
  });
  return text;
}

/** One list of short strings (lines, areas, equipment ...): at most 100, each 1 to 60 characters, no repeats. */
function cleanReportList_(list, label, allowed) {
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Report ' + label + ' must be a list.');
  if (list.length > REPORT_LIST_MAX_) throw apiError_(ERR.BAD_REQUEST, 'Report ' + label + ' has too many entries.');
  var seen = {};
  list.forEach(function (x) {
    if (typeof x !== 'string' || !x || x.length > 60) throw apiError_(ERR.BAD_REQUEST, 'Report ' + label + ' must be text of 1 to 60 characters.');
    if (allowed && allowed.indexOf(x) < 0) throw apiError_(ERR.BAD_REQUEST, 'Report ' + label + ' has an unknown value: ' + oneLine_(x, 40) + '.');
    if (seen[x]) throw apiError_(ERR.BAD_REQUEST, 'Report ' + label + ' repeats a value.');
    seen[x] = true;
  });
}

function onlyKeys_(obj, keys, what) {
  Object.keys(obj).forEach(function (k) {
    if (keys.indexOf(k) < 0) throw apiError_(ERR.BAD_REQUEST, what + ' has an unknown field: ' + oneLine_(k, 40) + '.');
  });
}

function plainObject_(v) { return !!v && typeof v === 'object' && !Array.isArray(v); }

/** Saved report templates: JSON text, at most 20 of {id, name, template, period, filters, sections, options}. Returned as given; blank clears them. */
function cleanSavedReports_(text) {
  if (text === '') return '';
  if (text.length > SAVED_REPORTS_TEXT_MAX_) throw apiError_(ERR.BAD_REQUEST, 'Saved reports are too long.');
  var list;
  try { list = JSON.parse(text); } catch (e) { throw apiError_(ERR.BAD_REQUEST, 'Saved reports are not readable.'); }
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Saved reports must be a list.');
  if (list.length > SAVED_REPORTS_MAX_) throw apiError_(ERR.BAD_REQUEST, 'You can save at most ' + SAVED_REPORTS_MAX_ + ' report templates.');
  var seen = {};
  list.forEach(function (v) {
    if (!plainObject_(v)) throw apiError_(ERR.BAD_REQUEST, 'Each saved report must be an object.');
    onlyKeys_(v, ['id', 'name', 'template', 'period', 'filters', 'sections', 'options'], 'A saved report');
    if (typeof v.id !== 'string' || !v.id || v.id.length > 40) throw apiError_(ERR.BAD_REQUEST, 'A saved report needs an id of 1 to 40 characters.');
    if (typeof v.name !== 'string' || !v.name.trim() || v.name.length > 60) throw apiError_(ERR.BAD_REQUEST, 'A saved report needs a name of 1 to 60 characters.');
    if (REPORT_TEMPLATES_.indexOf(v.template) < 0) throw apiError_(ERR.BAD_REQUEST, 'A saved report template must be one of: ' + REPORT_TEMPLATES_.join(', ') + '.');
    // period
    var p = v.period;
    if (!plainObject_(p)) throw apiError_(ERR.BAD_REQUEST, 'A saved report needs a period.');
    onlyKeys_(p, ['preset', 'from', 'to', 'compare'], 'A saved report period');
    if (REPORT_PRESETS_.indexOf(p.preset) < 0) throw apiError_(ERR.BAD_REQUEST, 'A saved report period preset must be one of: ' + REPORT_PRESETS_.join(', ') + '.');
    ['from', 'to'].forEach(function (k) {
      if (typeof p[k] !== 'string' || (p[k] !== '' && !isValidDate_(p[k]))) throw apiError_(ERR.BAD_REQUEST, 'A saved report period ' + k + ' must be a date like 2026-03-05 or blank.');
    });
    if (p.from && p.to && p.from > p.to) throw apiError_(ERR.BAD_REQUEST, 'A saved report period must not end before it starts.');
    if (typeof p.compare !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'A saved report period compare must be true or false.');
    // filters
    var f = v.filters;
    if (!plainObject_(f)) throw apiError_(ERR.BAD_REQUEST, 'A saved report needs filters.');
    onlyKeys_(f, REPORT_FILTER_LISTS_.concat(['failuresOnly']), 'A saved report filter set');
    cleanReportList_(f.lines, 'lines');
    cleanReportList_(f.areas, 'areas');
    cleanReportList_(f.equipment, 'equipment');
    cleanReportList_(f.classifications, 'classifications', REPORT_CLASSES_);
    cleanReportList_(f.criticality, 'criticality', ['INC', 'NO_INC']);
    if (typeof f.failuresOnly !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'A saved report failuresOnly must be true or false.');
    // sections
    cleanReportList_(v.sections, 'sections', REPORT_SECTION_IDS_);
    // options: per section {top: 1..1000 or 'all', measure: 'hours' | 'count'}
    var o = v.options;
    if (!plainObject_(o)) throw apiError_(ERR.BAD_REQUEST, 'A saved report needs options.');
    Object.keys(o).forEach(function (sid) {
      if (REPORT_SECTION_IDS_.indexOf(sid) < 0) throw apiError_(ERR.BAD_REQUEST, 'A saved report has options for an unknown section: ' + oneLine_(sid, 40) + '.');
      var so = o[sid];
      if (!plainObject_(so)) throw apiError_(ERR.BAD_REQUEST, 'Report options of a section must be an object.');
      onlyKeys_(so, ['top', 'measure'], 'Report options');
      if (so.top !== undefined && so.top !== 'all' && !(typeof so.top === 'number' && so.top % 1 === 0 && so.top >= 1 && so.top <= 1000)) throw apiError_(ERR.BAD_REQUEST, 'Report option top must be a whole number from 1 to 1000 or "all".');
      if (so.measure !== undefined && so.measure !== 'hours' && so.measure !== 'count') throw apiError_(ERR.BAD_REQUEST, 'Report option measure must be hours or count.');
    });
    if (seen[v.id]) throw apiError_(ERR.BAD_REQUEST, 'Two saved reports have the same id.');
    seen[v.id] = true;
  });
  return text;
}

function cleanNotifPref_(key, value) {
  if (typeof value !== 'string') throw apiError_(ERR.BAD_REQUEST, 'Preference ' + key + ' must be text.');
  var v = value.trim();
  if (key === 'digest') {
    if (NOTIF_DIGEST_MODES_.indexOf(v) < 0) throw apiError_(ERR.BAD_REQUEST, 'Digest must be none, daily or weekly.');
    return v;
  }
  if (key === 'alert_types') {
    var types = notifEnum_(T.NOTIFICATIONS, 'type'), picked = [];
    csv_(v).forEach(function (t) {
      if (types.indexOf(t) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown alert type: ' + oneLine_(t, 40) + '.');
      if (picked.indexOf(t) < 0) picked.push(t);
    });
    return picked.join(',');
  }
  if (key === 'watch_areas') {
    var lower = {};
    readTable_(T.AREAS).forEach(function (a) { lower[a.area_id.toLowerCase()] = a.area_id; });
    var chosen = [];
    csv_(v).forEach(function (a) {
      var real = lower[a.toLowerCase()];
      if (!real) throw apiError_(ERR.BAD_REQUEST, 'Area "' + oneLine_(a, 40) + '" is not in the list of areas.');
      if (chosen.indexOf(real) < 0) chosen.push(real);
    });
    return chosen.join(',');
  }
  if (key === 'theme') {
    if (v !== '' && ACCOUNT_THEMES_.indexOf(v) < 0) throw apiError_(ERR.BAD_REQUEST, 'Theme must be one of: ' + ACCOUNT_THEMES_.join(', ') + '.');
    return v;
  }
  if (key === 'saved_views') return cleanSavedViews_(v);
  if (key === 'saved_reports') return cleanSavedReports_(v);
  var ts = normTs_(v);
  if (ts === null) throw apiError_(ERR.BAD_REQUEST, 'Last seen must be a time like 2026-03-05 10:00:00.000.');
  return ts;
}

function saveNotificationPrefs_(session, prefs) {
  requireObject_(prefs, 'Preferences');
  var keys = Object.keys(prefs);
  if (!keys.length) throw apiError_(ERR.BAD_REQUEST, 'No changes to save.');
  var clean = {};
  keys.forEach(function (k) {
    if (NOTIF_PREF_KEYS_.indexOf(k) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown preference: ' + oneLine_(k, 40) + '.');
    clean[k] = cleanNotifPref_(k, prefs[k]);
  });
  var uid = session.user.user_id;
  return withLock_(function () {
    var mine = readTable_(T.NOTIFICATION_PREFS, function (row, idx) { return row[idx.user_id] === uid; });
    var stamp = nowTs_();
    Object.keys(clean).forEach(function (k) {
      var row = mine.filter(function (r) { return r.key === k; })[0];
      var rec = { user_id: uid, key: k, value: clean[k], updated_at: stamp };
      if (row) updateRow_(T.NOTIFICATION_PREFS, row._row, rec); else appendRow_(T.NOTIFICATION_PREFS, rec);
    });
    return prefsOf_(uid);
  });
}

function setServerPref_(userId, key, value) {
  withLock_(function () {
    var row = readTable_(T.NOTIFICATION_PREFS, function (r, idx) { return r[idx.user_id] === userId && r[idx.key] === key; })[0];
    var rec = { user_id: userId, key: key, value: value, updated_at: nowTs_() };
    if (row) updateRow_(T.NOTIFICATION_PREFS, row._row, rec); else appendRow_(T.NOTIFICATION_PREFS, rec);
  });
}

// ---------- digest ----------

function htmlEscape_(s) {
  return String(s === null || s === undefined ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

/** Everything the digests need, read once. */
function digestContext_() {
  var st = notifSettings_();
  var stamp = nowTs_();
  var inactive = inactiveAreaIds_();
  var events = readTable_(T.EVENTS, function (row, idx) { return !toBool_(row[idx.is_void]) && !inactive[row[idx.area_id]]; });
  var validate = 0, blocked = 0, codes = 0;
  events.forEach(function (e) {
    if (!hasOpenProblem_(e)) return; // a record whose only problems are kept as entered is not counted
    if (e.origin === 'history') return; // 2.2.0: imported history is reference data, not a record to validate
    validate++;
    var f = openFlags_(e);
    if (f.some(function (x) { return NOTIF_BLOCKING_FLAGS_.indexOf(x) >= 0; })) blocked++;
    if (f.indexOf('unknown_code') >= 0 || f.indexOf('placeholder') >= 0) codes++;
  });
  var prefsBy = {};
  readTable_(T.NOTIFICATION_PREFS).forEach(function (r) { (prefsBy[r.user_id] = prefsBy[r.user_id] || {})[r.key] = r.value; });
  var stateBy = {};
  readTable_(T.NOTIFICATION_STATE).forEach(function (r) { (stateBy[r.user_id] = stateBy[r.user_id] || {})[r.notification_id] = r.state; });
  return {
    st: st, stamp: stamp, today: stamp.slice(0, 10),
    users: readUsers_(), accessRows: readTable_(T.TAB_ACCESS), prefsBy: prefsBy, stateBy: stateBy, ast: actionSettings_(),
    alerts: readTable_(T.NOTIFICATIONS).filter(function (n) {
      return n.severity === 'alert' && n.status === 'open' && !(n.expires_at && n.expires_at <= stamp) && !notifOfInactiveArea_(n, inactive);
    }),
    counts: { validate: validate, blocked: blocked, codes: codes },
    needsReview: readTable_(T.EQUIPMENT).filter(function (e) { return e.needs_review; }).length
  };
}

function digestRank_(type) {
  var i = NOTIF_SEVERITY_ORDER_.indexOf(type);
  return i < 0 ? NOTIF_SEVERITY_ORDER_.length : i;
}

/**
 * The digest for one user, or null when there is nothing to say. Counts only (never event rows):
 * open action items the server can know for this person, and new alerts since the last digest
 * (at most 10, most severe first) that match the person's alert types and watched areas.
 */
function buildDigest_(user, dctx) {
  var prefs = dctx.prefsBy[user.user_id] || {};
  var mode = prefs.digest === 'daily' || prefs.digest === 'weekly' ? prefs.digest : 'none';
  var access = computeAccess_(user, dctx.accessRows);
  var actions = [];
  if (access.events === 'Edit') {
    if (dctx.counts.validate > 0) {
      actions.push(dctx.counts.validate + (dctx.counts.validate === 1 ? ' record' : ' records') + ' to validate' +
        (dctx.counts.blocked > 0 ? ' (' + dctx.counts.blocked + ' left out of the numbers)' : ''));
    }
  }
  if (access.master === 'Edit') {
    if (dctx.counts.codes > 0) actions.push(dctx.counts.codes + (dctx.counts.codes === 1 ? ' record' : ' records') + ' with an unknown or placeholder code');
    if (dctx.needsReview > 0) actions.push(dctx.needsReview + ' equipment ' + (dctx.needsReview === 1 ? 'item' : 'items') + ' to review');
  }
  var types = csv_(prefs.alert_types), watch = csv_(prefs.watch_areas);
  var since = prefs.last_digest_at || '';
  var dismissed = dctx.stateBy[user.user_id] || {};
  var who = notifWho_(user, dctx.ast);
  var alerts = dctx.alerts.filter(function (n) {
    if (!notifForUser_(n, who)) return false; // 1.7.0: alerts for some people only (recipients)
    if (since && n.created_at <= since) return false;
    if (types.length && types.indexOf(n.type) < 0) return false;
    if (watch.length && n.area_id && watch.indexOf(n.area_id) < 0) return false;
    return dismissed[n.notification_id] !== 'dismissed';
  }).sort(function (a, b) {
    return (digestRank_(a.type) - digestRank_(b.type)) || (a.created_at < b.created_at ? 1 : a.created_at > b.created_at ? -1 : 0) ||
      (a.notification_id < b.notification_id ? -1 : 1);
  });
  if (!actions.length && !alerts.length) return null;
  var shown = alerts.slice(0, NOTIF_DIGEST_MAX_);
  var more = alerts.length - shown.length;
  var link = dctx.st.appUrl;
  var heading = 'ACC Downtime ' + (mode === 'weekly' ? 'weekly' : 'daily') + ' digest';
  var text = [heading, dctx.today, ''];
  var html = ['<h2 style="margin:0 0 4px">' + htmlEscape_(heading) + '</h2>', '<p style="margin:0 0 12px;color:#555">' + htmlEscape_(dctx.today) + '</p>'];
  if (actions.length) {
    text.push('Needs action'); actions.forEach(function (a) { text.push('- ' + a); }); text.push('');
    html.push('<h3 style="margin:12px 0 4px">Needs action</h3><ul>' + actions.map(function (a) { return '<li>' + htmlEscape_(a) + '</li>'; }).join('') + '</ul>');
  }
  if (alerts.length) {
    var h = 'New alerts (' + alerts.length + ')';
    text.push(h);
    shown.forEach(function (n) { text.push('- ' + n.title + (n.area_id ? ' [' + n.area_id + ']' : '')); });
    if (more > 0) text.push('and ' + more + ' more - open the app to see them all');
    text.push('');
    html.push('<h3 style="margin:12px 0 4px">' + htmlEscape_(h) + '</h3><ul>' + shown.map(function (n) {
      return '<li>' + htmlEscape_(n.title) + (n.area_id ? ' <span style="color:#555">[' + htmlEscape_(n.area_id) + ']</span>' : '') + '</li>';
    }).join('') + '</ul>' + (more > 0 ? '<p>and ' + more + ' more - open the app to see them all</p>' : ''));
  }
  if (link) {
    text.push('Open the app: ' + link, '');
    html.push('<p><a href="' + htmlEscape_(link) + '">Open the app</a></p>');
  }
  text.push('You get this email because you chose it in Settings > Notifications. Choose "none" there to stop it.');
  html.push('<p style="color:#555;font-size:12px">You get this email because you chose it in Settings &gt; Notifications. Choose "none" there to stop it.</p>');
  return {
    subject: heading + ' - ' + alerts.length + ' new ' + (alerts.length === 1 ? 'alert' : 'alerts') + ', ' + actions.length + ' ' + (actions.length === 1 ? 'item needs' : 'items need') + ' action',
    text: text.join('\n'), html: html.join('\n'), alertCount: alerts.length, shown: shown.length, actionLines: actions.length, mode: mode
  };
}

function digestAudit_(action, userId, detail) {
  try { withLock_(function () { auditLog_(userId || 'system', action, T.NOTIFICATIONS, '', detail); }); } catch (e) { /* best effort */ }
}

/**
 * Sends the digests that are due today: daily for people who chose daily, weekly (Sunday, plant time) for people
 * who chose weekly; only active users with an email who did not already get one today. Never throws: mail quota
 * or permission errors are written to the audit log. Returns { sent, skipped, failed }.
 */
function sendDigest_() {
  var out = { sent: 0, skipped: 0, failed: 0 };
  var dctx = digestContext_();
  var sunday = new Date(dateMs_(dctx.today)).getUTCDay() === 0;
  var stop = false;
  dctx.users.forEach(function (user) {
    if (stop) return;
    var prefs = dctx.prefsBy[user.user_id] || {};
    var mode = prefs.digest;
    if (!user.active || !user.email || (mode !== 'daily' && mode !== 'weekly')) return;
    if ((mode === 'weekly' && !sunday) || String(prefs.last_digest_at || '').slice(0, 10) === dctx.today) { out.skipped++; return; }
    var d = buildDigest_(user, dctx);
    if (!d) { out.skipped++; return; }
    try {
      if (typeof MailApp === 'undefined' && !mailSender_().email) throw new Error('Mail is not available (MailApp).');
      var left = remainingQuota_();
      if (left !== null && left < 1) {
        digestAudit_('digest_failed', user.user_id, 'Daily mail quota used up; no more digests today');
        out.failed++;
        stop = true;
        return;
      }
      // 1.9.0: through the one mail helper (Mail.js): the system email when it is set, else MailApp
      sendMail_({ to: [user.email], cc: [], subject: d.subject, text: d.text, html: d.html, attachments: [] });
    } catch (err) {
      out.failed++;
      digestAudit_('digest_failed', user.user_id, oneLine_(err && err.message ? err.message : err, 300));
      return;
    }
    out.sent++;
    try {
      setServerPref_(user.user_id, 'last_digest_at', nowTs_());
      digestAudit_('digest_sent', user.user_id, d.mode + ' digest: ' + d.alertCount + ' alerts, ' + d.actionLines + ' action lines');
    } catch (e) { /* the mail went out; the next run may repeat it only if the pref could not be saved */ }
  });
  return out;
}

// ======================================================================
// Responsibilities.js
// ======================================================================
/**
 * Responsibilities (schema v7, plant system): who holds which duty, for which part of the plant.
 * A duty is held for the whole plant, one line or one area, as the main person or as a backup, optionally between
 * two dates. month_review and month_signoff also name the section (downtime, production, quality, plant).
 * Saving replaces the complete set of one user (like setUserTabAccess); every change is in the audit log.
 */

var DUTIES = ['shift_entry', 'production_review', 'reliability_validation', 'production_data', 'quality_validation',
  'month_review', 'month_signoff', 'targets', 'master_data', 'daily_meeting'];
var DUTY_SECTIONS = ['downtime', 'production', 'quality', 'plant'];
var SECTION_DUTIES = ['month_review', 'month_signoff'];
var SCOPE_TYPES = ['plant', 'line', 'area'];
var RESP_MAX_PER_USER = 200;

function respOut_(r) {
  return {
    resp_id: r.resp_id, user_id: r.user_id, duty: r.duty, section: r.section || '', scope_type: r.scope_type,
    scope_id: r.scope_id || '', is_backup: toBool_(r.is_backup), valid_from: r.valid_from || '', valid_to: r.valid_to || '',
    updated_by: r.updated_by || r.created_by || '', updated_at: r.updated_at || r.created_at || ''
  };
}

function listResponsibilities_() {
  return readTable_(T.RESPONSIBILITIES).filter(function (r) { return toBool_(r.active); }).map(respOut_);
}

/** The caller's own duties (2.1.0): the Shift reports and Daily meeting pages offer the areas the person works on. */
function listMyResponsibilities_(session) {
  return listResponsibilities_().filter(function (r) { return r.user_id === session.user.user_id; });
}

/** One row as the client sends it -> the cleaned row, or a plain-English error. */
function cleanResponsibility_(row, lines, areas) {
  requireObject_(row, 'A responsibility');
  var duty = String(row.duty || '');
  if (DUTIES.indexOf(duty) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown duty: ' + duty.slice(0, 40) + '.');
  var section = String(row.section || '');
  if (SECTION_DUTIES.indexOf(duty) >= 0) {
    if (DUTY_SECTIONS.indexOf(section) < 0) throw apiError_(ERR.BAD_REQUEST, 'Choose the section (downtime, production, quality or plant) for ' + duty + '.');
  } else if (section) {
    throw apiError_(ERR.BAD_REQUEST, 'Only month review and month sign-off have a section.');
  }
  var scopeType = String(row.scope_type || '');
  if (SCOPE_TYPES.indexOf(scopeType) < 0) throw apiError_(ERR.BAD_REQUEST, 'Scope must be plant, line or area.');
  var scopeId = String(row.scope_id || '').trim();
  if (scopeType === 'plant') scopeId = '';
  else if (scopeType === 'line' && !lines[scopeId]) throw apiError_(ERR.BAD_REQUEST, 'There is no line ' + scopeId.slice(0, 40) + '.');
  else if (scopeType === 'area' && !areas[scopeId]) throw apiError_(ERR.BAD_REQUEST, 'There is no area ' + scopeId.slice(0, 40) + '.');
  var from = String(row.valid_from || '');
  var to = String(row.valid_to || '');
  if (from && !isValidDate_(from)) throw apiError_(ERR.BAD_REQUEST, 'Valid from must be a date like 2026-10-01.');
  if (to && !isValidDate_(to)) throw apiError_(ERR.BAD_REQUEST, 'Valid to must be a date like 2026-10-31.');
  if (from && to && to < from) throw apiError_(ERR.BAD_REQUEST, 'Valid to is before valid from.');
  return { duty: duty, section: section, scope_type: scopeType, scope_id: scopeId, is_backup: row.is_backup === true, valid_from: from, valid_to: to };
}

function respKey_(r) { return [r.duty, r.section || '', r.scope_type, r.scope_id || '', toBool_(r.is_backup) ? 'backup' : 'main'].join('|'); }

function respLabel_(r) {
  return r.duty + (r.section ? ' (' + r.section + ')' : '') + ' @ ' + (r.scope_type === 'plant' ? 'plant' : r.scope_id) +
    (toBool_(r.is_backup) ? ' backup' : '') + (r.valid_from || r.valid_to ? ' ' + (r.valid_from || '...') + '..' + (r.valid_to || '...') : '');
}

/** `rows` is the complete set of responsibilities of the user; rows left out are removed. Returns that user's set. */
function saveResponsibilities_(session, userId, rows) {
  if (!Array.isArray(rows)) throw apiError_(ERR.BAD_REQUEST, 'Responsibilities must be a list.');
  if (rows.length > RESP_MAX_PER_USER) throw apiError_(ERR.BAD_REQUEST, 'At most ' + RESP_MAX_PER_USER + ' responsibilities per person.');
  var lines = {}, areas = {};
  readTable_(T.LINES).forEach(function (l) { lines[l.line_id] = true; });
  readTable_(T.AREAS).forEach(function (a) { areas[a.area_id] = true; });
  var clean = rows.map(function (r) { return cleanResponsibility_(r, lines, areas); });
  var seen = {};
  clean.forEach(function (r) {
    var k = respKey_(r);
    if (seen[k]) throw apiError_(ERR.BAD_REQUEST, 'The same responsibility is listed twice: ' + respLabel_(r) + '.');
    seen[k] = true;
  });
  withLock_(function () {
    var u = userOrThrow_(userId);
    requireAdminFor_(session, u.role_id === 'ROLE-ADMIN', 'change the responsibilities of an Admin');
    var existing = readTable_(T.RESPONSIBILITIES).filter(function (r) { return r.user_id === u.user_id && toBool_(r.active); });
    var before = {};
    existing.forEach(function (r) { before[respKey_(r) + '|' + (r.valid_from || '') + '|' + (r.valid_to || '')] = r; });
    var after = {};
    clean.forEach(function (r) { after[respKey_(r) + '|' + r.valid_from + '|' + r.valid_to] = r; });
    var now = nowTs_(), by = session.user.user_id;
    var removed = existing.filter(function (r) { return !after[respKey_(r) + '|' + (r.valid_from || '') + '|' + (r.valid_to || '')]; });
    var added = clean.filter(function (r) { return !before[respKey_(r) + '|' + r.valid_from + '|' + r.valid_to]; });
    // A removed row is switched off, not deleted, so who held a duty when stays answerable.
    removed.forEach(function (r) { updateRow_(T.RESPONSIBILITIES, r._row, { active: false, updated_by: by, updated_at: now }); });
    appendRows_(T.RESPONSIBILITIES, added.map(function (r) {
      return {
        resp_id: newId_('RS-', 10), user_id: u.user_id, duty: r.duty, section: r.section, scope_type: r.scope_type, scope_id: r.scope_id,
        is_backup: r.is_backup, valid_from: r.valid_from, valid_to: r.valid_to, active: true, created_by: by, created_at: now
      };
    }));
    auditLog_(by, 'set_responsibilities', T.USERS, u.user_id,
      added.map(function (r) { return '+ ' + respLabel_(r); }).concat(removed.map(function (r) { return '- ' + respLabel_(r); })).join('; ') || 'No change');
  });
  return listResponsibilities_().filter(function (r) { return r.user_id === userId; });
}

