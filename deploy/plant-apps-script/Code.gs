  setNotificationState: function (s, p) { return setNotificationState_(s, p.notificationId, p.state, p.snoozeUntil); },
  saveNotificationPrefs: function (s, p) { return saveNotificationPrefs_(s, p.prefs); },
  runNotificationChecks: function (s) { return runNotificationChecksAction_(s); },
  listActions: function (s) { return listActions_(s); },
  createAction: function (s, p) { return createAction_(s, p.input, p.options); },
  updateAction: function (s, p) { return updateAction_(s, p.actionId, p.changes); },
  addActionComment: function (s, p) { return addActionComment_(s, p.actionId, p.text); },
  saveContractors: function (s, p) { return saveContractors_(s, p.rows); },
  getAreaTargets: function (s, p) { return getAreaTargets_(p.year); },
  saveAreaTargets: function (s, p) { return saveAreaTargets_(s, p.year, p.rows); },
  runActionChecks: function (s) { return runActionChecksAction_(s); },
  // 1.7.0: tasks inside actions and task templates (Tasks.js)
  addTask: function (s, p) { return addTask_(s, p.actionId, p.task); },
  updateTask: function (s, p) { return updateTask_(s, p.taskId, p.changes); },
  applyTemplate: function (s, p) { return applyTemplate_(s, p.actionId, p.templateId); },
  listTasks: function (s, p) { return listTasks_(s, p.filter); },
  listTaskTemplates: function () { return listTaskTemplates_(); },
  saveTaskTemplates: function (s, p) { return saveTaskTemplates_(s, p.templates); },
  // 1.6.0: sign-out (audited), and the two Admin-only pages Settings > Active users and Settings > Activity log
  logout: function (s) { return logout_(s); },
  listActiveUsers: function () { return listActiveUsers_(); },
  listAuditLog: function (s, p) { return listAuditLog_(p.filter, p.cursor); },
  // 1.9.0: email (Mail.js)
  sendReport: function (s, p) { return sendReport_(s, p.email); },
  sendTestEmail: function (s) { return sendTestEmail_(s); },
  // 1.10.0
  signOutEverywhere: function (s) { return signOutEverywhere_(s); },
  signOutUserEverywhere: function (s, p) { return signOutUserEverywhere_(s, p.userId); },
  acceptEventFlagsBulk: function (s, p) { return acceptEventFlagsBulk_(s, p.items, p.note); }
};

/** Runs one request and returns the response envelope (an object, never throws). */
function handleRequest_(body) {
  try {
    if (!body || typeof body !== 'object' || typeof body.action !== 'string') {
      throw apiError_(ERR.BAD_REQUEST, 'The request could not be read.');
    }
    var action = body.action;
    var rule = Object.prototype.hasOwnProperty.call(ACTION_RULES, action) ? ACTION_RULES[action] : null;
    if (!rule || !HANDLERS[action]) throw apiError_(ERR.BAD_REQUEST, 'Unknown action.');
    var params = body.params === undefined || body.params === null ? {} : body.params;
    requireObject_(params, 'Parameters');
    var session = null;
    if (rule.auth !== 'none') {
      session = requireSession_(body.token);
      // 1.6.0: who is using the app. Throttled (a cache read per call, a sheet write every few minutes); never fails a call.
      noteActivity_(session.user.user_id, params.activity);
      if (session.user.must_change && !rule.mustChangeOk) {
        throw apiError_(ERR.FORBIDDEN, 'You must change your temporary password first.');
      }
      requireAccess_(action, session.access, session.user);
    }
    var data = HANDLERS[action](session, params);
    if (action === 'login' && data && data.user) noteActivity_(data.user.user_id, params.activity);
    return okEnvelope_(data);
  } catch (err) {
    if (err && err.isApiError) return errorEnvelope_(err.code, err.message);
    console.error('Unexpected error: ' + (err && err.stack ? err.stack : err));
    return errorEnvelope_(ERR.SERVER, 'Something went wrong on the server. Please try again.');
  }
}

