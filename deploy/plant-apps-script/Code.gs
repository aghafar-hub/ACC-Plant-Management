// Setup.js
// ======================================================================
/**
 * One-time and maintenance functions, run by hand from the Apps Script editor
 * (Run button). Nothing here is reachable from the web app.
 */

/** Creates missing sheets and columns. Never deletes or reorders anything. Safe to run again. */
function ensureSchema() {
  var ss = getSpreadsheet_();
  var report = [];
  SCHEMA.tableOrder.forEach(function (name) {
    var def = SCHEMA.tables[name];
    var sh = ss.getSheetByName(name);
    if (!sh) { sh = ss.insertSheet(name); report.push('Created sheet ' + name); }
    var headers = sheetHeaders_(sh);
    var missing = def.columns.map(function (c) { return c.name; }).filter(function (n) { return headers.indexOf(n) < 0; });
    if (missing.length) {
      var start = headers.length + 1;
      var over = start + missing.length - 1 - sh.getMaxColumns();
      if (over > 0) sh.insertColumnsAfter(sh.getMaxColumns(), over);
      sh.getRange(1, start, 1, missing.length).setValues([missing]);
      headers = headers.concat(missing);
      if (headers.length > missing.length) report.push('Added columns to ' + name + ': ' + missing.join(', '));
    }
    applyColumnFormats_(sh, name, headers);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  });
  report.push('Schema is up to date (' + SCHEMA.tableOrder.length + ' sheets).');
  Logger.log(report.join('\n'));
  return report;
}

/** Plain Text format on text, date, timestamp and enum columns so Sheets never converts them. */
function applyColumnFormats_(sheet, table, headers) {
  var types = columnTypes_(table);
  var rows = sheet.getMaxRows();
  var i = 0;
  while (i < headers.length) {
    if (!isTextual_(types[headers[i]] || 'text')) { i++; continue; }
    var j = i;
    while (j + 1 < headers.length && isTextual_(types[headers[j + 1]] || 'text')) j++;
    sheet.getRange(1, i + 1, rows, j - i + 1).setNumberFormat('@');
    i = j + 1;
  }
}

/**
 * Adds the starting lines, areas, classifications, roles, settings, role access, contractors and task templates. Never
 * overwrites. 1.7.0: also moves the old action statuses to tasks, once (migrateActions_ in Tasks.js). 1.10.0: new defaults
 * for two untouched settings (updateUntouchedSettings_).
 */
function seedDefaults() {
  var seeds = SCHEMA.seeds;
  var added = {};
  withLock_(function () {
    function seed(table, keyOf, items) {
      var have = {};
      readTable_(table).forEach(function (r) { have[keyOf(r)] = true; });
      var fresh = items.filter(function (it) { return !have[keyOf(it)]; });
      appendRows_(table, fresh);
      added[table] = fresh.length;
    }
    seed(T.LINES, function (r) { return r.line_id; }, seeds.lines);
    seed(T.AREAS, function (r) { return r.area_id; }, seeds.areas.map(function (a) {
      return { area_id: a.area_id, name: a.name, line_id: a.line_id, sort_order: a.sort_order, active: true,
        in_downtime_sheet: a.in_downtime_sheet, notes: a.notes || '' };
    }));
    seed(T.CLASSIFICATIONS, function (r) { return r.code; }, seeds.classifications);
    seed(T.ROLES, function (r) { return r.role_id; }, seeds.roles);
    seed(T.SETTINGS, function (r) { return r.key; }, seeds.settings.map(function (s) {
      return { key: s.key, value: s.value, description: s.description, updated_by: 'setup', updated_at: nowTs_() };
    }));
    var access = [];
    Object.keys(seeds.tabAccess).forEach(function (role) {
      Object.keys(seeds.tabAccess[role]).forEach(function (tab) {
        access.push({ subject_type: 'role', subject_id: role, tab_id: tab, level: seeds.tabAccess[role][tab] });
      });
    });
    seed(T.TAB_ACCESS, function (r) { return r.subject_type + '|' + r.subject_id + '|' + r.tab_id; }, access);
    // contractors and internal teams of the Actions page (1.4.0); an existing id is never touched
    seed(T.CONTRACTORS, function (r) { return r.contractor_id; }, seeds.contractors || []);
    // 1.7.0: the three task templates (an existing template id is never touched), then the one-time move of the old action
    // statuses Contractor informed / Waiting stoppage / In progress to tasks (Tasks.js migrateActions_; runs once)
    added[T.TASK_TEMPLATES] = seedTaskTemplates_(seeds.taskTemplates || []);
    // schema v7: the plant shifts (an existing shift id is never touched)
    seed(T.SHIFTS, function (r) { return r.shift_id; }, seeds.shifts || []);
    // schema v7: the draft KPI definitions for the Stage 0 review (an existing kpi id is never touched)
    seed(T.KPI_DEFINITIONS, function (r) { return r.kpi_id; }, seeds.kpiDefinitions || []);
    // schema v7: laboratory parameters (from the QCX export columns) and the data-check rules of every section
    seed(T.QUALITY_PARAMETERS, function (r) { return r.param_id; }, seeds.qualityParameters || []);
    seed(T.CHECK_RULES, function (r) { return r.rule_id; }, seeds.checkRules || []);
    // 1.10.0: new defaults for settings nobody has changed since setup (keep me signed in 30 -> 14 days, the longest
    // wait after wrong passwords 15 -> 30 minutes); a value someone saved is left alone
    added.settings_updated = updateUntouchedSettings_({ session_hours_keep: ['720', '336'], lockout_minutes: ['15', '30'] });
    var moved = migrateActions_();
    added.actions_moved_to_tasks = moved.migrated;
    auditLog_('setup', 'seed_defaults', '', '', JSON.stringify(added));
  });
  Logger.log('Defaults added: ' + JSON.stringify(added));
  return added;
}

/** Sets `key` from its old default to the new one where the row was written by setup and never changed. */
function updateUntouchedSettings_(changes) {
  var n = 0;
  readTable_(T.SETTINGS).forEach(function (r) {
    var c = changes[r.key];
    if (c && r.updated_by === 'setup' && String(r.value) === c[0]) {
      updateRow_(T.SETTINGS, r._row, { value: c[1], updated_at: nowTs_() });
      n++;
    }
  });
  return n;
}

/** Creates the first Admin with a random temporary password, written to the log ONCE. */
function createFirstAdmin(email, displayName) {
  var mail = normEmail_(email);
  if (!EMAIL_PATTERN_.test(mail)) throw new Error('Enter a valid email address.');
  var name = cleanText_(displayName, 'Name', true, 100);
  var temp = generateTempPassword_();
  var row = withLock_(function () {
    if (findUserByEmail_(mail)) throw new Error('A user with this email already exists.');
    requireRole_('ROLE-ADMIN');
    var r = insertUser_(mail, name, 'ROLE-ADMIN', temp, 'setup');
    auditLog_('setup', 'create_first_admin', T.USERS, r.user_id, mail);
    return r;
  });
  Logger.log('FIRST ADMIN CREATED: ' + mail + '\nTemporary password (shown only now, write it down): ' + temp +
    '\nYou must change it at first sign-in.');
  return { user_id: row.user_id, email: mail };
}

/** Editor shortcut: put your own email and name below, then Run this function once. */
function createFirstAdminRun() {
  var email = 'CHANGE-ME@example.com';
  var name = 'Plant Admin';
  if (/example\.com$/i.test(email)) throw new Error('Edit the email and name inside createFirstAdminRun first.');
  return createFirstAdmin(email, name);
}

/**
 * Creates the two secrets and the password-hash cost, once. Run it from the editor.
 * - Only values that are missing are created; an existing value is NEVER changed
 *   (changing PASSWORD_PEPPER would stop every password working, and changing
 *   SESSION_SIGNING_SECRET would sign everyone out).
 * - The values are random, kept only in Script Properties, and never printed or logged.
 */
function generateSecrets() {
  var props = PropertiesService.getScriptProperties();
  var say = [];
  [[PROP.SECRET, 'signs the login tokens'], [PROP.PEPPER, 'is mixed into every password hash']].forEach(function (p) {
    if (getProp_(p[0])) { say.push(p[0] + ' already exists: left unchanged.'); return; }
    props.setProperty(p[0], randomHex_(96));
    say.push(p[0] + ' created: 96 random characters, stored only in Script Properties; it ' + p[1] + '.');
  });
  if (getProp_(PROP.ROUNDS)) {
    say.push(PROP.ROUNDS + ' already exists: left unchanged.');
  } else {
    var rounds = benchmarkHashRounds();
    props.setProperty(PROP.ROUNDS, String(rounds));
    say.push(PROP.ROUNDS + ' set to ' + rounds + ' (measured on this account).');
  }
  say.push('Next: run createFirstAdminRun (after putting your email and name in it), then installCheck.');
  var text = say.join('\n');
  Logger.log(text);
  return text;
}

/** Times the password hash on this Google account and suggests a HASH_ROUNDS value. */
function benchmarkHashRounds() {
  var probe = 200;
  var t0 = Date.now();
  hashPassword_('benchmark-only', 'benchmark-salt', probe);
  var perRound = Math.max((Date.now() - t0) / probe, 0.001);
  var target = 400; // milliseconds per sign-in is a good balance
  var rounds = Math.min(HASH_ROUNDS_MAX, Math.max(200, Math.round(target / perRound / 100) * 100));
  Logger.log('One hash round takes about ' + perRound.toFixed(3) + ' ms.\nSuggested HASH_ROUNDS = ' + rounds +
    ' (about ' + Math.round(rounds * perRound) + ' ms per sign-in). Add it as a Script Property named HASH_ROUNDS.');
  return rounds;
}

/** Plain-English status of the installation. Never prints secret values. */
function installCheck() {
  var lines = [];
  var problems = 0;
  function say(ok, text) { lines.push((ok ? 'OK:      ' : 'PROBLEM: ') + text); if (!ok) problems++; }
  var ss = null;
  try { ss = getSpreadsheet_(); say(true, 'Spreadsheet found: ' + ss.getName()); }
  catch (e) { say(false, 'Spreadsheet not found. Check the SPREADSHEET_ID property or bind the script to the sheet.'); }
  [PROP.SECRET, PROP.PEPPER].forEach(function (p) {
    var v = getProp_(p);
    say(v.length >= MIN_SECRET_LENGTH, p + (v ? (v.length >= MIN_SECRET_LENGTH ? ' is set.' : ' is set but too short.') : ' is missing.'));
  });
  lines.push('INFO:    HASH_ROUNDS in use: ' + getHashRounds_() + (getProp_(PROP.ROUNDS) ? '' : ' (default; run benchmarkHashRounds)'));
  if (ss) {
    SCHEMA.tableOrder.forEach(function (name) {
      var sh = ss.getSheetByName(name);
      if (!sh) { say(false, 'Sheet "' + name + '" is missing. Run ensureSchema.'); return; }
      var headers = sheetHeaders_(sh);
      var missing = SCHEMA.tables[name].columns.map(function (c) { return c.name; }).filter(function (n) { return headers.indexOf(n) < 0; });
      say(!missing.length, 'Sheet "' + name + '"' + (missing.length ? ' lacks columns: ' + missing.join(', ') + '. Run ensureSchema.' : ' is ready.'));
    });
    if (!problems) {
      say(readTable_(T.ROLES).length >= 4 && readTable_(T.AREAS).length > 0, 'Starting data (roles, areas) is present. If not, run seedDefaults.');
      var admins = readUsers_().filter(function (u) { return u.active && u.role_id === 'ROLE-ADMIN'; }).length;
      say(admins > 0, admins + ' active Admin user(s). If 0, run createFirstAdminRun.');
    }
  }
  lines.push(problems ? 'RESULT:  ' + problems + ' thing(s) need attention.' : 'RESULT:  Everything looks ready.');
  var text = lines.join('\n');
  Logger.log(text);
  return text;
}

// ---------- notifications: triggers and the daily job ----------

var NOTIFICATION_JOB_ = 'notificationDailyJob';

function notificationTriggersOfThisScript_() {
  return ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === NOTIFICATION_JOB_; });
}

/**
 * Creates the daily trigger (about 07:00 plant time) that runs notificationDailyJob. Safe to run again: it first
 * removes this script's own earlier notification triggers (and only those), so there is always exactly one.
 * The first run asks for two more permissions (send email, manage triggers): approve them once.
 */
function installNotificationTriggers() {
  var removed = notificationTriggersOfThisScript_();
  removed.forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger(NOTIFICATION_JOB_).timeBased().everyDays(1).atHour(7).inTimezone(TIMEZONE).create();
  var text = 'Notification trigger installed: ' + NOTIFICATION_JOB_ + ' runs every day around 07:00 (' + TIMEZONE + ')' +
    (removed.length ? ' (replaced ' + removed.length + ' earlier trigger' + (removed.length === 1 ? '' : 's') + ').' : '.');
  Logger.log(text);
  return text;
}

/** Removes the notification trigger(s) created by installNotificationTriggers. Other triggers are left alone. */
function removeNotificationTriggers() {
  var removed = notificationTriggersOfThisScript_();
  removed.forEach(function (t) { ScriptApp.deleteTrigger(t); });
  var text = 'Removed ' + removed.length + ' notification trigger' + (removed.length === 1 ? '' : 's') + '.';
  Logger.log(text);
  return text;
}

/**
 * The daily job: runs the notification checks and the action checks, then sends the digests that are due. Each step is isolated, so a
 * failed check does not stop the digests and nothing here can throw into the trigger.
 */
/**
 * 1.10.0: the background run after an upload (a one-off trigger made by scheduleAfterUploadChecks_): the alerts and
 * action checks for every upload finished since the last run, then the trigger removes itself.
 */
function afterUploadJob() {
  try {
    ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === AFTER_UPLOAD_JOB_) ScriptApp.deleteTrigger(t); });
  } catch (e) { /* a leftover one-off trigger does nothing harmful */ }
  var props = PropertiesService.getScriptProperties();
  var ids = JSON.parse(props.getProperty(PENDING_UPLOADS_PROP_) || '[]');
  props.deleteProperty(PENDING_UPLOADS_PROP_);
  var batches = readTable_(T.BATCHES).filter(function (b) { return ids.indexOf(b.batch_id) >= 0; });
  if (batches.length) runAfterUploadChecks_(batches);
  return { uploads: batches.length };
}

/**
 * 1.10.0: removes notifications that were resolved or expired more than notif_retention_days ago, and the seen /
 * snoozed / dismissed rows that point at them. One read and one write per table, never row by row.
 */
function cleanupNotifications_() {
  return withLock_(function () {
    var st = notifSettings_();
    var cutoff = fmtTsMs_(nowMs_() - st.retentionDays * MS_DAY_);
    var gone = {};
    var n = keepRows_(T.NOTIFICATIONS, function (r) {
      var end = r.status === 'resolved' ? r.resolved_at : r.status === 'expired' ? r.expires_at : '';
      var drop = !!end && end < cutoff;
      if (drop) gone[r.notification_id] = true;
      return !drop;
    });
    var s = n ? keepRows_(T.NOTIFICATION_STATE, function (r) { return !gone[r.notification_id]; }) : 0;
    return { notifications: n, states: s };
  });
}

function notificationDailyJob() {
  var out = { checks: null, actions: null, digest: null, cleanup: null };
  try { out.checks = runNotificationChecks_({}); } catch (err) { notifLogFailure_('daily checks', err); }
  try { out.cleanup = cleanupNotifications_(); } catch (err3) { notifLogFailure_('daily clean-up', err3); }
  out.actions = actionChecksSafely_('daily checks'); // drafts and effectiveness (1.4.0)
  try { out.digest = sendDigest_(); } catch (err2) { notifLogFailure_('daily digest', err2); }
  Logger.log('Notification job: ' + JSON.stringify(out));
  return out;
}

// ======================================================================
// ShiftReports.js
// ======================================================================
/**
 * Shift reports (plant system, backend 2.1.0; docs/plant-system/02-shift-workflow-and-roles.md).
 *
 * One report per date x shift x area. The shift leader enters the stoppages (Draft), submits (Submitted); the
 * production manager approves (Production approved) or returns it to the shift leader (Returned); the reliability
 * engineer validates (Validated) or returns it to the production manager (Submitted again). Validated stoppages that
 * are closed become downtime events (origin shift); when all its stoppages are posted the report is Posted.
 *
 * A stop that lasts beyond its shift stays open (no restart time). A later shift of the area enters the restart time
 * (closeShiftStoppage); that change belongs to the later shift's report, so it passes the same two reviews before the
 * stoppage is posted.
 *
 * Who may act is decided by the person's responsibilities for the area on the report date (Responsibilities.js):
 * shift_entry, production_review, reliability_validation. The Admin role may do every step (for set-up and tests);
 * otherwise the person who entered or submitted a report may not approve it.
 */

var SHIFT_STATUSES = ['draft', 'submitted', 'returned', 'prod_approved', 'validated', 'posted'];
var SHIFT_STOP_FIELDS = ['code_raw', 'stop_ts', 'start_ts', 'classification', 'is_failure', 'reason_raw', 'description'];
var SHIFT_LIST_MAX_DAYS = 62;
var SHIFT_MAX_STOPPAGES = 200;
var SHIFT_COMMENT_MIN = 3;

function shiftDefs_() {
  var rows = readTable_(T.SHIFTS).filter(function (s) { return toBool_(s.active); });
  if (!rows.length) rows = (SCHEMA.seeds.shifts || []).slice();
  return rows.sort(function (a, b) { return (a.sort_order || 0) - (b.sort_order || 0); });
}

function addDays_(day, n) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(day);
  var d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3] + n));
  function p(x) { return (x < 10 ? '0' : '') + x; }
  return d.getUTCFullYear() + '-' + p(d.getUTCMonth() + 1) + '-' + p(d.getUTCDate());
}

/** Start and end ('YYYY-MM-DD HH:MM:SS.000') of a shift on a report date; a shift that ends at or before it starts ends the next day. */
function shiftWindow_(def, day) {
  var start = day + ' ' + def.start_time + ':00.000';
  var endDay = def.end_time <= def.start_time ? addDays_(day, 1) : day;
  return { start: start, end: endDay + ' ' + def.end_time + ':00.000' };
}

function shiftDefOrThrow_(shiftId) {
  var def = shiftDefs_().filter(function (s) { return s.shift_id === shiftId; })[0];
  if (!def) throw apiError_(ERR.BAD_REQUEST, 'There is no shift ' + String(shiftId).slice(0, 20) + '.');
  return def;
}

function reportIdOf_(day, shiftId, areaId) { return 'SR-' + day.replace(/-/g, '') + '-' + shiftId + '-' + areaId; }

/** Does the person hold `duty` for `area` on `day`? The Admin role always may. */
function hasDuty_(session, duty, area, day) {
  if (isAdmin_(session)) return true;
  return readTable_(T.RESPONSIBILITIES).some(function (r) {
    return r.user_id === session.user.user_id && toBool_(r.active) && r.duty === duty &&
      (!r.valid_from || r.valid_from <= day) && (!r.valid_to || day <= r.valid_to) &&
      (r.scope_type === 'plant' || (r.scope_type === 'line' && r.scope_id === area.line_id) || (r.scope_type === 'area' && r.scope_id === area.area_id));
  });
}

var DUTY_TEXT_ = { shift_entry: 'Shift report entry', production_review: 'Production review', reliability_validation: 'Reliability validation' };

function requireDuty_(session, duty, area, day) {
  if (!hasDuty_(session, duty, area, day)) {
    throw apiError_(ERR.FORBIDDEN, 'You do not hold the duty "' + DUTY_TEXT_[duty] + '" for ' + area.area_id + ' on ' + day +
      '. An Admin can add it in Settings > Users > Responsibilities.');
  }
}

function shiftReportOut_(r) {
  var out = {};
  tableDef_(T.SHIFT_REPORTS).columns.forEach(function (c) { out[c.name] = r[c.name] === undefined || r[c.name] === null ? '' : r[c.name]; });
  return out;
}

function shiftStopOut_(s) {
  var out = {};
  tableDef_(T.SHIFT_STOPPAGES).columns.forEach(function (c) { out[c.name] = s[c.name] === undefined || s[c.name] === null ? '' : s[c.name]; });
  out.is_failure = toBool_(s.is_failure);
  out.duration_s = s.duration_s === '' || s.duration_s === null || s.duration_s === undefined ? null : Number(s.duration_s);
  return out;
}

// ---------- reads ----------

/** Reports with a date in [from, to], their stoppages, every open stoppage, and the stoppages those reports closed. */
function listShiftReports_(from, to) {
  if (!isValidDate_(from) || !isValidDate_(to) || to < from) throw apiError_(ERR.BAD_REQUEST, 'Choose a valid date range.');
  if ((parseTs_(to + ' 00:00:00') - parseTs_(from + ' 00:00:00')) / 86400000 > SHIFT_LIST_MAX_DAYS) {
    throw apiError_(ERR.BAD_REQUEST, 'Choose at most ' + SHIFT_LIST_MAX_DAYS + ' days.');
  }
  var reports = readTable_(T.SHIFT_REPORTS).filter(function (r) { return r.report_date >= from && r.report_date <= to; });
  var ids = {};
  reports.forEach(function (r) { ids[r.report_id] = true; });
  var stops = readTable_(T.SHIFT_STOPPAGES).filter(function (s) {
    return s.row_state === 'active' && (ids[s.report_id] || ids[s.closed_report_id] || s.stop_state === 'open');
  });
  // the reports of open stoppages from before the range, so the screen can name them
  var extra = {};
  stops.forEach(function (s) { if (!ids[s.report_id]) extra[s.report_id] = true; });
  if (Object.keys(extra).length) {
    readTable_(T.SHIFT_REPORTS).forEach(function (r) { if (extra[r.report_id]) reports.push(r); });
  }
  // the names of the people on these reports (the screens show names, and most people cannot read the Users page)
  var people = {};
  var want = {};
  reports.forEach(function (r) { ['entered_by', 'submitted_by', 'prod_reviewed_by', 'rel_validated_by', 'returned_by'].forEach(function (k) { if (r[k]) want[r[k]] = true; }); });
  stops.forEach(function (s) { if (s.closed_by) want[s.closed_by] = true; });
  readUsers_().forEach(function (u) { if (want[u.user_id]) people[u.user_id] = u.display_name; });
  return { shifts: shiftDefs_().map(function (s) { return { shift_id: s.shift_id, name: s.name, start_time: s.start_time, end_time: s.end_time, sort_order: s.sort_order }; }),
    reports: reports.map(shiftReportOut_), stoppages: stops.map(shiftStopOut_), people: people };
}

function getShiftReportHistory_(reportId) {
  var id = cleanText_(reportId, 'Report', true, 80);
  if (!findBy_(T.SHIFT_REPORTS, 'report_id', id)) throw apiError_(ERR.NOT_FOUND, 'That shift report was not found.');
  var log = readTable_(T.WORKFLOW_LOG).filter(function (l) { return l.report_id === id; }).map(function (l) {
    return { log_id: l.log_id, action: l.action, from_status: l.from_status || '', to_status: l.to_status || '', stage: l.stage || '', by_user: l.by_user, at: l.at, comment: l.comment || '' };
  });
  var edits = readTable_(T.SHIFT_STOPPAGE_EDITS).filter(function (e) { return e.report_id === id; }).map(function (e) {
    return { edit_id: e.edit_id, stop_id: e.stop_id, stage: e.stage, field: e.field, old_value: e.old_value === undefined ? '' : String(e.old_value),
      new_value: e.new_value === undefined ? '' : String(e.new_value), comment: e.comment || '', edited_by: e.edited_by, edited_at: e.edited_at };
  });
  return { log: log, edits: edits };
}

// ---------- one stoppage: input -> stored fields ----------

function shiftTs_(v, label) {
  if (v === null || v === undefined || v === '') return '';
  var s = typeof v === 'string' ? v.trim().replace('T', ' ') : '';
  if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$/.test(s)) s += ':00';
  var n = normTs_(s);
  if (!n) throw apiError_(ERR.BAD_REQUEST, label + ' must be a date and time like 2026-10-20 14:30.');
  return n;
}

/**
 * Cleans one stoppage of `area` and works out the derived fields with the same rules as an uploaded event
 * (normalizeEvent_): equipment, reason, criticality from the classification, and the data-check flags.
 */
function cleanStoppage_(ctx, area, s, win, opts) {
  requireObject_(s, 'A stoppage');
  var stop = shiftTs_(s.stop_ts, 'Stop time');
  if (!stop) throw apiError_(ERR.BAD_REQUEST, 'Every stoppage needs its stop time.');
  if (opts.checkWindow && (stop < win.start || stop >= win.end)) {
    throw apiError_(ERR.BAD_REQUEST, 'Stop time ' + stop.slice(0, 16) + ' is outside this shift (' + win.start.slice(0, 16) + ' to ' + win.end.slice(0, 16) + '). Enter it in the report of the shift it started in.');
  }
  var start = shiftTs_(s.start_ts, 'Restart time');
  if (start && opts.checkWindow && start > win.end) {
    throw apiError_(ERR.BAD_REQUEST, 'Restart time ' + start.slice(0, 16) + ' is after this shift ends. Leave it blank: the shift that sees the restart enters it.');
  }
  if (start && start > nowTs_()) throw apiError_(ERR.BAD_REQUEST, 'Restart time ' + start.slice(0, 16) + ' is in the future.');
  if (stop > nowTs_()) throw apiError_(ERR.BAD_REQUEST, 'Stop time ' + stop.slice(0, 16) + ' is in the future.');
  var cls = typeof s.classification === 'string' ? s.classification.trim().toUpperCase() : '';
  var klass = ctx.classes[cls];
  var incident = klass ? toBool_(klass.is_incident) : false;
  var failure = s.is_failure === true && !!klass && incident;
  var norm = normalizeEvent_(ctx, {
    event_date: stop.slice(0, 10), line_id: area.line_id, area_id: area.area_id, code_raw: s.code_raw === undefined || s.code_raw === null ? '' : s.code_raw,
    stop_ts: stop, start_ts: start || stop, freq: 1, classification: cls, criticality: incident ? 'INC' : 'NO_INC',
    is_failure: failure, reason_raw: s.reason_raw, description: s.description
  });
  if (norm.error) throw apiError_(ERR.BAD_REQUEST, norm.error);
  var rec = norm.rec;
  return {
    area_id: area.area_id, line_id: area.line_id, code_raw: rec.code_raw, equipment_id: rec.equipment_id, stop_ts: stop, start_ts: start,
    duration_s: start ? rec.duration_s : '', freq: 1, classification: cls, criticality: incident ? 'INC' : 'NO_INC', is_failure: failure,
    reason_raw: rec.reason_raw, reason_id: rec.reason_id, description: rec.description, flags: rec.flags,
    stop_state: start ? 'closed' : 'open'
  };
}

var SHIFT_BLOCKING_ = ['missing_classification', 'invalid_classification', 'end_before_start'];

function blockingOf_(s) {
  return String(s.flags || '').split(',').filter(function (f) { return SHIFT_BLOCKING_.indexOf(f) >= 0; });
}

function requireNoBlocking_(stops) {
  var bad = stops.filter(function (s) { return blockingOf_(s).length; });
  if (bad.length) {
    throw apiError_(ERR.BAD_REQUEST, bad.length + ' stoppage(s) must be fixed first: ' + bad.slice(0, 3).map(function (s) {
      return s.stop_ts.slice(11, 16) + ' ' + (s.code_raw || '(no code)') + ' (' + blockingOf_(s).join(', ').replace(/_/g, ' ') + ')';
    }).join('; ') + '.');
  }
}

function logWorkflow_(reportId, action, from, to, stage, by, comment) {
  appendRow_(T.WORKFLOW_LOG, { log_id: newId_('WL-', 10), report_id: reportId, action: action, from_status: from, to_status: to, stage: stage, by_user: by, at: nowTs_(), comment: comment || '' });
}

function logStopEdits_(stop, reportId, stage, before, after, by, comment) {
  var rows = [];
  SHIFT_STOP_FIELDS.forEach(function (f) {
    var a = before[f] === undefined || before[f] === null ? '' : String(before[f]);
    var b = after[f] === undefined || after[f] === null ? '' : String(after[f]);
    if (a !== b) rows.push({ edit_id: newId_('SE-', 10), stop_id: stop, report_id: reportId, stage: stage, field: f, old_value: a, new_value: b, comment: comment || '', edited_by: by, edited_at: nowTs_() });
  });
  appendRows_(T.SHIFT_STOPPAGE_EDITS, rows);
  return rows.length;
}

// ---------- entry ----------

/**
 * Creates or updates the shift leader's report. `stoppages` is the complete list of the report's own stoppages:
 * rows with a stop_id are updated, new rows are added, rows left out are removed. With `submit` the report goes to
 * production review (blocking data problems must be fixed first).
 */
function saveShiftReport_(session, p) {
  requireObject_(p, 'The report');
  var day = String(p.report_date || '');
  if (!isValidDate_(day)) throw apiError_(ERR.BAD_REQUEST, 'Choose the report date.');
  var def = shiftDefOrThrow_(String(p.shift_id || ''));
  var win = shiftWindow_(def, day);
  if (win.start > nowTs_()) throw apiError_(ERR.BAD_REQUEST, 'This shift has not started yet.');
  var list = p.stoppages === undefined ? [] : p.stoppages;
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Stoppages must be a list.');
  if (list.length > SHIFT_MAX_STOPPAGES) throw apiError_(ERR.BAD_REQUEST, 'At most ' + SHIFT_MAX_STOPPAGES + ' stoppages in one report.');
  var notes = cleanText_(p.notes === undefined ? '' : p.notes, 'Notes', false, TEXT_MAX);
  var ctx = eventContext_();
  var area = findArea_(ctx, String(p.area_id || ''));
  if (!area) throw apiError_(ERR.BAD_REQUEST, 'There is no area ' + String(p.area_id).slice(0, 40) + '.');
  if (area.active === false) throw apiError_(ERR.BAD_REQUEST, 'Area ' + area.area_id + ' is switched off.');
  requireDuty_(session, 'shift_entry', area, day);
  var by = session.user.user_id;
  return withLock_(function () {
    var id = reportIdOf_(day, def.shift_id, area.area_id);
    var rep = findBy_(T.SHIFT_REPORTS, 'report_id', id);
    var now = nowTs_();
    if (rep && rep.status !== 'draft' && rep.status !== 'returned') {
      throw apiError_(ERR.CONFLICT, 'This report is ' + rep.status.replace('_', ' ') + ' and can no longer be changed by the shift leader.');
    }
    if (!rep) {
      appendRow_(T.SHIFT_REPORTS, { report_id: id, report_date: day, shift_id: def.shift_id, area_id: area.area_id, line_id: area.line_id,
        status: 'draft', source: 'app', entered_by: by, entered_at: now, notes: notes, updated_by: by, updated_at: now });
      logWorkflow_(id, 'create', '', 'draft', 'entry', by, '');
      rep = findBy_(T.SHIFT_REPORTS, 'report_id', id);
    }
    var all = readTable_(T.SHIFT_STOPPAGES);
    var mine = all.filter(function (s) { return s.report_id === id && s.row_state === 'active'; });
    var byId = {};
    mine.forEach(function (s) { byId[s.stop_id] = s; });
    var keep = {};
    var added = 0, changed = 0, removed = 0;
    var fresh = [];
    list.forEach(function (s) {
      var clean = cleanStoppage_(ctx, area, s, win, { checkWindow: true });
      var sid = s && typeof s.stop_id === 'string' ? s.stop_id : '';
      if (sid) {
        var old = byId[sid];
        if (!old) throw apiError_(ERR.BAD_REQUEST, 'Stoppage ' + sid.slice(0, 30) + ' is not in this report.');
        if (keep[sid]) throw apiError_(ERR.BAD_REQUEST, 'Stoppage ' + sid.slice(0, 30) + ' is listed twice.');
        keep[sid] = true;
        // a restart entered by a later shift stays with that shift: the shift leader of this report does not change it
        if (old.closed_report_id && old.closed_report_id !== id) { clean.start_ts = old.start_ts; clean.duration_s = old.duration_s; clean.stop_state = old.stop_state; }
        var diff = SHIFT_STOP_FIELDS.some(function (f) { return String(old[f] === undefined || old[f] === null ? '' : old[f]) !== String(clean[f]); });
        if (diff) {
          if (rep.status === 'returned') logStopEdits_(sid, id, 'entry', old, clean, by, 'Changed after return');
          clean.updated_by = by; clean.updated_at = now;
          updateRow_(T.SHIFT_STOPPAGES, old._row, clean);
          changed++;
        }
      } else {
        clean.stop_id = newId_('SS-', 10);
        clean.report_id = id;
        clean.row_state = 'active';
        clean.created_by = by; clean.created_at = now;
        fresh.push(clean);
        added++;
      }
    });
    mine.forEach(function (s) {
      if (keep[s.stop_id]) return;
      if (s.closed_report_id && s.closed_report_id !== id) throw apiError_(ERR.CONFLICT, 'The stoppage at ' + String(s.stop_ts).slice(0, 16) + ' was closed by a later shift and cannot be removed here.');
      updateRow_(T.SHIFT_STOPPAGES, s._row, { row_state: 'deleted', updated_by: by, updated_at: now });
      removed++;
    });
    appendRows_(T.SHIFT_STOPPAGES, fresh);
    var patch = { notes: notes, updated_by: by, updated_at: now };
    var detail = 'Added ' + added + ', changed ' + changed + ', removed ' + removed;
    if (p.submit === true) {
      var active = readTable_(T.SHIFT_STOPPAGES).filter(function (s) { return s.row_state === 'active' && (s.report_id === id || s.closed_report_id === id); });
      requireNoBlocking_(active);
      patch.status = 'submitted';
      patch.submitted_by = by;
      patch.submitted_at = now;
      logWorkflow_(id, 'submit', rep.status, 'submitted', 'entry', by, '');
      auditLog_(by, 'shift_report_submit', T.SHIFT_REPORTS, id, detail);
    } else {
      auditLog_(by, 'shift_report_save', T.SHIFT_REPORTS, id, detail);
    }
    updateRow_(T.SHIFT_REPORTS, rep._row, patch);
    return shiftReportBundle_(id);
  });
}

/** The report, its stoppages and the stoppages it closed (what the screens need after a write). */
function shiftReportBundle_(id) {
  var rep = findBy_(T.SHIFT_REPORTS, 'report_id', id);
  var stops = readTable_(T.SHIFT_STOPPAGES).filter(function (s) { return s.row_state === 'active' && (s.report_id === id || s.closed_report_id === id); });
  return { report: shiftReportOut_(rep), stoppages: stops.map(shiftStopOut_) };
}

/**
 * A later shift enters the restart time of a stoppage that is still open (or corrects the restart time it entered
 * itself while its report can still be changed). The later shift's report is created as a draft when needed.
 */
function closeShiftStoppage_(session, p) {
  requireObject_(p, 'The restart');
  var stopId = cleanText_(p.stop_id, 'Stoppage', true, 40);
  var day = String(p.report_date || '');
  if (!isValidDate_(day)) throw apiError_(ERR.BAD_REQUEST, 'Choose the date of your shift.');
  var def = shiftDefOrThrow_(String(p.shift_id || ''));
  var win = shiftWindow_(def, day);
  var start = shiftTs_(p.start_ts, 'Restart time');
  if (!start) throw apiError_(ERR.BAD_REQUEST, 'Enter the restart time.');
  if (start > nowTs_()) throw apiError_(ERR.BAD_REQUEST, 'Restart time ' + start.slice(0, 16) + ' is in the future.');
  if (start < win.start || start > win.end) {
    throw apiError_(ERR.BAD_REQUEST, 'Restart time ' + start.slice(0, 16) + ' is outside your shift (' + win.start.slice(0, 16) + ' to ' + win.end.slice(0, 16) + ').');
  }
  var ctx = eventContext_();
  var by = session.user.user_id;
  return withLock_(function () {
    var s = findBy_(T.SHIFT_STOPPAGES, 'stop_id', stopId);
    if (!s || s.row_state !== 'active') throw apiError_(ERR.NOT_FOUND, 'That stoppage was not found.');
    var area = findArea_(ctx, s.area_id);
    requireDuty_(session, 'shift_entry', area, day);
    var id = reportIdOf_(day, def.shift_id, area.area_id);
    if (id === s.report_id) throw apiError_(ERR.BAD_REQUEST, 'This stoppage belongs to this shift: enter its restart time in the report itself.');
    if (s.stop_state !== 'open' && s.closed_report_id !== id) throw apiError_(ERR.CONFLICT, 'This stoppage already has its restart time.');
    if (start < s.stop_ts) throw apiError_(ERR.BAD_REQUEST, 'The restart time is before the stop time (' + String(s.stop_ts).slice(0, 16) + ').');
    var rep = findBy_(T.SHIFT_REPORTS, 'report_id', id);
    var now = nowTs_();
    if (rep && rep.status !== 'draft' && rep.status !== 'returned') throw apiError_(ERR.CONFLICT, 'Your report for this shift is already ' + rep.status.replace('_', ' ') + '.');
    if (!rep) {
      appendRow_(T.SHIFT_REPORTS, { report_id: id, report_date: day, shift_id: def.shift_id, area_id: area.area_id, line_id: area.line_id,
        status: 'draft', source: 'app', entered_by: by, entered_at: now, updated_by: by, updated_at: now });
      logWorkflow_(id, 'create', '', 'draft', 'entry', by, '');
    }
    var duration = (parseTs_(start) - parseTs_(s.stop_ts)) / 1000;
    logStopEdits_(s.stop_id, id, 'entry', { start_ts: s.start_ts }, { start_ts: start }, by, 'Restart entered by a later shift');
    updateRow_(T.SHIFT_STOPPAGES, s._row, { start_ts: start, duration_s: duration, stop_state: 'closed', closed_report_id: id, closed_by: by, closed_at: now, updated_by: by, updated_at: now });
    auditLog_(by, 'shift_stoppage_close', T.SHIFT_STOPPAGES, s.stop_id, 'Restart ' + start.slice(0, 16) + ' in ' + id);
    return shiftReportBundle_(id);
  });
}

// ---------- review ----------

/**
 * Production review (status Submitted: approve or return to the shift leader) and reliability validation (status
 * Production approved: validate or return to production). `edits` are corrections made by the reviewer first:
 * [{ stop_id, changes: { field: value } }] on this report's stoppages (and the restart times this report entered);
 * each change is logged with the step. A return needs a comment.
 */
function reviewShiftReport_(session, p) {
  requireObject_(p, 'The review');
  var id = cleanText_(p.report_id, 'Report', true, 80);
  var decision = String(p.decision || '');
  if (['approve', 'return', 'validate'].indexOf(decision) < 0) throw apiError_(ERR.BAD_REQUEST, 'Decision must be approve, return or validate.');
  var comment = cleanText_(p.comment === undefined ? '' : p.comment, 'Comment', false, TEXT_MAX);
  if (decision === 'return' && comment.length < SHIFT_COMMENT_MIN) throw apiError_(ERR.BAD_REQUEST, 'Say why the report is returned (at least ' + SHIFT_COMMENT_MIN + ' characters).');
  var edits = p.edits === undefined ? [] : p.edits;
  if (!Array.isArray(edits)) throw apiError_(ERR.BAD_REQUEST, 'Edits must be a list.');
  var ctx = eventContext_();
  var by = session.user.user_id;
  return withLock_(function () {
    var rep = findBy_(T.SHIFT_REPORTS, 'report_id', id);
    if (!rep) throw apiError_(ERR.NOT_FOUND, 'That shift report was not found.');
    var area = findArea_(ctx, rep.area_id);
    var stage;
    if (rep.status === 'submitted') {
      stage = 'production';
      if (decision === 'validate') throw apiError_(ERR.CONFLICT, 'This report waits for production review first.');
      requireDuty_(session, 'production_review', area, rep.report_date);
      if (!isAdmin_(session) && (rep.entered_by === by || rep.submitted_by === by)) {
        throw apiError_(ERR.FORBIDDEN, 'You entered this report, so someone else must review it.');
      }
    } else if (rep.status === 'prod_approved') {
      stage = 'reliability';
      if (decision === 'approve') throw apiError_(ERR.CONFLICT, 'This report is already approved by production; validate or return it.');
      requireDuty_(session, 'reliability_validation', area, rep.report_date);
    } else {
      throw apiError_(ERR.CONFLICT, 'This report is ' + String(rep.status).replace('_', ' ') + ' and is not waiting for a review.');
    }
    var stops = readTable_(T.SHIFT_STOPPAGES).filter(function (s) { return s.row_state === 'active' && (s.report_id === id || s.closed_report_id === id); });
    var byId = {};
    stops.forEach(function (s) { byId[s.stop_id] = s; });
    var now = nowTs_();
    var nEdits = 0;
    edits.forEach(function (e) {
      requireObject_(e, 'An edit');
      var s = byId[e.stop_id];
      if (!s) throw apiError_(ERR.BAD_REQUEST, 'Stoppage ' + String(e.stop_id).slice(0, 30) + ' is not part of this report.');
      requireObject_(e.changes, 'The changes');
      Object.keys(e.changes).forEach(function (f) { if (SHIFT_STOP_FIELDS.indexOf(f) < 0) throw apiError_(ERR.BAD_REQUEST, 'Field ' + f.slice(0, 30) + ' cannot be changed.'); });
      // the restart time of a stoppage closed by this report belongs to this report; the rest stays with its own report
      if (s.report_id !== id && Object.keys(e.changes).some(function (f) { return f !== 'start_ts'; })) {
        throw apiError_(ERR.BAD_REQUEST, 'Only the restart time of a stoppage from an earlier shift can be changed here.');
      }
      var merged = {};
      SHIFT_STOP_FIELDS.forEach(function (f) { merged[f] = Object.prototype.hasOwnProperty.call(e.changes, f) ? e.changes[f] : s[f]; });
      merged.is_failure = merged.is_failure === true || merged.is_failure === 'TRUE' || merged.is_failure === 'true';
      var clean = cleanStoppage_(ctx, area, merged, null, { checkWindow: false });
      if (s.closed_report_id && s.closed_report_id !== s.report_id && !clean.start_ts) throw apiError_(ERR.BAD_REQUEST, 'A restart entered by a later shift cannot be removed; correct it instead.');
      nEdits += logStopEdits_(s.stop_id, id, stage, s, clean, by, comment);
      clean.updated_by = by; clean.updated_at = now;
      if (clean.stop_state === 'open') { clean.closed_report_id = ''; clean.closed_by = ''; clean.closed_at = ''; }
      updateRow_(T.SHIFT_STOPPAGES, s._row, clean);
      byId[s.stop_id] = Object.assign({}, s, clean);
    });
    var after = Object.keys(byId).map(function (k) { return byId[k]; });
    var patch = { updated_by: by, updated_at: now };
    var to;
    if (decision === 'return') {
      to = stage === 'production' ? 'returned' : 'submitted';
      patch.status = to; patch.returned_by = by; patch.returned_at = now; patch.return_stage = stage; patch.return_comment = comment;
    } else if (decision === 'approve') {
      requireNoBlocking_(after);
      to = 'prod_approved';
      patch.status = to; patch.prod_reviewed_by = by; patch.prod_reviewed_at = now;
    } else {
      requireNoBlocking_(after);
      to = 'validated';
      patch.status = to; patch.rel_validated_by = by; patch.rel_validated_at = now;
    }
    updateRow_(T.SHIFT_REPORTS, rep._row, patch);
    logWorkflow_(id, decision, rep.status, to, stage, by, comment);
    var posted = decision === 'validate' ? postReadyStoppages_(by) : 0;
    auditLog_(by, 'shift_report_' + decision, T.SHIFT_REPORTS, id, (nEdits ? nEdits + ' change(s). ' : '') + (decision === 'validate' ? posted + ' stoppage(s) posted. ' : '') + comment);
    return shiftReportBundle_(id);
  });
}

// ---------- posting ----------

var SHIFT_DONE_ = { validated: true, posted: true };

/**
 * Turns every stoppage that is ready into a downtime event: active, closed, not yet posted, its own report validated
 * and (when a later shift entered the restart) that report validated too. A stoppage that matches an event already
 * stored (same area, code, stop and restart: for example the month's workbook was also uploaded) is linked to it,
 * never added twice. Reports whose stoppages are all posted become Posted. Returns the number posted.
 */
function postReadyStoppages_(by) {
  var reports = readTable_(T.SHIFT_REPORTS);
  var repById = {};
  reports.forEach(function (r) { repById[r.report_id] = r; });
  var stops = readTable_(T.SHIFT_STOPPAGES).filter(function (s) { return s.row_state === 'active'; });
  var ready = stops.filter(function (s) {
    if (s.posted_event_id || s.stop_state !== 'closed') return false;
    var own = repById[s.report_id];
    var closer = s.closed_report_id ? repById[s.closed_report_id] : own;
    return own && closer && SHIFT_DONE_[own.status] && SHIFT_DONE_[closer.status];
  });
  var now = nowTs_();
  var ctx = ready.length ? eventContext_() : null;
  var known = {};
  if (ready.length) {
    var fps = readColumn_(T.EVENTS, 'fingerprint'), ids = readColumn_(T.EVENTS, 'event_id');
    for (var i = 0; i < fps.length; i++) known[fps[i]] = ids[i];
  }
  var fresh = [];
  ready.forEach(function (s) {
    var norm = normalizeEvent_(ctx, {
      event_date: String(s.stop_ts).slice(0, 10), line_id: s.line_id, area_id: s.area_id, code_raw: s.code_raw || '', stop_ts: s.stop_ts, start_ts: s.start_ts,
      freq: 1, classification: s.classification, criticality: s.criticality, is_failure: toBool_(s.is_failure), reason_raw: s.reason_raw || '', description: s.description || ''
    });
    if (norm.error) return; // cannot happen for a validated stoppage; it stays unposted and visible
    var rec = norm.rec;
    var fp = fingerprintOf_(rec.area_id + '|' + rec.code_key + '|' + rec.stop_ts + '|' + rec.start_ts, 1);
    var eventId = known[fp];
    if (!eventId) {
      delete rec.code_key;
      eventId = 'EV-' + fp.slice(0, 16);
      rec.event_id = eventId;
      rec.batch_id = s.closed_report_id || s.report_id;
      rec.source_file = 'Shift report ' + s.report_id;
      rec.source_row = '';
      rec.fingerprint = fp;
      rec.edited = false;
      rec.is_void = false;
      rec.created_at = now;
      rec.origin = 'shift';
      rec.time_precision = 'exact';
      rec.shift_stop_id = s.stop_id;
      fresh.push(rec);
      known[fp] = eventId;
    }
    updateRow_(T.SHIFT_STOPPAGES, s._row, { posted_event_id: eventId, updated_at: now });
    s.posted_event_id = eventId;
  });
  appendRows_(T.EVENTS, fresh);
  // reports with nothing left to post
  reports.forEach(function (r) {
    if (r.status !== 'validated') return;
    var own = stops.filter(function (s) { return s.report_id === r.report_id || s.closed_report_id === r.report_id; });
    if (own.every(function (s) { return !!s.posted_event_id; })) {
      updateRow_(T.SHIFT_REPORTS, r._row, { status: 'posted', posted_at: now, updated_at: now });
      logWorkflow_(r.report_id, 'post', 'validated', 'posted', 'reliability', by, own.length + ' stoppage(s) in the downtime analysis');
    }
  });
  return ready.length;
}

// ======================================================================
// Tasks.js
// ======================================================================
/**
 * Tasks inside actions (backend 1.7.0; docs/actions-mockups/tasks, docs/wire-protocol.md section 13).
 *
 * An action is the problem (one event or a group: equipment + reason); its tasks are the work. Two levels only.
 * The mock API (src/api/mockActions.ts) implements the same rules; tests/unit/contract.test.ts keeps the two in step.
 *
 * - Task statuses: Open, Contractor informed (only for an external contractor's task), Waiting stoppage, In progress, Done
 *   (needs a note of what was done) and Not needed (needs a reason). Tasks are never deleted.
 * - The action's status follows the tasks: Draft stays until it is accepted by hand; otherwise In progress as soon as any task
 *   has left Open, else Open. Closed / Cancelled stay manual (closers only); closing is refused while a task is open
 *   (error tasks_open). An action without tasks keeps the 1.4.0 behaviour.
 * - When the last open task of an accepted action closes, the closers get action_ready_to_close; reopening a task resolves it.
 * - Anyone with Edit on actions may add and change tasks. On a closed or cancelled action only a note may be added.
 * - Task templates (task_templates + task_template_steps) fill the tasks of a new action; an auto draft gets the active template
 *   that applies to its rule. "Check after 60 days" is not a task: it is the effectiveness check that starts on close.
 */

var TASK_CLOSED_ = ['Done', 'Not needed'];
var TASK_NOTE_MIN_ = 3;
var TASKS_PER_ACTION_MAX_ = 50;
var TEMPLATE_STEPS_MAX_ = 20;
var TEMPLATES_MAX_ = 30;
var TASK_TITLE_MAX_ = 200;
var AREA_CONTRACTOR_ = 'area_contractor';
var REMOVED_ACTION_STATUSES_ = ['Contractor informed', 'Waiting stoppage'];
var TASK_INPUT_FIELDS_ = ['title', 'owner', 'assignee', 'due_date', 'needs_stop', 'est_stop_h', 'notes', 'template_step'];
var TASK_CHANGE_FIELDS_ = ['title', 'owner', 'assignee', 'due_date', 'status', 'needs_stop', 'est_stop_h', 'notes', 'note'];
var TASK_FILTER_FIELDS_ = ['mine', 'overdue', 'needs_stop', 'status', 'owner', 'assignee', 'area_id', 'line_id', 'action_id', 'done_since', 'include_drafts'];

// ---------- small helpers ----------

function taskEnum_(column) { return enumOf_(T.ACTION_TASKS, column); }

function isTaskOpen_(t) { return TASK_CLOSED_.indexOf(t.status) < 0; }

function byTask_(a, b) {
  return a.action_id < b.action_id ? -1 : a.action_id > b.action_id ? 1 : (a.seq - b.seq) || (a.task_id < b.task_id ? -1 : 1);
}

/** Every task (sorted by action and seq), or [] before ensureSchema has made the sheet. */
function readAllTasks_() { return optionalTable_(T.ACTION_TASKS).sort(byTask_); }

function tasksOfAction_(actionId) {
  return optionalTable_(T.ACTION_TASKS).filter(function (t) { return t.action_id === actionId; }).sort(byTask_);
}

function tasksByAction_(tasks) {
  var by = {};
  tasks.forEach(function (t) { (by[t.action_id] = by[t.action_id] || []).push(t); });
  return by;
}

/** The API shape of a task row: est_stop_h null when not estimated or not needing a stop. */
function taskOut_(r) {
  var o = {};
  Object.keys(r).forEach(function (k) { o[k] = r[k]; });
  o.est_stop_h = r.needs_stop && r.est_stop_h !== null && r.est_stop_h !== '' && r.est_stop_h !== undefined ? Number(r.est_stop_h) : null;
  return o;
}

function taskLogRow_(actionId, taskId, by, kind, from, to, text, at) {
  var r = actionLogRow_(actionId, by, kind, from, to, text, at);
  r.task_id = taskId;
  return r;
}

/** Draft, Closed, Cancelled and actions without tasks keep their status; else In progress once a task has left Open. */
function deriveActionStatus_(status, tasks) {
  if (status === 'Draft' || isTerminal_(status) || !tasks.length) return status;
  return tasks.some(function (t) { return t.status !== 'Open'; }) ? 'In progress' : 'Open';
}

/** due_date_derived: the latest due date of the open tasks ('' when none has one); the stored due date without tasks. */
function derivedDue_(action, tasks) {
  if (!tasks || !tasks.length) return action.due_date || '';
  var max = '';
  tasks.forEach(function (t) { if (isTaskOpen_(t) && t.due_date && t.due_date > max) max = t.due_date; });
  return max;
}

function plantToday_() { return nowTs_().slice(0, 10); }

function cleanEstStop_(v) {
  if (v === undefined || v === null || v === '') return null;
  if (typeof v !== 'number' || !isFinite(v) || v < 0 || v > 1000) throw apiError_(ERR.BAD_REQUEST, 'Estimated stop hours must be a number from 0 to 1000, or blank.');
  return v;
}

/** A new task from the app (addTask, createAction tasks), cleaned. */
function cleanTaskInput_(input, mctx) {
  if (!plainObject_(input)) throw apiError_(ERR.BAD_REQUEST, 'Each task must be an object.');
  onlyKeys_(input, TASK_INPUT_FIELDS_, 'A task');
  var owner = cleanOwner_(input.owner, mctx);
  var needs = cleanNeedsStop_(input.needs_stop);
  var est = cleanEstStop_(input.est_stop_h);
  return {
    title: cleanText_(input.title, 'Task title', true, TASK_TITLE_MAX_), owner: owner.owner, owner_kind: owner.owner_kind,
    assignee: cleanText_(input.assignee, 'Person', false, 100), due_date: cleanDue_(input.due_date), needs_stop: needs,
    est_stop_h: needs ? est : null, notes: cleanText_(input.notes, 'Task notes', false, ACTION_LONG_TEXT_MAX_),
    template_step: cleanText_(input.template_step, 'Template step', false, TASK_TITLE_MAX_)
  };
}

function cleanTaskList_(list, mctx) {
  if (list === undefined || list === null) return null;
  if (!Array.isArray(list)) throw apiError_(ERR.BAD_REQUEST, 'Tasks must be a list.');
  if (list.length > TASKS_PER_ACTION_MAX_) throw apiError_(ERR.BAD_REQUEST, 'An action can have at most ' + TASKS_PER_ACTION_MAX_ + ' tasks.');
  return list.map(function (t) { return cleanTaskInput_(t, mctx); });
}

function newTaskRow_(actionId, seq, c, by, stamp) {
  return {
    task_id: newId_('AT-', 12), action_id: actionId, seq: seq, title: c.title, owner_kind: c.owner ? c.owner_kind : 'internal',
    owner: c.owner || '', assignee: c.assignee || '', due_date: c.due_date || '', status: 'Open', needs_stop: !!c.needs_stop,
    est_stop_h: c.needs_stop && c.est_stop_h !== null && c.est_stop_h !== undefined ? c.est_stop_h : '', notes: c.notes || '',
    template_step: c.template_step || '', created_at: stamp, created_by: by, updated_at: stamp, updated_by: by,
    done_at: '', done_by: '', done_note: ''
  };
}

function taskCreateText_(t) {
  return '#' + t.seq + ' ' + t.title + ' (' + (t.owner || 'no owner') + (t.due_date ? ', due ' + t.due_date : '') + (t.needs_stop ? ', needs a stop' : '') + ')';
}

/**
 * New task rows (and their task_create history) for an action that has `existing` tasks. skipSteps: a task whose
 * template_step the action already has is left out (applyTemplate, merged createAction).
 */
function buildTaskRows_(actionId, existing, inputs, by, stamp, skipSteps) {
  var seq = existing.reduce(function (m, t) { return Math.max(m, t.seq || 0); }, 0);
  var have = {};
  existing.forEach(function (t) { if (t.template_step) have[t.template_step] = true; });
  var rows = [], logs = [];
  inputs.forEach(function (c) {
    if (skipSteps && c.template_step && have[c.template_step]) return;
    if (c.template_step) have[c.template_step] = true;
    var row = newTaskRow_(actionId, ++seq, c, by, stamp);
    rows.push(row);
    logs.push(taskLogRow_(actionId, row.task_id, by, 'task_create', '', 'Open', taskCreateText_(row), stamp));
  });
  if (existing.length + rows.length > TASKS_PER_ACTION_MAX_) throw apiError_(ERR.BAD_REQUEST, 'An action can have at most ' + TASKS_PER_ACTION_MAX_ + ' tasks.');
  return { rows: rows, logs: logs };
}

/** The action status the tasks set, as a patch and a history row; null when it does not change. */
function followTasks_(row, tasks, by, stamp) {
  var to = deriveActionStatus_(row.status, tasks);
  if (to === row.status) return null;
  return {
    from: row.status, to: to,
    log: actionLogRow_(row.action_id, by, 'status', row.status, to, to === 'In progress' ? 'Follows the tasks: a task has started' : 'Follows the tasks: no task has started', stamp)
  };
}

// ---------- templates ----------

/** Every template with its steps, by sort order and name ([] before ensureSchema has made the sheets). */
function readTemplates_() {
  var steps = {};
  optionalTable_(T.TASK_TEMPLATE_STEPS).forEach(function (s) {
    (steps[s.template_id] = steps[s.template_id] || []).push({
      seq: s.seq, title: s.title, default_owner: s.default_owner, due_offset_days: s.due_offset_days === null ? 0 : s.due_offset_days,
      needs_stop: !!s.needs_stop, est_stop_h: s.needs_stop && s.est_stop_h !== null ? s.est_stop_h : null
    });
  });
  return optionalTable_(T.TASK_TEMPLATES).map(function (t) {
    return {
      template_id: t.template_id, name: t.name, applies_to: csv_(t.applies_to), active: !!t.active, sort_order: t.sort_order === null ? 0 : t.sort_order,
      updated_at: t.updated_at, updated_by: t.updated_by,
      steps: (steps[t.template_id] || []).sort(function (a, b) { return a.seq - b.seq; })
    };
  }).sort(function (a, b) { return (a.sort_order - b.sort_order) || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0) || (a.template_id < b.template_id ? -1 : 1); });
}

/** The active template an action source gets first (lowest sort order), or null. */
function templateForSource_(templates, source) {
  return templates.filter(function (t) { return t.active && t.applies_to.indexOf(source) >= 0; })[0] || null;
}

/** Owner of a template step for an action in `areaId`: the area's contractor, or the named active contractor or team. */
function stepOwner_(step, areaId, contractors) {
  var c = null;
  if (step.default_owner === AREA_CONTRACTOR_) c = contractorForArea_(contractors, areaId);
  else c = contractors.filter(function (x) { return x.contractor_id === step.default_owner && x.active; })[0] || null;
  return c ? { owner: c.contractor_id, owner_kind: c.kind, assignee: c.default_assignee || '' } : { owner: '', owner_kind: 'internal', assignee: '' };
}

/** Task inputs from a template's steps, due counted from `today`. */
function templateTaskInputs_(tmpl, areaId, contractors, today) {
  return tmpl.steps.map(function (s) {
    var o = stepOwner_(s, areaId, contractors);
    return {
      title: s.title, owner: o.owner, owner_kind: o.owner_kind, assignee: o.assignee, due_date: addDays_(today, s.due_offset_days || 0),
      needs_stop: !!s.needs_stop, est_stop_h: s.needs_stop ? s.est_stop_h : null, notes: '', template_step: s.title
    };
  });
}

// ---------- ready to close (the notification follows the tasks at once) ----------

function readyCandidate_(action, tasks) {
  if (action.status === 'Draft' || isTerminal_(action.status) || !tasks.length || tasks.some(isTaskOpen_)) return null;
  var n = tasks.length;
  var notNeeded = tasks.filter(function (t) { return t.status === 'Not needed'; }).length;
  var c = notifCandidate_('action_ready_to_close', 'ready|' + action.action_id + '|' + n,
    'Ready to close: ' + action.action_id + ' - ' + oneLine_(action.title, 120),
    'All ' + n + ' task' + (n === 1 ? '' : 's') + ' done or not needed (' + (n - notNeeded) + ' done, ' + notNeeded + ' not needed). ' +
      'Only the people on the "Who can close actions" list can close it.',
    action.area_id, action.line_id, action.action_id);
  c.recipients = '@closers';
  return c;
}

/**
 * Creates, re-opens or resolves the action's action_ready_to_close notification right after a task or status change.
 * Caller holds the lock. Never throws (a notification cannot fail the change it follows).
 */
function syncReadyToClose_(action, tasks) {
  try {
    if (!getSpreadsheet_().getSheetByName(T.NOTIFICATIONS)) return;
    var cand = readyCandidate_(action, tasks);
    var rows = readTable_(T.NOTIFICATIONS, function (row, idx) {
      return row[idx.type] === 'action_ready_to_close' && row[idx.source_ref] === action.action_id;
    });
    var st = notifSettings_();
    var nowMs = nowMs_();
    var stamp = fmtTsMs_(nowMs);
    rows.forEach(function (r) {
      if (r.status === 'open' && (!cand || r.dedupe_key !== cand.dedupe_key)) updateRow_(T.NOTIFICATIONS, r._row, { status: 'resolved', resolved_at: stamp });
    });
    if (!cand) return;
    var ex = rows.filter(function (r) { return r.dedupe_key === cand.dedupe_key; })[0];
    if (!ex) appendRow_(T.NOTIFICATIONS, notifRowFrom_(cand, st, nowMs));
    else if (ex.status === 'resolved') {
      updateRow_(T.NOTIFICATIONS, ex._row, { status: 'open', resolved_at: '', expires_at: fmtTsMs_(nowMs + st.retentionDays * MS_DAY_) });
    }
  } catch (err) {
    notifLogFailure_('ready to close', err);
  }
}

// ---------- notification rules (called by notifCandidates_) ----------

/** The people a task's overdue alert goes to: its person and the action owner; the closers when neither is set. */
function taskRecipients_(task, action) {
  var out = [];
  [task.assignee, action.assignee].forEach(function (p) { if (p && out.indexOf(p) < 0) out.push(p); });
  return out.length ? out.join(',') : '@closers';
}

/** task_overdue: an open task of an accepted, open action whose due date is before today (plant date). */
function notifRuleTaskOverdue_(ctx, actions, byAction) {
  var out = [];
  actions.filter(function (a) { return a.status !== 'Draft' && !isTerminal_(a.status); })
    .sort(function (a, b) { return a.action_id < b.action_id ? -1 : 1; })
    .forEach(function (a) {
      (byAction[a.action_id] || []).forEach(function (t) {
        if (!isTaskOpen_(t) || !t.due_date || !isValidDate_(t.due_date) || !(t.due_date < ctx.today)) return;
        var days = Math.round((dateMs_(ctx.today) - dateMs_(t.due_date)) / MS_DAY_);
        var c = notifCandidate_('task_overdue', 'task_due|' + t.task_id + '|' + t.due_date,
          'Task overdue: ' + a.action_id + ' - ' + oneLine_(t.title, 120),
          'Due ' + t.due_date + ', ' + days + ' day' + (days === 1 ? '' : 's') + ' ago. Task ' + t.seq + ' of ' + a.action_id + ', status ' + t.status +
            ', owner ' + (t.owner || 'nobody yet') + ', person ' + (t.assignee || 'nobody yet') + '.',
          a.area_id, a.line_id, a.action_id);
        c.recipients = taskRecipients_(t, a);
        out.push(c);
      });
    });
  return out;
}

/** action_ready_to_close for every accepted, open action whose tasks are all done or not needed. */
function notifRuleReady_(actions, byAction) {
  var out = [];
  actions.slice().sort(function (a, b) { return a.action_id < b.action_id ? -1 : 1; }).forEach(function (a) {
    var c = readyCandidate_(a, byAction[a.action_id] || []);
    if (c) out.push(c);
  });
  return out;
}

// ---------- calls ----------

function findTaskOrThrow_(taskId) {
  var id = cleanText_(taskId, 'Task', true, 40);
  var t = optionalTable_(T.ACTION_TASKS).filter(function (r) { return r.task_id === id; })[0];
  if (!t) throw apiError_(ERR.NOT_FOUND, 'Task not found.');
  return t;
}

/** { action, tasks, logs } of one action as stored now (plus `task` and `added` when given). */
function taskResult_(row, taskId, added) {
  var tasks = tasksOfAction_(row.action_id);
  var out = { action: actionOut_(row, tasks), tasks: tasks.map(taskOut_), logs: actionLogsOf_(row.action_id) };
  if (taskId) out.task = taskOut_(tasks.filter(function (t) { return t.task_id === taskId; })[0]);
  if (added !== undefined) out.added = added;
  return out;
}

/** Writes new tasks, lets the action follow, syncs the ready notification. Caller holds the lock. Returns the follow result. */
function storeNewTasks_(row, existing, built, by, stamp, extraPatch) {
  appendRows_(T.ACTION_TASKS, built.rows);
  var all = existing.concat(built.rows);
  var logs = built.logs.slice();
  var f = followTasks_(row, all, by, stamp);
  var patch = { updated_at: stamp, updated_by: by };
  Object.keys(extraPatch || {}).forEach(function (k) { patch[k] = extraPatch[k]; });
  if (f) { patch.status = f.to; logs.push(f.log); }
  updateRow_(T.ACTIONS, row._row, patch);
  appendRows_(T.ACTION_LOG, logs);
  Object.keys(patch).forEach(function (k) { row[k] = patch[k]; });
  syncReadyToClose_(row, all);
  return f;
}

/** addTask: one new task (Open) on an action that is not closed or cancelled. */
function addTask_(session, actionId, task) {
  var uid = session.user.user_id;
  return withLock_(function () {
    var stamp = nowTs_();
    var row = findActionOrThrow_(actionId);
    if (isTerminal_(row.status)) throw apiError_(ERR.BAD_REQUEST, 'The action is ' + row.status.toLowerCase() + ': reopen it before adding tasks.');
    var c = cleanTaskInput_(task, actionMasterCtx_());
    var existing = tasksOfAction_(row.action_id);
    var built = buildTaskRows_(row.action_id, existing, [c], uid, stamp, false);
    var f = storeNewTasks_(row, existing, built, uid, stamp);
    var t = built.rows[0];
    auditLog_(uid, 'create_task', T.ACTION_TASKS, t.task_id, row.action_id + ': ' + taskCreateText_(t) + (f ? '. Action status: ' + f.from + ' -> ' + f.to : ''));
    return taskResult_(row, t.task_id);
  });
}

/**
 * updateTask: changes one task. Done needs a note (what was done), Not needed a reason (3+ characters); Contractor informed only
 * for an external contractor's task. On a closed or cancelled action only a note may be added.
 */
function updateTask_(session, taskId, changes) {
  requireObject_(changes, 'Changes');
  onlyKeys_(changes, TASK_CHANGE_FIELDS_, 'Changes');
  if (!Object.keys(changes).length) throw apiError_(ERR.BAD_REQUEST, 'No changes to save.');
  var uid = session.user.user_id;
  return withLock_(function () {
    var stamp = nowTs_();
    var task = findTaskOrThrow_(taskId);
    var row = findActionOrThrow_(task.action_id);
    var has = function (k) { return Object.prototype.hasOwnProperty.call(changes, k); };
    if (isTerminal_(row.status) && Object.keys(changes).some(function (k) { return k !== 'note'; })) {
      throw apiError_(ERR.BAD_REQUEST, 'The action is ' + row.status.toLowerCase() + ': reopen it before changing its tasks. A note can still be added.');
    }
    var next = {};
    if (has('title')) next.title = cleanText_(changes.title, 'Task title', true, TASK_TITLE_MAX_);
    if (has('assignee')) next.assignee = cleanText_(changes.assignee, 'Person', false, 100);
    if (has('due_date')) next.due_date = cleanDue_(changes.due_date);
    if (has('notes')) next.notes = cleanText_(changes.notes, 'Task notes', false, ACTION_LONG_TEXT_MAX_);
    if (has('owner')) {
      var ow = cleanOwner_(changes.owner, actionMasterCtx_());
      next.owner = ow.owner;
      next.owner_kind = ow.owner_kind;
    }
    if (has('needs_stop')) next.needs_stop = cleanNeedsStop_(changes.needs_stop);
    if (has('est_stop_h')) next.est_stop_h = cleanEstStop_(changes.est_stop_h);
    var to = has('status') ? pickEnum_(changes.status, taskEnum_('status'), 'Task status') : task.status;
    var note = has('note') ? cleanText_(changes.note, 'Note', false, ACTION_LONG_TEXT_MAX_) : '';
    var ownerKind = next.owner_kind !== undefined ? next.owner_kind : task.owner_kind;
    var from = task.status;
    if (to === 'Contractor informed' && ownerKind !== 'contractor') {
      throw apiError_(ERR.BAD_REQUEST, 'Contractor informed is only for a task owned by an external contractor.');
    }
    if (to !== from && to === 'Done' && note.length < TASK_NOTE_MIN_) throw apiError_(ERR.BAD_REQUEST, 'Write what was done (at least ' + TASK_NOTE_MIN_ + ' characters).');
    if (to !== from && to === 'Not needed' && note.length < TASK_NOTE_MIN_) throw apiError_(ERR.BAD_REQUEST, 'Write why the task is not needed (at least ' + TASK_NOTE_MIN_ + ' characters).');
    var needsAfter = next.needs_stop !== undefined ? next.needs_stop : !!task.needs_stop;
    var estBefore = taskOut_(task).est_stop_h;
    if (has('needs_stop') || has('est_stop_h')) next.est_stop_h = needsAfter ? (has('est_stop_h') ? next.est_stop_h : estBefore) : null;

    var patch = {}, edits = [];
    ['title', 'owner', 'assignee', 'due_date', 'needs_stop', 'est_stop_h', 'notes'].forEach(function (k) {
      if (next[k] === undefined) return;
      var old = k === 'est_stop_h' ? estBefore : task[k];
      if (next[k] === old) return;
      patch[k] = k === 'est_stop_h' && next[k] === null ? '' : next[k];
      if (k === 'owner') patch.owner_kind = next.owner_kind;
      edits.push(k === 'title' || k === 'notes' ? k + ' changed' : k + ': ' + logValue_(old) + ' -> ' + logValue_(next[k]));
    });
    var logs = [];
    if (to !== from) {
      patch.status = to;
      if (TASK_CLOSED_.indexOf(to) >= 0) { patch.done_at = stamp; patch.done_by = uid; patch.done_note = note; }
      else if (TASK_CLOSED_.indexOf(from) >= 0) { patch.done_at = ''; patch.done_by = ''; patch.done_note = ''; }
      logs.push(taskLogRow_(row.action_id, task.task_id, uid, 'task_status', from, to, note, stamp));
    } else if (note) {
      logs.push(taskLogRow_(row.action_id, task.task_id, uid, 'task_note', '', '', note, stamp));
    }
    if (edits.length) logs.push(taskLogRow_(row.action_id, task.task_id, uid, 'task_edit', '', '', '#' + task.seq + ' ' + edits.join('; '), stamp));
    if (!logs.length) throw apiError_(ERR.BAD_REQUEST, 'Nothing was changed.');
    patch.updated_at = stamp;
    patch.updated_by = uid;
    updateRow_(T.ACTION_TASKS, task._row, patch);
    Object.keys(patch).forEach(function (k) { task[k] = patch[k]; });

    var all = tasksOfAction_(row.action_id).map(function (t) { return t.task_id === task.task_id ? task : t; });
    var f = followTasks_(row, all, uid, stamp);
    var apatch = { updated_at: stamp, updated_by: uid };
    if (f) { apatch.status = f.to; logs.push(f.log); }
    updateRow_(T.ACTIONS, row._row, apatch);
    appendRows_(T.ACTION_LOG, logs);
    Object.keys(apatch).forEach(function (k) { row[k] = apatch[k]; });
    syncReadyToClose_(row, all);

    var said = [];
    if (to !== from) said.push('status: ' + from + ' -> ' + to + (note ? ' (' + auditValue_(note, 80) + ')' : ''));
    else if (note) said.push('note: ' + auditValue_(note, 160));
    if (edits.length) said.push(edits.join('; '));
    if (f) said.push('action status: ' + f.from + ' -> ' + f.to);
    auditLog_(uid, 'update_task', T.ACTION_TASKS, task.task_id, row.action_id + ' #' + task.seq + ': ' + said.join('; '));
    return taskResult_(row, task.task_id);
  });
}

/** applyTemplate: adds the template's steps the action does not have yet (by template_step), due from today. */
function applyTemplate_(session, actionId, templateId) {
  var uid = session.user.user_id;
  var tid = cleanText_(templateId, 'Template', true, 40);
  return withLock_(function () {
    var stamp = nowTs_();
    var row = findActionOrThrow_(actionId);
    if (isTerminal_(row.status)) throw apiError_(ERR.BAD_REQUEST, 'The action is ' + row.status.toLowerCase() + ': reopen it before adding tasks.');
    var tmpl = readTemplates_().filter(function (t) { return t.template_id === tid; })[0];
    if (!tmpl) throw apiError_(ERR.NOT_FOUND, 'Task template not found.');
    if (!tmpl.active) throw apiError_(ERR.BAD_REQUEST, 'The template "' + tmpl.name + '" is switched off.');
    var existing = tasksOfAction_(row.action_id);
    var inputs = templateTaskInputs_(tmpl, row.area_id, optionalTable_(T.CONTRACTORS), stamp.slice(0, 10));
    var built = buildTaskRows_(row.action_id, existing, inputs, uid, stamp, true);
    if (!built.rows.length) return taskResult_(row, '', 0);
    var f = storeNewTasks_(row, existing, built, uid, stamp, row.template_id ? {} : { template_id: tmpl.template_id });
    auditLog_(uid, 'apply_template', T.ACTIONS, row.action_id, 'Template ' + tmpl.name + ': ' + built.rows.length + ' task' + (built.rows.length === 1 ? '' : 's') +
      ' added (' + built.rows.map(function (t) { return t.title; }).join(', ') + ')' + (f ? '. Action status: ' + f.from + ' -> ' + f.to : ''));
    return taskResult_(row, '', built.rows.length);
  });
}

function cleanTaskFilter_(filter) {
  var f = filter === undefined || filter === null ? {} : filter;
  requireObject_(f, 'Filter');
  onlyKeys_(f, TASK_FILTER_FIELDS_, 'Filter');
  ['mine', 'overdue', 'needs_stop', 'include_drafts'].forEach(function (k) {
    if (f[k] !== undefined && f[k] !== null && typeof f[k] !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'Filter ' + k + ' must be true or false.');
  });
  var status = f.status === undefined || f.status === null || f.status === '' ? 'open' : f.status;
  if (Array.isArray(status)) {
    var allowed = taskEnum_('status');
    status.forEach(function (s) { if (allowed.indexOf(s) < 0) throw apiError_(ERR.BAD_REQUEST, 'Filter status must be one of: ' + allowed.join(', ') + '.'); });
  } else if (['open', 'closed', 'all'].indexOf(status) < 0) {
    throw apiError_(ERR.BAD_REQUEST, 'Filter status must be open, closed, all or a list of task statuses.');
  }
  var out = { mine: f.mine === true, overdue: f.overdue === true, needs_stop: f.needs_stop === true, include_drafts: f.include_drafts === true, status: status };
  ['owner', 'assignee', 'area_id', 'line_id', 'action_id'].forEach(function (k) { out[k] = cleanText_(f[k] === null ? '' : f[k], 'Filter ' + k, false, 100); });
  out.done_since = cleanText_(f.done_since === null ? '' : f.done_since, 'Filter done_since', false, 20);
  if (out.done_since && !isValidDate_(out.done_since)) throw apiError_(ERR.BAD_REQUEST, 'Filter done_since must be a date like 2026-07-01.');
  return out;
}

/** listTasks: tasks across the actions, filtered (see TaskFilter in src/api/types.ts), overdue first, then by due date. */
function listTasks_(session, filter) {
  var f = cleanTaskFilter_(filter);
  var today = plantToday_();
  var actions = {};
  optionalTable_(T.ACTIONS).forEach(function (a) { actions[a.action_id] = a; });
  var waiting = {};
  optionalTable_(T.ACTION_LOG).forEach(function (l) {
    if (l.kind === 'task_status' && l.to_status === 'Waiting stoppage' && l.task_id && !(waiting[l.task_id] > l.at)) waiting[l.task_id] = l.at;
  });
  var uid = session.user.user_id;
  var out = [];
  readAllTasks_().forEach(function (t) {
    var a = actions[t.action_id];
    if (!a || a.status === 'Cancelled' || (a.status === 'Draft' && !f.include_drafts)) return;
    var open = isTaskOpen_(t);
    if (f.status === 'open' && !open) return;
    if (f.status === 'closed' && open) return;
    if (Array.isArray(f.status) && f.status.indexOf(t.status) < 0) return;
    var overdue = open && !!t.due_date && t.due_date < today;
    if (f.mine && t.assignee !== uid) return;
    if (f.overdue && !overdue) return;
    if (f.needs_stop && !t.needs_stop) return;
    if (f.owner && t.owner !== f.owner) return;
    if (f.assignee && t.assignee !== f.assignee) return;
    if (f.area_id && a.area_id !== f.area_id) return;
    if (f.line_id && a.line_id !== f.line_id) return;
    if (f.action_id && t.action_id !== f.action_id) return;
    if (f.done_since && !(String(t.done_at).slice(0, 10) >= f.done_since)) return;
    var v = taskOut_(t);
    v.action_title = a.title;
    v.action_status = a.status;
    v.action_assignee = a.assignee;
    v.action_owner = a.owner;
    v.area_id = a.area_id;
    v.line_id = a.line_id;
    v.equipment_id = a.equipment_id;
    v.overdue = overdue;
    v.waiting_since = t.status === 'Waiting stoppage' ? (waiting[t.task_id] || t.updated_at) : '';
    out.push(v);
  });
  out.sort(function (a, b) {
    if (a.overdue !== b.overdue) return a.overdue ? -1 : 1;
    if (a.due_date !== b.due_date) return !a.due_date ? 1 : !b.due_date ? -1 : a.due_date < b.due_date ? -1 : 1;
    return byTask_(a, b);
  });
  return { tasks: out, today: today };
}

function listTaskTemplates_() { return readTemplates_(); }

function cleanTemplateStep_(s, mctx, label) {
  if (!plainObject_(s)) throw apiError_(ERR.BAD_REQUEST, label + ': each task must be an object.');
  onlyKeys_(s, ['seq', 'title', 'default_owner', 'due_offset_days', 'needs_stop', 'est_stop_h'], label + ': a task');
  var title = cleanText_(s.title, label + ': task title', true, TASK_TITLE_MAX_);
  var owner = cleanText_(s.default_owner, label + ': default owner', true, 40);
  if (owner !== AREA_CONTRACTOR_) {
    var c = mctx.contractors[owner];
    if (!c || !c.active) throw apiError_(ERR.BAD_REQUEST, label + ': default owner "' + oneLine_(owner, 40) + '" is not area_contractor or an active contractor or team.');
  }
  var days = s.due_offset_days === undefined || s.due_offset_days === null ? 0 : s.due_offset_days;
  if (typeof days !== 'number' || days % 1 !== 0 || days < 0 || days > 365) throw apiError_(ERR.BAD_REQUEST, label + ': due after must be a whole number of days from 0 to 365.');
  var needs = cleanNeedsStop_(s.needs_stop);
  var est = cleanEstStop_(s.est_stop_h);
  return { title: title, default_owner: owner, due_offset_days: days, needs_stop: needs, est_stop_h: needs ? est : null };
}

/**
 * saveTaskTemplates: inserts or updates the templates sent (template_id blank = new) and replaces their steps. Names are unique;
 * an action source belongs to at most one active template. Templates are never deleted (switch one off). Returns all.
 */
function saveTaskTemplates_(session, list) {
  if (!Array.isArray(list) || !list.length) throw apiError_(ERR.BAD_REQUEST, 'Send at least one template.');
  if (list.length > TEMPLATES_MAX_) throw apiError_(ERR.BAD_REQUEST, 'At most ' + TEMPLATES_MAX_ + ' templates at once.');
  var mctx = actionMasterCtx_();
  var sources = actionEnum_('source');
  var seenIds = {};
  var clean = list.map(function (t) {
    if (!plainObject_(t)) throw apiError_(ERR.BAD_REQUEST, 'Each template must be an object.');
    onlyKeys_(t, ['template_id', 'name', 'applies_to', 'active', 'sort_order', 'steps', 'updated_at', 'updated_by'], 'A template');
    var id = cleanText_(t.template_id === null ? '' : t.template_id, 'Template id', false, 40);
    if (id && !/^TT-[A-Za-z0-9_-]{1,37}$/.test(id)) throw apiError_(ERR.BAD_REQUEST, 'A template id must look like TT-REPEAT.');
    if (id && seenIds[id]) throw apiError_(ERR.BAD_REQUEST, 'Template ' + id + ' is listed twice.');
    if (id) seenIds[id] = true;
    var name = cleanText_(t.name, 'Template name', true, 80);
    if (!Array.isArray(t.applies_to)) throw apiError_(ERR.BAD_REQUEST, name + ': "suggested first for" must be a list.');
    var applies = [];
    t.applies_to.forEach(function (s) {
      if (sources.indexOf(s) < 0) throw apiError_(ERR.BAD_REQUEST, name + ': "' + oneLine_(s, 40) + '" is not an action source.');
      if (applies.indexOf(s) < 0) applies.push(s);
    });
    if (typeof t.active !== 'boolean') throw apiError_(ERR.BAD_REQUEST, name + ': active must be true or false.');
    var order = t.sort_order === undefined || t.sort_order === null ? 0 : t.sort_order;
    if (typeof order !== 'number' || order % 1 !== 0 || order < 0 || order > 1000) throw apiError_(ERR.BAD_REQUEST, name + ': sort order must be a whole number from 0 to 1000.');
    if (!Array.isArray(t.steps) || !t.steps.length) throw apiError_(ERR.BAD_REQUEST, name + ': add at least one task.');
    if (t.steps.length > TEMPLATE_STEPS_MAX_) throw apiError_(ERR.BAD_REQUEST, name + ': at most ' + TEMPLATE_STEPS_MAX_ + ' tasks.');
    var titles = {};
    var steps = t.steps.map(function (s) {
      var c = cleanTemplateStep_(s, mctx, name);
      var k = c.title.toLowerCase();
      if (titles[k]) throw apiError_(ERR.BAD_REQUEST, name + ': the task "' + c.title + '" is listed twice.');
      titles[k] = true;
      return c;
    });
    return { template_id: id, name: name, applies_to: applies, active: t.active, sort_order: order, steps: steps };
  });
  var uid = session.user.user_id;
  withLock_(function () {
    var stamp = nowTs_();
    var existing = optionalTable_(T.TASK_TEMPLATES);
    var before = readTemplates_();
    var byId = {};
    existing.forEach(function (r) { byId[r.template_id] = r; });
    clean.forEach(function (c) {
      if (c.template_id && !byId[c.template_id]) throw apiError_(ERR.NOT_FOUND, 'Template ' + c.template_id + ' not found.');
      if (!c.template_id) { do { c.template_id = 'TT-' + randomHex_(8).toUpperCase(); } while (byId[c.template_id]); }
    });
    // the state after saving: names unique, a source in at most one active template
    var after = {};
    before.forEach(function (t) { after[t.template_id] = t; });
    clean.forEach(function (c) { after[c.template_id] = c; });
    var names = {}, owners = {};
    Object.keys(after).sort().forEach(function (id) {
      var t = after[id];
      var k = t.name.toLowerCase();
      if (names[k] && names[k] !== id) throw apiError_(ERR.CONFLICT, 'Two templates would be called "' + t.name + '".');
      names[k] = id;
      if (!t.active) return;
      t.applies_to.forEach(function (s) {
        if (owners[s] && owners[s] !== id) throw apiError_(ERR.CONFLICT, 'Source ' + s + ' would be suggested by both "' + after[owners[s]].name + '" and "' + t.name + '".');
        owners[s] = id;
      });
    });
    var said = [];
    var stepRows = optionalTable_(T.TASK_TEMPLATE_STEPS);
    var drop = [];
    var fresh = [];
    clean.forEach(function (c) {
      var ex = byId[c.template_id];
      var rec = { template_id: c.template_id, name: c.name, applies_to: c.applies_to.join(','), active: c.active, sort_order: c.sort_order, updated_at: stamp, updated_by: uid };
      if (ex) updateRow_(T.TASK_TEMPLATES, ex._row, rec); else appendRow_(T.TASK_TEMPLATES, rec);
      stepRows.forEach(function (s) { if (s.template_id === c.template_id) drop.push(s._row); });
      c.steps.forEach(function (s, i) {
        fresh.push({ template_id: c.template_id, seq: i + 1, title: s.title, default_owner: s.default_owner, due_offset_days: s.due_offset_days,
          needs_stop: s.needs_stop, est_stop_h: s.est_stop_h === null ? '' : s.est_stop_h });
      });
      var stepText = function (list) {
        return list.map(function (s) { return s.title + ' (' + s.default_owner + ', +' + s.due_offset_days + ' d' + (s.needs_stop ? ', stop' + (s.est_stop_h !== null ? ' ' + s.est_stop_h + ' h' : '') : '') + ')'; }).join(', ');
      };
      var old = before.filter(function (t) { return t.template_id === c.template_id; })[0];
      if (!old) {
        said.push(c.template_id + ' added: ' + c.name + ' (' + c.steps.length + ' tasks: ' + stepText(c.steps) + ')');
        return;
      }
      var what = auditChanges_({ name: old.name, applies_to: old.applies_to.join(','), active: old.active, sort_order: old.sort_order },
        { name: c.name, applies_to: c.applies_to.join(','), active: c.active, sort_order: c.sort_order }, ['name', 'applies_to', 'active', 'sort_order'], 80);
      var oldSteps = stepText(old.steps), newSteps = stepText(c.steps);
      if (oldSteps !== newSteps) what = (what ? what + '; ' : '') + 'tasks: ' + auditValue_(oldSteps, 150) + ' -> ' + auditValue_(newSteps, 150);
      if (what) said.push(c.template_id + ' ' + what);
    });
    if (drop.length) deleteRows_(T.TASK_TEMPLATE_STEPS, drop);
    appendRows_(T.TASK_TEMPLATE_STEPS, fresh);
    auditLog_(uid, 'save_task_templates', T.TASK_TEMPLATES, clean.map(function (c) { return c.template_id; }).join(','), said.join('. ') || 'No change');
  });
  return readTemplates_();
}

// ---------- seeding and the 1.7.0 migration (run from the editor through seedDefaults) ----------

/** Adds the seeded templates whose id is missing (with their steps). Never touches an existing template. Caller holds the lock. */
function seedTaskTemplates_(seeds) {
  var ss = getSpreadsheet_();
  if (!ss.getSheetByName(T.TASK_TEMPLATES) || !ss.getSheetByName(T.TASK_TEMPLATE_STEPS)) return 0;
  var have = {};
  readTable_(T.TASK_TEMPLATES).forEach(function (t) { have[t.template_id] = true; });
  var stamp = nowTs_();
  var fresh = (seeds || []).filter(function (t) { return !have[t.template_id]; });
  appendRows_(T.TASK_TEMPLATES, fresh.map(function (t) {
    return { template_id: t.template_id, name: t.name, applies_to: t.applies_to, active: t.active, sort_order: t.sort_order, updated_at: stamp, updated_by: 'setup' };
  }));
  var steps = [];
  fresh.forEach(function (t) {
    t.steps.forEach(function (s, i) {
      steps.push({ template_id: t.template_id, seq: i + 1, title: s.title, default_owner: s.default_owner, due_offset_days: s.due_offset_days,
        needs_stop: !!s.needs_stop, est_stop_h: s.est_stop_h === null || s.est_stop_h === undefined ? '' : s.est_stop_h });
    });
  });
  appendRows_(T.TASK_TEMPLATE_STEPS, steps);
  return fresh.length;
}

/**
 * The 1.7.0 move of the old action statuses to tasks. Runs once (Script Property ACTIONS_TASKS_MIGRATED), from seedDefaults,
 * after ensureSchema has made the action_tasks sheet. Every action in Contractor informed, Waiting stoppage or In progress that
 * has no task yet becomes In progress with ONE task carrying the old status (title from required_action, else the title; owner,
 * person, due date and the stop need from the action; Waiting stoppage also marks the task as needing a stop; Contractor
 * informed on an action owned by an internal team becomes In progress). Draft, Open, Closed and Cancelled stay as they are.
 * Safe to run again: it does nothing once done, and an action that already has tasks is never touched.
 */
function migrateActions_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty(PROP.TASKS_MIGRATED)) return { migrated: 0, note: 'already done' };
  var ss = getSpreadsheet_();
  if (!ss.getSheetByName(T.ACTIONS) || !ss.getSheetByName(T.ACTION_TASKS) || !ss.getSheetByName(T.ACTION_LOG)) {
    return { migrated: 0, note: 'Run ensureSchema first, then seedDefaults again.' };
  }
  return withLock_(function () {
    var stamp = nowTs_();
    var have = {};
    readTable_(T.ACTION_TASKS).forEach(function (t) { have[t.action_id] = true; });
    var OLD = ['Contractor informed', 'Waiting stoppage', 'In progress'];
    var rows = [], logs = [], patches = [], said = [];
    readTable_(T.ACTIONS).forEach(function (a) {
      if (OLD.indexOf(a.status) < 0 || have[a.action_id]) return;
      var status = a.status === 'Contractor informed' && !(a.owner && a.owner_kind === 'contractor') ? 'In progress' : a.status;
      var t = newTaskRow_(a.action_id, 1, {
        title: oneLine_(a.required_action || a.title, TASK_TITLE_MAX_) || 'Task', owner: a.owner || '', owner_kind: a.owner ? a.owner_kind : 'internal',
        assignee: a.assignee || '', due_date: isValidDate_(a.due_date) ? a.due_date : '', needs_stop: !!a.needs_stop || a.status === 'Waiting stoppage',
        est_stop_h: null, notes: 'Made from the action status "' + a.status + '" when tasks came in (backend 1.7.0).', template_step: ''
      }, 'system', stamp);
      t.status = status;
      rows.push(t);
      logs.push(taskLogRow_(a.action_id, t.task_id, 'system', 'task_create', '', status, taskCreateText_(t) + ' from the action status ' + a.status, stamp));
      if (a.status !== 'In progress') {
        patches.push({ row: a, patch: { status: 'In progress', updated_at: stamp, updated_by: 'system' } });
        logs.push(actionLogRow_(a.action_id, 'system', 'status', a.status, 'In progress', 'Moved to tasks (backend 1.7.0): the old status is now on task 1', stamp));
      }
      said.push(a.action_id + ' (' + a.status + ')');
    });
    appendRows_(T.ACTION_TASKS, rows);
    patches.forEach(function (p) { updateRow_(T.ACTIONS, p.row._row, p.patch); });
    appendRows_(T.ACTION_LOG, logs);
    if (said.length) auditLog_('setup', 'migrate_actions', T.ACTIONS, '', 'Moved ' + said.length + ' action(s) to tasks: ' + said.join(', '));
    props.setProperty(PROP.TASKS_MIGRATED, stamp);
    return { migrated: said.length, actions: said };
  });
}

// ======================================================================
// Upload.js
// ======================================================================
/**
 * Upload (docs/wire-protocol.md section 5). Chunks are idempotent: the server
 * recomputes every fingerprint and skips rows that already exist.
 *
 * Occurrence number (the last part of the fingerprint): the browser counts
 * identical rows in file order. The server accepts that number only when the
 * fingerprint the browser sent really equals the hash of the server's own
 * values plus that number (so nothing is trusted). Without a matching
 * fingerprint it counts for itself: rows of the same key already stored in this
 * batch (earlier chunks) plus earlier rows of the same key in this chunk; a row
 * whose source_row is already stored in the batch is a retry, not a new copy.
 */

function enumOf_(table, column) {
  return tableDef_(table).columns.filter(function (c) { return c.name === column; })[0].enum;
}

function batchOrThrow_(batchId) {
  var b = typeof batchId === 'string' ? findBy_(T.BATCHES, 'batch_id', batchId) : null;
  if (!b) throw apiError_(ERR.NOT_FOUND, 'Upload not found.');
  return b;
}

function uploadStart_(session, fileName, fileHash, kind) {
  var name = cleanText_(fileName, 'File name', false, 200);
  var hash = cleanText_(fileHash, 'File hash', false, 128);
  // 2.2.0: a history import (date-only stops from the NRS workbook) is for the Admin role only
  var k = kind === undefined || kind === null || kind === '' ? 'monthly' : String(kind);
  if (k !== 'monthly' && k !== 'history') throw apiError_(ERR.BAD_REQUEST, 'Kind must be monthly or history.');
  if (k === 'history' && !isAdmin_(session)) throw apiError_(ERR.FORBIDDEN, 'Only an Admin can import history.');
  return withLock_(function () {
    var id = 'B-' + compactTs_('yyyyMMdd-HHmmss') + '-' + randomHex_(4);
    appendRow_(T.BATCHES, {
      batch_id: id, uploaded_by: session.user.user_id, uploaded_at: nowTs_(), file_name: name, file_hash: hash,
      rows_read: 0, rows_added: 0, rows_identical: 0, rows_skipped: 0, warning_count: 0, status: 'Started', kind: k
    });
    auditLog_(session.user.user_id, 'upload_start', T.BATCHES, id, name);
    return { batch_id: id };
  });
}

function fingerprintOf_(key, occurrence) { return sha256Hex_(key + '|' + occurrence); }

/** The occurrence number the browser used, if its fingerprint verifies; otherwise 0. */
function verifiedHint_(key, clientFingerprint) {
  if (typeof clientFingerprint !== 'string' || !/^[0-9a-f]{64}$/.test(clientFingerprint)) return 0;
  for (var n = 1; n <= FINGERPRINT_HINT_MAX; n++) if (fingerprintOf_(key, n) === clientFingerprint) return n;
  return 0;
}

function uploadChunk_(session, batchId, rows) {
  if (!Array.isArray(rows)) throw apiError_(ERR.BAD_REQUEST, 'Rows must be a list.');
  if (rows.length > UPLOAD_CHUNK_MAX_ROWS) throw apiError_(ERR.BAD_REQUEST, 'Too many rows in one chunk (limit ' + UPLOAD_CHUNK_MAX_ROWS + ').');
  return withLock_(function () {
    var batch = batchOrThrow_(batchId);
    if (batch.status !== 'Started') throw apiError_(ERR.CONFLICT, 'This upload is already finished.');
    var ctx = eventContext_();
    var known = {}, inBatch = {};
    var fps = readColumn_(T.EVENTS, 'fingerprint'), bids = readColumn_(T.EVENTS, 'batch_id'), srcs = readColumn_(T.EVENTS, 'source_row');
    for (var i = 0; i < fps.length; i++) {
      known[fps[i]] = true;
      if (bids[i] === batch.batch_id) inBatch[fps[i]] = srcs[i];
    }

    var base = {}, extra = {}, fresh = [], rejected = [], identical = 0;
    rows.forEach(function (row) {
      var norm = normalizeEvent_(ctx, row);
      if (norm.error) {
        rejected.push({ source_row: toIntOr_(row && row.source_row, 0), reason: norm.error });
        return;
      }
      var rec = norm.rec; // a row with a data problem is stored with flags, never dropped
      var key = rec.area_id + '|' + rec.code_key + '|' + rec.stop_ts + '|' + rec.start_ts;
      var srcRow = toIntOr_(row.source_row, null);
      var n = verifiedHint_(key, row.fingerprint);
      if (!n) {
        // Source rows of this key already stored in this batch, in occurrence order.
        if (!base[key]) {
          base[key] = [];
          while (Object.prototype.hasOwnProperty.call(inBatch, fingerprintOf_(key, base[key].length + 1))) {
            base[key].push(inBatch[fingerprintOf_(key, base[key].length + 1)]);
          }
        }
        var at = srcRow === null ? -1 : base[key].indexOf(srcRow);
        if (at >= 0) n = at + 1; // the same file row sent again (a retry)
        else { extra[key] = (extra[key] || 0) + 1; n = base[key].length + extra[key]; }
      }
      var fp = fingerprintOf_(key, n);
      if (known[fp]) { identical++; return; }
      known[fp] = true;
      delete rec.code_key;
      rec.event_id = 'EV-' + fp.slice(0, 16);
      rec.batch_id = batch.batch_id;
      rec.source_file = batch.file_name;
      rec.source_row = srcRow;
      rec.fingerprint = fp;
      rec.edited = false;
      rec.is_void = false;
      rec.created_at = nowTs_();
      if (batch.kind === 'history') { rec.origin = 'history'; rec.time_precision = 'day'; }
      fresh.push(rec);
    });
    appendRows_(T.EVENTS, fresh);
    updateRow_(T.BATCHES, batch._row, { rows_added: batch.rows_added + fresh.length, rows_identical: batch.rows_identical + identical });
    auditLog_(session.user.user_id, 'upload_chunk', T.BATCHES, batch.batch_id,
      'Added ' + fresh.length + ', identical ' + identical + ', rejected ' + rejected.length);
    return { added: fresh.length, identical: identical, rejected: rejected };
  });
}

function cleanWarning_(w, batchId, n, userId) {
  requireObject_(w, 'Warning');
  if (enumOf_(T.WARNINGS, 'type').indexOf(w.type) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown warning type.');
  var resolution = w.resolution ? String(w.resolution) : '';
  if (resolution && enumOf_(T.WARNINGS, 'resolution').indexOf(resolution) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown warning resolution.');
  return {
    warning_id: 'W-' + batchId + '-' + n, batch_id: batchId, type: w.type,
    source_row: toIntOr_(w.source_row, null), event_id: cleanText_(w.event_id, 'Event', false, 60),
    detail: cleanText_(w.detail, 'Detail', false), resolution: resolution, resolved_by: resolution ? userId : ''
  };
}

function nonNegInt_(v, label) {
  if (typeof v !== 'number' || v < 0 || Math.floor(v) !== v) throw apiError_(ERR.BAD_REQUEST, label + ' must be a whole number.');
  return v;
}

function uploadFinish_(session, batchId, summary, warnings) {
  requireObject_(summary, 'Summary');
  var read = nonNegInt_(summary.rows_read, 'Rows read');
  var skipped = nonNegInt_(summary.rows_skipped, 'Rows skipped');
  if (!Array.isArray(warnings)) throw apiError_(ERR.BAD_REQUEST, 'Warnings must be a list.');
  if (warnings.length > UPLOAD_WARNING_MAX) throw apiError_(ERR.BAD_REQUEST, 'Too many warnings (limit ' + UPLOAD_WARNING_MAX + ').');
  var fresh = false;
  var finished = withLock_(function () {
    var batch = batchOrThrow_(batchId);
    if (batch.status === 'Completed') return batch; // finishing twice changes nothing
    if (batch.status !== 'Started') throw apiError_(ERR.CONFLICT, 'This upload cannot be finished.');
    var rows = warnings.map(function (w, i) { return cleanWarning_(w, batch.batch_id, i + 1, session.user.user_id); });
    var added = readColumn_(T.EVENTS, 'batch_id').filter(function (b) { return b === batch.batch_id; }).length;
    var identical = Math.max(0, Math.min(batch.rows_identical, read - added - skipped));
    appendRows_(T.WARNINGS, rows);
    updateRow_(T.BATCHES, batch._row, {
      rows_read: read, rows_added: added, rows_identical: identical, rows_skipped: skipped,
      warning_count: rows.length, status: 'Completed'
    });
    // 1.6.0: the file name and the decisions taken in the review (late months added or skipped, changed rows ...)
    var decided = {};
    rows.forEach(function (w) { if (w.resolution) { var k = w.type + ' ' + w.resolution; decided[k] = (decided[k] || 0) + 1; } });
    var decisions = Object.keys(decided).sort().map(function (k) { return k + ' ' + decided[k]; }).join(', ');
    auditLog_(session.user.user_id, 'upload_finish', T.BATCHES, batch.batch_id,
      'File ' + auditValue_(batch.file_name, 120) + '. Read ' + read + ', added ' + added + ', identical ' + identical + ', skipped ' + skipped +
      ', warnings ' + rows.length + (decisions ? '. Decisions: ' + decisions : ''));
    fresh = true;
    return readRowAt_(T.BATCHES, batch._row);
  });
  // Alerts and the 'upload done' update. Best effort: a failure here never fails the upload.
  if (fresh) notifyAfterUpload_(finished);
  return finished;
}

function getUploadHistory_() {
  return readTable_(T.BATCHES).sort(function (a, b) { return a.uploaded_at < b.uploaded_at ? 1 : (a.uploaded_at > b.uploaded_at ? -1 : 0); });
}

function getUploadWarnings_(batchId) {
  var id = cleanText_(batchId, 'Upload', true, 60);
  return readTable_(T.WARNINGS, function (row, idx) { return row[idx.batch_id] === id; });
}

// ======================================================================
// Users.js
// ======================================================================
/** User administration. Passwords never leave the server except the one-time temp password. */

var EMAIL_PATTERN_ = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

function adminUser_(u, accessRows) {
  var a = publicUser_(u);
  a.active = u.active;
  a.must_change = u.must_change;
  a.last_login_at = u.last_login_at || undefined;
  a.overrides = userOverrides_(u.user_id, accessRows);
  return a;
}

function listUsers_() {
  var rows = readTable_(T.TAB_ACCESS);
  return readUsers_().map(function (u) { return adminUser_(u, rows); });
}

function requireRole_(roleId) {
  if (!findBy_(T.ROLES, 'role_id', roleId)) throw apiError_(ERR.BAD_REQUEST, 'That role does not exist.');
}

function userOrThrow_(userId) {
  var u = typeof userId === 'string' ? findUserById_(userId) : null;
  if (!u) throw apiError_(ERR.NOT_FOUND, 'User not found.');
  return u;
}

/**
 * 1.10.0: only an Admin manages Admins. A person with Edit on the Users tab who is not an Admin may not create an Admin,
 * give the Admin role, or change, reset, sign out or set the access of an Admin. `what` ends the sentence.
 */
function requireAdminFor_(session, isAdminTarget, what) {
  if (isAdminTarget && session.user.role_id !== 'ROLE-ADMIN') {
    throw apiError_(ERR.FORBIDDEN, 'Only an Admin can ' + what + '.');
  }
}

function activeAdminCount_(exceptUserId) {
  return readUsers_().filter(function (u) {
    return u.active && u.role_id === 'ROLE-ADMIN' && u.user_id !== exceptUserId;
  }).length;
}

/** Insert a user row (caller holds the lock). Returns the stored row. */
function insertUser_(email, displayName, roleId, tempPassword, createdBy) {
  var c = newCredentials_(tempPassword);
  var row = {
    user_id: newId_('U-', 12), email: email, display_name: displayName, role_id: roleId,
    password_hash: c.password_hash, password_salt: c.password_salt, hash_rounds: c.hash_rounds,
    must_change: true, active: true, failed_attempts: 0, locked_until: '',
    created_at: nowTs_(), last_login_at: '', created_by: createdBy
  };
  appendRow_(T.USERS, row);
  return row;
}

function createUser_(session, u) {
  requireObject_(u, 'User details');
  var email = normEmail_(u.email);
  if (!EMAIL_PATTERN_.test(email) || email.length > 200) throw apiError_(ERR.BAD_REQUEST, 'Enter a valid email address.');
  var name = cleanText_(u.display_name, 'Name', true, 100);
  var roleId = cleanText_(u.role_id, 'Role', true, 50);
  requireRole_(roleId);
  requireAdminFor_(session, roleId === 'ROLE-ADMIN', 'create an Admin');
  var temp = generateTempPassword_();
  var created = withLock_(function () {
    if (findUserByEmail_(email)) throw apiError_(ERR.CONFLICT, 'A user with this email already exists.');
    var row = insertUser_(email, name, roleId, temp, session.user.user_id);
    auditLog_(session.user.user_id, 'create_user', T.USERS, row.user_id, email + ' as ' + roleId);
    return row;
  });
  notifyUserEvent_('created', session.user, created, 'with role ' + roleId);
  return { user: adminUser_(created, readTable_(T.TAB_ACCESS)), temp_password: temp };
}

function updateUser_(session, userId, changes) {
  requireObject_(changes, 'Changes');
  var patch = {};
  if ('display_name' in changes) patch.display_name = cleanText_(changes.display_name, 'Name', true, 100);
  if ('role_id' in changes) { patch.role_id = cleanText_(changes.role_id, 'Role', true, 50); requireRole_(patch.role_id); }
  if ('active' in changes) {
    if (typeof changes.active !== 'boolean') throw apiError_(ERR.BAD_REQUEST, 'Active must be true or false.');
    patch.active = changes.active;
  }
  if (!Object.keys(patch).length) throw apiError_(ERR.BAD_REQUEST, 'No changes to save.');
  var roleChange = null;
  withLock_(function () {
    var u = userOrThrow_(userId);
    requireAdminFor_(session, u.role_id === 'ROLE-ADMIN', 'change an Admin');
    requireAdminFor_(session, patch.role_id === 'ROLE-ADMIN', 'give the Admin role');
    var willBeAdmin = (patch.role_id || u.role_id) === 'ROLE-ADMIN' && (patch.active === undefined ? u.active : patch.active);
    if (u.role_id === 'ROLE-ADMIN' && u.active && !willBeAdmin && activeAdminCount_(u.user_id) === 0) {
      throw apiError_(ERR.CONFLICT, 'There must be at least one active Admin.');
    }
    if (u.user_id === session.user.user_id && (patch.active === false || (patch.role_id && patch.role_id !== u.role_id))) {
      throw apiError_(ERR.CONFLICT, 'You cannot deactivate yourself or change your own role.');
    }
    if (patch.role_id && patch.role_id !== u.role_id) roleChange = { user: u, from: u.role_id, to: patch.role_id };
    updateRow_(T.USERS, u._row, patch);
    auditLog_(session.user.user_id, 'update_user', T.USERS, u.user_id, auditChanges_(u, patch, ['display_name', 'role_id', 'active']) || 'No change');
  });
  if (roleChange) notifyUserEvent_('role_changed', session.user, roleChange.user, 'from ' + roleChange.from + ' to ' + roleChange.to);
  return adminUser_(userOrThrow_(userId), readTable_(T.TAB_ACCESS));
}

function resetPassword_(session, userId) {
  var temp = generateTempPassword_();
  var c = newCredentials_(temp);
  var target = null;
  withLock_(function () {
    var u = userOrThrow_(userId);
    requireAdminFor_(session, u.role_id === 'ROLE-ADMIN', 'reset the password of an Admin');
    updateRow_(T.USERS, u._row, {
      password_hash: c.password_hash, password_salt: c.password_salt, hash_rounds: c.hash_rounds,
      must_change: true, failed_attempts: 0, locked_until: ''
    });
    auditLog_(session.user.user_id, 'reset_password', T.USERS, u.user_id, 'Temporary password issued');
    target = u;
  });
  notifyUserEvent_('password_reset', session.user, target, 'a temporary password was issued');
  return { temp_password: temp };
}

/** `overrides` is the complete set of overrides for the user; tabs left out have none. */
function setUserTabAccess_(session, userId, overrides) {
  requireObject_(overrides, 'Overrides');
  var clean = {};
  Object.keys(overrides).forEach(function (tab) {
    if (TAB_IDS.indexOf(tab) < 0) throw apiError_(ERR.BAD_REQUEST, 'Unknown tab: ' + tab + '.');
    if (!isLevel_(overrides[tab])) throw apiError_(ERR.BAD_REQUEST, 'Level must be Hidden, View or Edit.');
    clean[tab] = overrides[tab];
  });
  if (userId === session.user.user_id && clean.users && clean.users !== 'Edit') {
    throw apiError_(ERR.CONFLICT, 'You cannot remove your own access to Users.');
  }
  withLock_(function () {
    var u = userOrThrow_(userId);
    requireAdminFor_(session, u.role_id === 'ROLE-ADMIN', 'change the page access of an Admin');
    var existing = readTable_(T.TAB_ACCESS).filter(function (r) { return r.subject_type === 'user' && r.subject_id === u.user_id; });
    deleteRows_(T.TAB_ACCESS, existing.map(function (r) { return r._row; }));
    appendRows_(T.TAB_ACCESS, Object.keys(clean).map(function (tab) {
      return { subject_type: 'user', subject_id: u.user_id, tab_id: tab, level: clean[tab] };
    }));
    var was = {};
    existing.forEach(function (r) { was[r.tab_id] = r.level; });
    var tabs = TAB_IDS.filter(function (t) { return was[t] !== clean[t]; });
    auditLog_(session.user.user_id, 'set_tab_access', T.USERS, u.user_id, tabs.map(function (t) {
      return t + ': ' + (was[t] || 'role default') + ' -> ' + (clean[t] || 'role default');
    }).join('; ') || 'No change');
  });
  return adminUser_(userOrThrow_(userId), readTable_(T.TAB_ACCESS));
}

// ======================================================================
// Utils.js
// ======================================================================
/**
 * Sheet access, typing, JSON output and the script lock.
 * Rules: read whole ranges, write whole ranges, never touch cells one by one.
 * Columns are always found by header name, so column order does not matter.
 */

var LOCK_DEPTH_ = 0;

// ---------- time (functions so tests can replace the clock) ----------

function nowMs_() { return Date.now(); }
function nowDate_() { return new Date(nowMs_()); }
/** Plant-local timestamp text 'YYYY-MM-DD HH:MM:SS.mmm'. */
function nowTs_() { return Utilities.formatDate(nowDate_(), TIMEZONE, 'yyyy-MM-dd HH:mm:ss.SSS'); }
function compactTs_(pattern) { return Utilities.formatDate(nowDate_(), TIMEZONE, pattern); }

// ---------- errors and output ----------

function apiError_(code, message) {
  var e = new Error(message);
  e.isApiError = true;
  e.code = code;
  e.accessDenied = code === ERR.FORBIDDEN;
  return e;
}

function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function okEnvelope_(data) { return { status: 'ok', data: data === undefined ? null : data }; }

function errorEnvelope_(code, message) {
  return { status: 'error', error: { message: message, code: code, accessDenied: code === ERR.FORBIDDEN } };
}

// ---------- lock ----------

/** Runs fn while holding the script lock; a busy lock gives the 'busy' error. */
function withLock_(fn) {
  if (LOCK_DEPTH_ > 0) return fn();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(LOCK_WAIT_MS)) throw apiError_(ERR.BUSY, 'Server is busy - please try again.');
  LOCK_DEPTH_++;
  try {
    return fn();
  } finally {
    LOCK_DEPTH_--;
    lock.releaseLock();
  }
}

// ---------- properties and ids ----------

function getProp_(name) { return PropertiesService.getScriptProperties().getProperty(name) || ''; }

/** A required secret; short or missing values stop the server with a clear message. */
function getSecret_(name) {
  var v = getProp_(name);
  if (!v || v.length < MIN_SECRET_LENGTH) {
    throw apiError_(ERR.SERVER, 'The server is not set up yet (' + name + ' is missing or too short). See the README.');
  }
  return v;
}

function randomHex_(n) {
  var s = '';
  while (s.length < n) s += Utilities.getUuid().replace(/-/g, '');
  return s.slice(0, n);
}

function newId_(prefix, n) { return prefix + randomHex_(n || 12); }

// ---------- schema helpers ----------

function tableDef_(table) {
  var t = SCHEMA.tables[table];
  if (!t) throw new Error('Unknown table ' + table);
  return t;
}

function columnTypes_(table) {
  var m = {};
  tableDef_(table).columns.forEach(function (c) { m[c.name] = c.type; });
  return m;
}

function isTextual_(type) { return type === 'text' || type === 'date' || type === 'timestamp' || type === 'enum'; }

function getSpreadsheet_() {
  var id = getProp_(PROP.SPREADSHEET);
  var ss = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw apiError_(ERR.SERVER, 'The server cannot find its spreadsheet. See the README.');
  return ss;
}

function getSheet_(table) {
  tableDef_(table);
  var sh = getSpreadsheet_().getSheetByName(table);
  if (!sh) throw apiError_(ERR.SERVER, 'The sheet "' + table + '" is missing. Run ensureSchema.');
  return sh;
}

function sheetHeaders_(sheet) {
  var n = sheet.getLastColumn();
  if (n < 1) return [];
  return sheet.getRange(1, 1, 1, n).getValues()[0].map(function (h) { return String(h); });
}

// ---------- typing ----------

function isDate_(v) { return Object.prototype.toString.call(v) === '[object Date]'; }

function fromSheet_(v, type) {
  if (type === 'bool') return v === true || v === 1 || String(v).toUpperCase() === 'TRUE';
  if (type === 'int' || type === 'float') {
    if (v === '' || v === null || v === undefined) return null;
    var n = Number(v);
    if (isNaN(n)) return null;
    return type === 'int' ? Math.trunc(n) : n;
  }
  if (isDate_(v)) {
    // Only happens if a cell lost its Plain Text format; keep the text form.
    return Utilities.formatDate(v, TIMEZONE, type === 'date' ? 'yyyy-MM-dd' : 'yyyy-MM-dd HH:mm:ss.SSS');
  }
  return v === null || v === undefined ? '' : String(v);
}

/**
 * 1.10.0: text that starts with = + - or @ could run as a formula if its cell ever loses the Plain Text format. A leading
 * apostrophe keeps it text; Sheets does not return the apostrophe, so reading gives the text back unchanged.
 */
var FORMULA_START_ = /^\s*[=+\-@]/;

function toSheet_(v, type) {
  if (type === 'bool') return v === true || v === 'TRUE' || v === 1;
  if (type === 'int' || type === 'float') return v === null || v === undefined || v === '' ? '' : Number(v);
  var s = v === null || v === undefined ? '' : String(v);
  return FORMULA_START_.test(s) ? "'" + s : s;
}

function rowToObject_(types, headers, row, rowNum) {
  var o = {};
  for (var c = 0; c < headers.length; c++) o[headers[c]] = fromSheet_(row[c], types[headers[c]] || 'text');
  Object.defineProperty(o, '_row', { value: rowNum, enumerable: false });
  return o;
}

// ---------- reads ----------

/** All data rows as typed objects. where(rawRow, indexByHeader) may filter before typing. */
function readTable_(table, where) {
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var last = sheet.getLastRow();
  if (last < 2 || !headers.length) return [];
  var values = sheet.getRange(2, 1, last - 1, headers.length).getValues();
  var types = columnTypes_(table);
  var idx = {};
  headers.forEach(function (h, i) { idx[h] = i; });
  var out = [];
  for (var i = 0; i < values.length; i++) {
    if (where && !where(values[i], idx)) continue;
    out.push(rowToObject_(types, headers, values[i], i + 2));
  }
  return out;
}

/** One column as typed values (fast: a single range read). */
function readColumn_(table, column) {
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var i = headers.indexOf(column);
  if (i < 0) throw new Error('Column ' + column + ' is missing in ' + table);
  var last = sheet.getLastRow();
  if (last < 2) return [];
  var type = columnTypes_(table)[column] || 'text';
  return sheet.getRange(2, i + 1, last - 1, 1).getValues().map(function (r) { return fromSheet_(r[0], type); });
}

function readRowAt_(table, rowNum) {
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var row = sheet.getRange(rowNum, 1, 1, headers.length).getValues()[0];
  return rowToObject_(columnTypes_(table), headers, row, rowNum);
}

function findBy_(table, field, value) {
  var rows = readTable_(table);
  for (var i = 0; i < rows.length; i++) if (rows[i][field] === value) return rows[i];
  return null;
}

// ---------- writes (caller holds the lock) ----------

/** A value read from the sheet, written back unchanged: formula-like text gets its apostrophe again (1.10.0). */
function keepCell_(v) {
  return typeof v === 'string' && FORMULA_START_.test(v) ? "'" + v : v;
}

function objectToRow_(table, headers, obj, existing) {
  var types = columnTypes_(table);
  return headers.map(function (h, i) {
    if (Object.prototype.hasOwnProperty.call(obj, h)) return toSheet_(obj[h], types[h] || 'text');
    return existing ? keepCell_(existing[i]) : '';
  });
}

/** Append many rows with one setValues call. */
function appendRows_(table, objs) {
  if (!objs.length) return;
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var start = Math.max(sheet.getLastRow(), 1) + 1;
  var values = objs.map(function (o) { return objectToRow_(table, headers, o, null); });
  var needed = start + values.length - 1;
  var grew = false;
  if (needed > sheet.getMaxRows()) {
    sheet.insertRowsAfter(sheet.getMaxRows(), needed - sheet.getMaxRows());
    grew = true;
  }
  var range = sheet.getRange(start, 1, values.length, headers.length);
  if (grew) {
    var types = columnTypes_(table);
    var fmt = headers.map(function (h) { return isTextual_(types[h] || 'text') ? '@' : 'General'; });
    range.setNumberFormats(values.map(function () { return fmt; }));
  }
  range.setValues(values);
}

function appendRow_(table, obj) { appendRows_(table, [obj]); }

/** Change some fields of one row; other columns keep their values. */
function updateRow_(table, rowNum, patch) {
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var range = sheet.getRange(rowNum, 1, 1, headers.length);
  var existing = range.getValues()[0];
  range.setValues([objectToRow_(table, headers, patch, existing)]);
}

/**
 * 1.10.0: keeps the rows for which keep(typedRow) is true and removes the others with one write (and one delete of the
 * rows left over at the end), instead of deleting row by row. Caller holds the lock. Returns how many were removed.
 */
function keepRows_(table, keep) {
  var sheet = getSheet_(table);
  var headers = sheetHeaders_(sheet);
  var last = sheet.getLastRow();
  if (last < 2 || !headers.length) return 0;
  var values = sheet.getRange(2, 1, last - 1, headers.length).getValues();
  var types = columnTypes_(table);
  var kept = values.filter(function (v, i) { return keep(rowToObject_(types, headers, v, i + 2)); });
  var removed = values.length - kept.length;
  if (!removed) return 0;
  if (kept.length) sheet.getRange(2, 1, kept.length, headers.length).setValues(kept.map(function (l) { return l.map(keepCell_); }));
  sheet.deleteRows(2 + kept.length, removed);
  return removed;
}

function deleteRows_(table, rowNums) {
  var sheet = getSheet_(table);
  rowNums.slice().sort(function (a, b) { return b - a; }).forEach(function (r) { sheet.deleteRow(r); });
}

/** Insert or update by a single key field. Returns 'added' or 'updated'. */
function upsertBy_(table, keyField, obj) {
  var existing = findBy_(table, keyField, obj[keyField]);
  if (existing) { updateRow_(table, existing._row, obj); return 'updated'; }
  appendRow_(table, obj);
  return 'added';
}

// ---------- small validators ----------

function cleanText_(v, label, required, max) {
  if (v === null || v === undefined) v = '';
  if (typeof v !== 'string') throw apiError_(ERR.BAD_REQUEST, label + ' must be text.');
  var s = v.trim();
  if (required && !s) throw apiError_(ERR.BAD_REQUEST, label + ' is required.');
  if (s.length > (max || TEXT_MAX)) throw apiError_(ERR.BAD_REQUEST, label + ' is too long.');
  return s;
}

function requireObject_(v, label) {
  if (!v || typeof v !== 'object' || Array.isArray(v)) throw apiError_(ERR.BAD_REQUEST, label + ' is missing.');
  return v;
}

function toBool_(v) { return v === true || v === 'TRUE' || v === 'true'; }
function toIntOr_(v, dflt) { var n = Number(v); return isNaN(n) || v === '' || v === null ? dflt : Math.trunc(n); }

// ---------- code / text normalisation (same rules as the browser) ----------

function codeKey_(code) {
  return String(code === null || code === undefined ? '' : code).toUpperCase().replace(/\s+/g, '').replace(/\.{2,}/g, '.');
}

function matchKey_(text) {
  return String(text === null || text === undefined ? '' : text).trim().replace(/\s+/g, ' ').toLowerCase();
}

/** Parse 'YYYY-MM-DD HH:MM:SS[.mmm]' as a plant-local clock reading; returns ms or null. */
function parseTs_(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})(?:\.(\d{1,3}))?$/.exec(typeof s === 'string' ? s.trim() : '');
  if (!m) return null;
  var ms = m[7] ? Number((m[7] + '00').slice(0, 3)) : 0;
  var t = Date.UTC(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], +m[6], ms);
  var d = new Date(t);
  if (d.getUTCFullYear() !== +m[1] || d.getUTCMonth() !== +m[2] - 1 || d.getUTCDate() !== +m[3] ||
      +m[4] > 23 || +m[5] > 59 || +m[6] > 59) return null;
  return t;
}

/** Canonical 'YYYY-MM-DD HH:MM:SS.mmm' or null. */
function normTs_(s) {
  var t = parseTs_(s);
  if (t === null) return null;
  var d = new Date(t);
  function p(n, w) { n = String(n); while (n.length < w) n = '0' + n; return n; }
  return d.getUTCFullYear() + '-' + p(d.getUTCMonth() + 1, 2) + '-' + p(d.getUTCDate(), 2) + ' ' +
    p(d.getUTCHours(), 2) + ':' + p(d.getUTCMinutes(), 2) + ':' + p(d.getUTCSeconds(), 2) + '.' + p(d.getUTCMilliseconds(), 3);
}

function isValidDate_(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(typeof s === 'string' ? s : '');
  if (!m) return false;
  var d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
  return d.getUTCFullYear() === +m[1] && d.getUTCMonth() === +m[2] - 1 && d.getUTCDate() === +m[3];
}
